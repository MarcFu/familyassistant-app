@page "/tasks"
@rendermode InteractiveServer
@inject FamilyAssist.Data.AppDbContext Db
@inject FamilyAssist.Services.TaskGenerator TaskGenerator
@inject FamilyAssist.Services.UserContextService UserContext
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> L
@using Microsoft.EntityFrameworkCore
@using FamilyAssist.Models
@using Microsoft.Extensions.Localization

<PageTitle>@L["PageTitle.Tasks"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">@L["Tasks.Title"]</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @* ── Permanent Tasks: Expander oben ── *@
    @if (_permanentTasks.Count > 0)
    {
        <MudExpansionPanels Elevation="0" Class="mb-4">
            <MudExpansionPanel @bind-Expanded="_permanentExpanded">
                <TitleContent>
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small" Class="mr-2" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle1">@string.Format(L["Tasks.PermanentHeader"], _permanentTasks.Count)</MudText>
                    </div>
                </TitleContent>
                <ChildContent>
                    <div class="d-flex flex-wrap gap-2 pa-2">
                        @foreach (var task in _permanentTasks)
                        {
                            <MudPaper Outlined="true" Style="width: 200px; min-height: 120px; display: flex; flex-direction: column;">
                                <div class="pa-3" style="flex: 1; overflow: hidden;">
                                    <div class="d-flex align-start gap-2">
                                        @if (task.Chore.Icon is not null)
                                        {
                                            @if (IsEmoji(task.Chore.Icon))
                                            {
                                                <span style="font-size:1.4rem; line-height:1;">@task.Chore.Icon</span>
                                            }
                                            else
                                            {
                                                var svg = FamilyAssist.Services.IconRegistry.GetSvg(task.Chore.Icon);
                                                if (svg is not null)
                                                {
                                                    <MudIcon Icon="@svg" Size="Size.Medium"
                                                             Style="@(task.Chore.IconColor is not null ? $"color: {task.Chore.IconColor};" : "")" />
                                                }
                                            }
                                        }
                                        <MudText Typo="Typo.body1"><strong>@task.Chore.Name</strong></MudText>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(task.Chore.Description))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Tertiary" Style="margin-top: 2px; line-height: 1.2;">@task.Chore.Description</MudText>
                                    }
                                </div>
                                <div class="d-flex align-center justify-space-between pa-3 pt-0">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@task.Chore.CreditsReward Cr</MudChip>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Check"
                                               OnClick="@(() => CompleteTask(task))"
                                               Disabled="!UserContext.CanAct">
                                        @L["Common.Done"]
                                    </MudButton>
                                </div>
                            </MudPaper>
                        }
                    </div>
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }

    @* ── Filter-Toolbar ── *@
    <div class="d-flex align-center mb-4 flex-wrap gap-2">
        <MudSelect T="int?" @bind-Value="_filterPersonId" Label="@L["Common.Person"].Value" Variant="Variant.Filled"
                   Dense="true" Margin="Margin.Dense" Clearable="true" Class="mr-2" Style="min-width: 150px;">
            @foreach (var person in _persons)
            {
                <MudSelectItem T="int?" Value="@person.Id">@person.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="TaskFilter" @bind-Value="_filter" Label="Filter" Variant="Variant.Filled"
                   Dense="true" Margin="Margin.Dense" Class="mr-2" Style="min-width: 180px;">
            <MudSelectItem Value="TaskFilter.Today">@L["Tasks.Filter.Today"]</MudSelectItem>
            <MudSelectItem Value="TaskFilter.Open">@L["Tasks.Filter.Open"]</MudSelectItem>
            <MudSelectItem Value="TaskFilter.Permanent">@L["Tasks.Filter.Permanent"]</MudSelectItem>
            <MudSelectItem Value="TaskFilter.Pending">@L["Tasks.Filter.Pending"]</MudSelectItem>
            <MudSelectItem Value="TaskFilter.ThisWeek">@L["Tasks.Filter.ThisWeek"]</MudSelectItem>
            <MudSelectItem Value="TaskFilter.Overdue">@L["Tasks.Filter.Overdue"]</MudSelectItem>
        </MudSelect>

        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="LoadTasksAsync"
                   StartIcon="@Icons.Material.Filled.Refresh">@L["Common.Refresh"]</MudButton>
        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                   OnClick="GenerateTasksAsync" StartIcon="@Icons.Material.Filled.Sync"
                   Disabled="_generating">
            @if (_generating)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
            }
            @L["Tasks.Generate"]
        </MudButton>
    </div>

    @* ── Hauptliste (geplante + ad-hoc Tasks) ── *@
    @if (_tasks.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@L["Tasks.NoResults"]</MudAlert>
    }
    else
    {
        @foreach (var dateGroup in _tasks.GroupBy(t => t.DueDate).OrderBy(g => g.Key))
        {
            <MudText Typo="Typo.subtitle1" Color="@GetDateColor(dateGroup.Key)" Class="mt-4 mb-2">
                @FormatDate(dateGroup.Key)
            </MudText>

            @foreach (var task in dateGroup.OrderBy(t => GetSortPriority(t.Status)).ThenBy(t => t.Chore.Name).ThenBy(t => t.OccurrenceIndex))
            {
                <MudPaper Outlined="true" Class="pa-3 mb-2">
                    <div class="d-flex align-center mb-2" style="min-width: 0;">
                        <MudIcon Icon="@GetStatusIcon(task.Status)" Size="Size.Small"
                                 Color="@GetStatusColor(task.Status)" Class="mr-2" Style="flex-shrink: 0;" />
                        @if (task.Chore.Icon is not null)
                        {
                            @if (IsEmoji(task.Chore.Icon))
                            {
                                <MudText Typo="Typo.body1" Class="mr-1">@task.Chore.Icon</MudText>
                            }
                            else if (task.Chore.Icon.StartsWith("svg:"))
                            {
                                var svgData = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(task.Chore.Icon[4..]));
                                <div style="width:20px; height:20px; color: @(task.Chore.IconColor ?? "currentColor"); display:inline-flex; flex-shrink: 0;" class="mr-1">
                                    @((MarkupString)svgData)
                                </div>
                            }
                            else
                            {
                                var resolved = FamilyAssist.Services.IconRegistry.GetSvg(task.Chore.Icon);
                                if (resolved is not null)
                                {
                                    <MudIcon Icon="@resolved" Size="Size.Small" Class="mr-1"
                                             Style="@($"flex-shrink: 0;{(task.Chore.IconColor is not null ? $" color: {task.Chore.IconColor};" : "")}")" />
                                }
                            }
                        }
                        <div style="min-width: 0; flex: 1;">
                            <MudText Typo="Typo.body1" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                @task.Chore.Name
                                @if (task.OccurrenceLabel is not null)
                                {
                                    <span class="mud-text-secondary"> (@task.OccurrenceLabel)</span>
                                }
                            </MudText>
                        </div>
                    </div>
                    <div class="d-flex align-center justify-space-between flex-wrap" style="row-gap: 6px;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @GetAssignmentText(task)
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="ml-1">
                                @task.Chore.CreditsReward Credits
                            </MudChip>
                        </MudText>
                        <div class="d-flex flex-wrap gap-1">
                            @* Comment button — always visible *@
                            <MudTooltip Text="@L["Tasks.CommentsTooltip"].Value">
                                <MudBadge Content="@task.Comments.Count" Overlap="true" Color="Color.Info"
                                          Visible="@(task.Comments.Count > 0)">
                                    <MudIconButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                                   Icon="@Icons.Material.Filled.ChatBubbleOutline"
                                                   OnClick="@(() => OpenCommentsAsync(task))" />
                                </MudBadge>
                            </MudTooltip>
                            @if (task.Status == ChoreTaskStatus.Open)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.PersonAdd"
                                           OnClick="@(() => ClaimTask(task))"
                                           Disabled="!UserContext.CanAct">
                                    @L["Tasks.Claim"]
                                </MudButton>
                            }
                            @if (task.Status == ChoreTaskStatus.Open || task.Status == ChoreTaskStatus.Claimed)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Check"
                                           OnClick="@(() => CompleteTask(task))"
                                           Disabled="!UserContext.CanAct">
                                    @L["Common.Done"]
                                </MudButton>
                            }
                            @if (task.Status == ChoreTaskStatus.PendingConfirmation && UserContext.IsParentOrAdmin)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                           StartIcon="@Icons.Material.Filled.ThumbUp"
                                           OnClick="@(() => ConfirmTask(task))">
                                    @L["Tasks.Confirm"]
                                </MudButton>
                            }
                            @if (task.Status != ChoreTaskStatus.Confirmed && task.Status != ChoreTaskStatus.Missed && task.Status != ChoreTaskStatus.Cancelled && UserContext.IsParentOrAdmin)
                            {
                                <MudTooltip Text="@L["Common.Cancel"].Value">
                                    <MudIconButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning"
                                                   Icon="@Icons.Material.Filled.Close"
                                                   OnClick="@(() => CancelTask(task))" />
                                </MudTooltip>
                            }
                        </div>
                    </div>
                </MudPaper>
            }
        }
    }

    <MudDivider Class="my-4" />
    @if (!UserContext.IsAuthenticated)
    {
        <MudAlert Severity="Severity.Warning" Class="py-1">
            @L["Tasks.NoUser"]
        </MudAlert>
    }
    else
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @((MarkupString)string.Format(L["Tasks.LoggedInAs"], $"<strong>{UserContext.CurrentPerson!.Name}</strong>", UserContext.CurrentPerson.Role))
        </MudText>
    }
}

@* ── FAB: fixed bottom-right (Material Design / HA standard position) ── *@
<MudTooltip Text="@L["Tasks.AdHocTooltip"].Value">
    <MudFab StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary"
            Size="Size.Large" OnClick="OpenAdHocDialogAsync"
            Style="position: fixed; bottom: 24px; right: 24px; z-index: 100;" />
</MudTooltip>

@code {
    private bool _loading = true;
    private bool _generating;
    private List<ChoreTask> _tasks = [];
    private List<ChoreTask> _permanentTasks = [];
    private List<Person> _persons = [];
    private int? _filterPersonId;
    private TaskFilter _filter = TaskFilter.Today;
    private bool _permanentExpanded = false;

    private int? ActivePersonId => UserContext.CurrentPersonId;

    protected override async Task OnInitializedAsync()
    {
        _persons = await Db.Persons.OrderBy(p => p.Name).ToListAsync();
        await GenerateTasksAsync();
        _loading = false;
    }

    private async Task GenerateTasksAsync()
    {
        _generating = true;
        StateHasChanged();

        try
        {
            var count = await TaskGenerator.RunAsync();
            if (count > 0)
            {
                Snackbar.Add(string.Format(L["Tasks.Snackbar.Generated"], count), Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(L["Common.Snackbar.Error"], ex.Message), Severity.Error);
        }

        _generating = false;
        await LoadTasksAsync();
    }

    private async Task OpenAdHocDialogAsync()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<AdHocTaskDialog>(L["Dialog.AdHocTask.Title"].Value, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            Snackbar.Add(L["Tasks.Snackbar.AdHocCreated"].Value, Severity.Success);
            await LoadTasksAsync();
        }
    }

    private async Task LoadTasksAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var weekEnd = today.AddDays(7 - (int)today.DayOfWeek);

        // Load permanent tasks separately (for the expander)
        _permanentTasks = await Db.ChoreTasks
            .Include(t => t.Chore)
            .Include(t => t.Schedule)
            .Where(t => t.Schedule!.Rhythm == ScheduleRhythm.Permanent
                && (t.Status == ChoreTaskStatus.Open || t.Status == ChoreTaskStatus.Claimed))
            .OrderBy(t => t.Chore.Name)
            .ToListAsync();

        // Main query (excludes permanent tasks unless "Permanent" filter is selected)
        IQueryable<ChoreTask> query = Db.ChoreTasks
            .Include(t => t.Chore)
            .Include(t => t.Schedule)
            .Include(t => t.DefaultPerson)
            .Include(t => t.ClaimedByPerson)
            .Include(t => t.CompletedByPerson)
            .Include(t => t.Comments);

        query = _filter switch
        {
            TaskFilter.Today => query.Where(t =>
                t.Status != ChoreTaskStatus.Missed && t.Status != ChoreTaskStatus.Cancelled
                && (t.ScheduleId == null || t.Schedule!.Rhythm != ScheduleRhythm.Permanent)
                && (
                    // Daily/SpecificDays: show only if due today
                    (t.DueDate == today && (t.ScheduleId == null || t.Schedule!.Rhythm == ScheduleRhythm.Daily || t.Schedule!.Rhythm == ScheduleRhythm.SpecificDays))
                    // Weekly/XTimesPerWeek/EveryXWeeks: show if due this week (DueDate <= today, still open/claimed)
                    || (t.DueDate <= today && (t.Status == ChoreTaskStatus.Open || t.Status == ChoreTaskStatus.Claimed)
                        && (t.Schedule!.Rhythm == ScheduleRhythm.Weekly || t.Schedule!.Rhythm == ScheduleRhythm.XTimesPerWeek || t.Schedule!.Rhythm == ScheduleRhythm.EveryXWeeks))
                    // Monthly/EveryXMonths: show if due this month (DueDate <= today, still open/claimed)
                    || (t.DueDate <= today && (t.Status == ChoreTaskStatus.Open || t.Status == ChoreTaskStatus.Claimed)
                        && (t.Schedule!.Rhythm == ScheduleRhythm.Monthly || t.Schedule!.Rhythm == ScheduleRhythm.EveryXMonths))
                    // Ad-hoc tasks (no schedule): show if due today
                    || (t.DueDate == today && t.ScheduleId == null)
                )),
            TaskFilter.Open => query.Where(t =>
                (t.Status == ChoreTaskStatus.Open || t.Status == ChoreTaskStatus.Claimed)
                && (t.ScheduleId == null || t.Schedule!.Rhythm != ScheduleRhythm.Permanent)
                && (t.DueDate >= today
                    // Also include non-daily tasks whose DueDate is past but are still open (within their period)
                    || (t.Schedule!.Rhythm == ScheduleRhythm.Weekly || t.Schedule!.Rhythm == ScheduleRhythm.XTimesPerWeek || t.Schedule!.Rhythm == ScheduleRhythm.EveryXWeeks
                        || t.Schedule!.Rhythm == ScheduleRhythm.Monthly || t.Schedule!.Rhythm == ScheduleRhythm.EveryXMonths))),
            TaskFilter.Permanent => query.Where(t =>
                t.Schedule!.Rhythm == ScheduleRhythm.Permanent),
            TaskFilter.Pending => query.Where(t => t.Status == ChoreTaskStatus.PendingConfirmation),
            TaskFilter.ThisWeek => query.Where(t =>
                t.DueDate <= weekEnd && t.Status != ChoreTaskStatus.Missed && t.Status != ChoreTaskStatus.Cancelled
                && (t.ScheduleId == null || t.Schedule!.Rhythm != ScheduleRhythm.Permanent)
                && (t.DueDate >= today
                    || ((t.Status == ChoreTaskStatus.Open || t.Status == ChoreTaskStatus.Claimed)
                        && (t.Schedule!.Rhythm == ScheduleRhythm.Weekly || t.Schedule!.Rhythm == ScheduleRhythm.XTimesPerWeek || t.Schedule!.Rhythm == ScheduleRhythm.EveryXWeeks
                            || t.Schedule!.Rhythm == ScheduleRhythm.Monthly || t.Schedule!.Rhythm == ScheduleRhythm.EveryXMonths)))),
            TaskFilter.Overdue => query.Where(t =>
                t.DueDate < today
                && (t.Status == ChoreTaskStatus.Open || t.Status == ChoreTaskStatus.Claimed)
                && (t.ScheduleId == null || t.Schedule!.Rhythm != ScheduleRhythm.Permanent)),
            _ => query
        };

        if (_filterPersonId.HasValue)
        {
            query = query.Where(t =>
                t.DefaultPersonId == _filterPersonId
                || t.ClaimedByPersonId == _filterPersonId
                || (t.DefaultPersonId == null && t.ClaimedByPersonId == null));
        }

        _tasks = await query.OrderBy(t => t.DueDate).ThenBy(t => t.Chore.Name).Take(100).ToListAsync();
        StateHasChanged();
    }

    private async Task ClaimTask(ChoreTask task)
    {
        if (ActivePersonId is null || !UserContext.CanAct) return;

        task.ClaimedByPersonId = ActivePersonId;
        task.Status = ChoreTaskStatus.Claimed;
        await Db.SaveChangesAsync();
        Snackbar.Add(L["Tasks.Snackbar.Claimed"].Value, Severity.Success);
        StateHasChanged();
    }

    private async Task CompleteTask(ChoreTask task)
    {
        if (ActivePersonId is null || !UserContext.CanAct) return;

        var activePerson = UserContext.CurrentPerson!;
        task.CompletedByPersonId = ActivePersonId;
        task.CompletedAt = DateTime.UtcNow;

        if (task.ClaimedByPersonId is null)
            task.ClaimedByPersonId = ActivePersonId;

        // Parents/Admins don't need confirmation
        if (activePerson.Role is PersonRole.Parent or PersonRole.Admin)
        {
            task.Status = ChoreTaskStatus.Confirmed;
            task.ConfirmedAt = DateTime.UtcNow;
            task.ConfirmedByPersonId = ActivePersonId;
            task.CreditsAwarded = true;

            // Award credits
            var creditPersonId = task.ClaimedByPersonId ?? ActivePersonId!.Value;
            var creditPerson = _persons.First(p => p.Id == creditPersonId);
            creditPerson.Credits += task.Chore.CreditsReward;

            Db.CreditTransactions.Add(new CreditTransaction
            {
                PersonId = creditPerson.Id,
                Amount = task.Chore.CreditsReward,
                Reason = string.Format(L["Tasks.CreditReason.Completed"], task.Chore.Name),
                Type = CreditTransactionType.ChoreCompleted,
                ChoreTaskId = task.Id,
                Timestamp = DateTime.UtcNow
            });

            Snackbar.Add(string.Format(L["Tasks.Snackbar.Completed"], task.Chore.CreditsReward, creditPerson.Name), Severity.Success);
        }
        else
        {
            task.Status = ChoreTaskStatus.PendingConfirmation;
            Snackbar.Add(L["Tasks.Snackbar.PendingConfirmation"].Value, Severity.Info);
        }

        await Db.SaveChangesAsync();

        // Permanent tasks: immediately spawn next one
        await TaskGenerator.RespawnPermanentTaskAsync(task);

        await LoadTasksAsync();
    }

    private async Task ConfirmTask(ChoreTask task)
    {
        if (ActivePersonId is null || !UserContext.IsParentOrAdmin) return;

        task.Status = ChoreTaskStatus.Confirmed;
        task.ConfirmedAt = DateTime.UtcNow;
        task.ConfirmedByPersonId = ActivePersonId;
        task.CreditsAwarded = true;

        var creditPersonId = task.ClaimedByPersonId ?? task.DefaultPersonId;
        if (creditPersonId.HasValue)
        {
            var creditPerson = _persons.First(p => p.Id == creditPersonId);
            creditPerson.Credits += task.Chore.CreditsReward;

            Db.CreditTransactions.Add(new CreditTransaction
            {
                PersonId = creditPerson.Id,
                Amount = task.Chore.CreditsReward,
                Reason = string.Format(L["Tasks.CreditReason.Confirmed"], task.Chore.Name),
                Type = CreditTransactionType.ChoreCompleted,
                ChoreTaskId = task.Id,
                Timestamp = DateTime.UtcNow
            });

            Snackbar.Add(string.Format(L["Tasks.Snackbar.Confirmed"], task.Chore.CreditsReward, creditPerson.Name), Severity.Success);
        }

        await Db.SaveChangesAsync();

        // Permanent tasks: immediately spawn next one
        await TaskGenerator.RespawnPermanentTaskAsync(task);

        await LoadTasksAsync();
    }

    private async Task CancelTask(ChoreTask task)
    {
        if (!UserContext.IsParentOrAdmin) return;

        task.Status = ChoreTaskStatus.Cancelled;
        await Db.SaveChangesAsync();

        Snackbar.Add(string.Format(L["Tasks.Snackbar.Cancelled"], task.Chore.Name), Severity.Warning);
        await LoadTasksAsync();
    }

    private async Task OpenCommentsAsync(ChoreTask task)
    {
        var parameters = new DialogParameters<TaskCommentsDialog>
        {
            { x => x.ChoreTaskId, task.Id }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<TaskCommentsDialog>(
            string.Format(L["Dialog.Comments.Title"], task.Chore.Name), parameters, options);
        await dialog.Result;
    }

    private bool CanAct() => UserContext.CanAct;

    private string GetAssignmentText(ChoreTask task)
    {
        if (task.Status == ChoreTaskStatus.Confirmed)
        {
            var time = task.ConfirmedAt?.ToLocalTime().ToString("HH:mm");
            var name = task.CompletedByPerson?.Name ?? task.ClaimedByPerson?.Name ?? "?";
            return time is not null ? string.Format(L["Tasks.Assignment.CompletedAt"], name, time) : string.Format(L["Tasks.Assignment.Completed"], name);
        }
        if (task.Status == ChoreTaskStatus.PendingConfirmation)
        {
            var time = task.CompletedAt?.ToLocalTime().ToString("HH:mm");
            var name = task.CompletedByPerson?.Name ?? task.ClaimedByPerson?.Name ?? "?";
            return time is not null ? string.Format(L["Tasks.Assignment.PendingAt"], name, time) : string.Format(L["Tasks.Assignment.Pending"], name);
        }
        if (task.ClaimedByPerson is not null) return string.Format(L["Tasks.Assignment.Claimed"], task.ClaimedByPerson.Name);
        if (task.DefaultPerson is not null) return string.Format(L["Tasks.Assignment.Assigned"], task.DefaultPerson.Name);
        return L["Tasks.Assignment.OpenForAll"];
    }

    /// <summary>
    /// Explicit sort priority for task statuses. Independent of enum values
    /// so we can safely insert new statuses without breaking sort order.
    /// </summary>
    private static int GetSortPriority(ChoreTaskStatus status) => status switch
    {
        ChoreTaskStatus.Open => 0,
        ChoreTaskStatus.Claimed => 1,
        ChoreTaskStatus.PendingConfirmation => 2,
        ChoreTaskStatus.Confirmed => 3,
        ChoreTaskStatus.Missed => 4,
        ChoreTaskStatus.Cancelled => 5,
        _ => 99
    };

    private static string GetStatusIcon(ChoreTaskStatus status) => status switch
    {
        ChoreTaskStatus.Open => Icons.Material.Outlined.Circle,
        ChoreTaskStatus.Claimed => Icons.Material.Filled.PersonPin,
        ChoreTaskStatus.PendingConfirmation => Icons.Material.Filled.HourglassTop,
        ChoreTaskStatus.Confirmed => Icons.Material.Filled.CheckCircle,
        ChoreTaskStatus.Missed => Icons.Material.Filled.Cancel,
        ChoreTaskStatus.Cancelled => Icons.Material.Filled.DoNotDisturb,
        _ => Icons.Material.Outlined.Circle
    };

    private static Color GetStatusColor(ChoreTaskStatus status) => status switch
    {
        ChoreTaskStatus.Open => Color.Default,
        ChoreTaskStatus.Claimed => Color.Info,
        ChoreTaskStatus.PendingConfirmation => Color.Warning,
        ChoreTaskStatus.Confirmed => Color.Success,
        ChoreTaskStatus.Missed => Color.Error,
        ChoreTaskStatus.Cancelled => Color.Warning,
        _ => Color.Default
    };

    private static Color GetDateColor(DateOnly date)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (date < today) return Color.Error;
        if (date == today) return Color.Primary;
        return Color.Default;
    }

    private string FormatDate(DateOnly date)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (date == today) return L["Common.Date.Today"];
        if (date == today.AddDays(-1)) return L["Common.Date.Yesterday"];
        if (date == today.AddDays(1)) return L["Common.Date.Tomorrow"];
        return date.ToString("dddd, dd.MM.yyyy");
    }

    private enum TaskFilter
    {
        Today,
        Open,
        Permanent,
        Pending,
        ThisWeek,
        Overdue
    }

    private static bool IsEmoji(string s) =>
        !string.IsNullOrEmpty(s) && !s.All(c => c < 128);
}
