@page "/chores"
@rendermode InteractiveServer
@inject FamilyAssist.Data.AppDbContext Db
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> L
@using Microsoft.EntityFrameworkCore

<PageTitle>@L["PageTitle.Chores"]</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">@L["Chores.Title"]</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_chores.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        @L["Chores.Empty"]
    </MudAlert>
}
else
{
    <MudTable Items="_filteredChores" Dense="true" Hover="true" Elevation="1">
        <ToolBarContent>
            <MudTextField @bind-Value="_search" Placeholder="@L["Common.Search"].Value" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                          Clearable="true"
                          Variant="Variant.Filled" Margin="Margin.Dense" Class="mr-3"
                          Style="max-width:250px;" />
            <MudSelect T="ChoreFilter" @bind-Value="_filter" Variant="Variant.Filled"
                       Margin="Margin.Dense" Style="max-width:200px;">
                <MudSelectItem Value="ChoreFilter.All">@L["Common.All"]</MudSelectItem>
                <MudSelectItem Value="ChoreFilter.Active">@L["Common.Active"]</MudSelectItem>
                <MudSelectItem Value="ChoreFilter.Inactive">@L["Chores.Filter.Inactive"]</MudSelectItem>
                <MudSelectItem Value="ChoreFilter.NoSchedule">@L["Chores.Filter.NoSchedule"]</MudSelectItem>
            </MudSelect>
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="width:40px"></MudTh>
            <MudTh>Name</MudTh>
            <MudTh>@L["Chores.Column.Schedule"]</MudTh>
            <MudTh Style="width:80px">Credits</MudTh>
            <MudTh Style="width:120px">@L["Common.Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @if (context.Icon is not null)
                {
                    @if (IsEmoji(context.Icon))
                    {
                        <span style="font-size:1.2rem;">@context.Icon</span>
                    }
                    else if (context.Icon.StartsWith("svg:"))
                    {
                        var svgData = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(context.Icon[4..]));
                        <div style="width:20px; height:20px; color: @(context.IconColor ?? "currentColor"); display:inline-flex;">
                            @((MarkupString)svgData)
                        </div>
                    }
                    else
                    {
                        var resolved = FamilyAssist.Services.IconRegistry.GetSvg(context.Icon);
                        if (resolved is not null)
                        {
                            <MudIcon Icon="@resolved" Size="Size.Small"
                                     Style="@(context.IconColor is not null ? $"color: {context.IconColor};" : "")" />
                        }
                    }
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Task" Size="Size.Small" Color="Color.Default" />
                }
            </MudTd>
            <MudTd DataLabel="Name">
                <div class="d-flex align-center">
                    <MudText Typo="Typo.body2" Class="@(context.IsActive ? "" : "mud-text-disabled")">
                        @context.Name
                    </MudText>
                    @if (!context.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-2">@L["Common.Inactive"]</MudChip>
                    }
                </div>
            </MudTd>
            <MudTd DataLabel="@L["Chores.Column.Schedule"].Value">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @FormatSchedulesSummary(context)
                </MudText>
            </MudTd>
            <MudTd DataLabel="Credits">
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@context.CreditsReward</MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => OpenEditDialog(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small"
                               OnClick="@(() => OpenScheduleDialog(context))" />
                <MudSwitch T="bool" Value="context.IsActive" ValueChanged="@(v => ToggleActive(context, v))"
                           Color="Color.Primary" Size="Size.Small"
                           Class="d-inline-flex" Style="margin:0;" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

<MudTooltip Text="@L["Chores.CreateTooltip"].Value">
    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
            Size="Size.Large" OnClick="OpenCreateDialog"
            Style="position: fixed; bottom: 24px; right: 24px; z-index: 100;" />
</MudTooltip>

@code {
    private bool _loading = true;
    private List<Chore> _chores = [];
    private string _search = "";
    private ChoreFilter _filter = ChoreFilter.Active;

    private IEnumerable<Chore> _filteredChores => _chores.Where(MatchesFilter);

    protected override async Task OnInitializedAsync()
    {
        await LoadChoresAsync();
        _loading = false;
    }

    private async Task LoadChoresAsync()
    {
        _chores = await Db.Chores
            .Include(c => c.Schedules)
                .ThenInclude(s => s.DefaultPerson)
            .OrderBy(c => c.Name)
            .ToListAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<ChoreDialog>
        {
            { x => x.Chore, null },
            { x => x.IsNew, true }
        };

        var dialog = await DialogService.ShowAsync<ChoreDialog>(L["Dialog.ChoreCreate.Title"].Value, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadChoresAsync();
            StateHasChanged();
        }
    }

    private async Task OpenEditDialog(Chore chore)
    {
        var parameters = new DialogParameters<ChoreDialog>
        {
            { x => x.Chore, chore },
            { x => x.IsNew, false }
        };

        var dialog = await DialogService.ShowAsync<ChoreDialog>(L["Dialog.ChoreEdit.Title"].Value, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadChoresAsync();
            StateHasChanged();
        }
    }

    private async Task OpenScheduleDialog(Chore chore)
    {
        var parameters = new DialogParameters<ScheduleDialog>
        {
            { x => x.Chore, chore }
        };

        var dialog = await DialogService.ShowAsync<ScheduleDialog>(string.Format(L["Dialog.Schedule.Title"].Value, chore.Name), parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadChoresAsync();
            StateHasChanged();
        }
    }

    private async Task ToggleActive(Chore chore, bool active)
    {
        chore.IsActive = active;
        await Db.SaveChangesAsync();
        StateHasChanged();
    }

    private string FormatSchedulesSummary(Chore chore)
    {
        var active = chore.Schedules.Where(s => s.IsActive).ToList();
        if (active.Count == 0) return L["Chores.NoSchedule"].Value;
        return string.Join(" | ", active.Select(FormatScheduleShort));
    }

    private string FormatScheduleShort(ChoreSchedule schedule)
    {
        var rhythm = schedule.Rhythm switch
        {
            ScheduleRhythm.Daily => L["Schedule.Daily"].Value,
            ScheduleRhythm.SpecificDays => FormatDays(schedule.SpecificDays),
            ScheduleRhythm.XTimesPerWeek => string.Format(L["Schedule.XTimesPerWeek"].Value, schedule.TimesPerWeek),
            ScheduleRhythm.Weekly => L["Schedule.Weekly"].Value,
            ScheduleRhythm.Monthly => L["Schedule.Monthly"].Value,
            ScheduleRhythm.EveryXMonths => string.Format(L["Schedule.EveryXMonths"].Value, schedule.IntervalMonths),
            ScheduleRhythm.EveryXWeeks => string.Format(L["Schedule.EveryXWeeks"].Value, schedule.IntervalWeeks),
            ScheduleRhythm.Permanent => L["Schedule.Permanent"].Value,
            _ => ""
        };

        var person = schedule.DefaultPerson?.Name;
        return person is not null ? $"{rhythm} ({person})" : rhythm;
    }

    private bool MatchesFilter(Chore chore)
    {
        // Text search
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var searchLower = _search.ToLowerInvariant();
            var nameMatch = chore.Name.Contains(searchLower, StringComparison.OrdinalIgnoreCase);
            var descMatch = chore.Description?.Contains(searchLower, StringComparison.OrdinalIgnoreCase) ?? false;
            if (!nameMatch && !descMatch) return false;
        }

        // Status filter
        return _filter switch
        {
            ChoreFilter.Active => chore.IsActive,
            ChoreFilter.Inactive => !chore.IsActive,
            ChoreFilter.NoSchedule => !chore.Schedules.Any(s => s.IsActive),
            _ => true
        };
    }

    private string FormatDays(DaysOfWeek? days)
    {
        if (days is null || days == DaysOfWeek.None) return L["Schedule.NoDays"].Value;
        if (days == DaysOfWeek.All) return L["Schedule.Daily"].Value;
        if (days == DaysOfWeek.Weekdays) return L["Schedule.Weekdays"].Value;
        if (days == DaysOfWeek.Weekend) return L["Schedule.Weekend"].Value;

        var names = new List<string>();
        if (days.Value.HasFlag(DaysOfWeek.Monday)) names.Add(L["DayShort.Monday"].Value);
        if (days.Value.HasFlag(DaysOfWeek.Tuesday)) names.Add(L["DayShort.Tuesday"].Value);
        if (days.Value.HasFlag(DaysOfWeek.Wednesday)) names.Add(L["DayShort.Wednesday"].Value);
        if (days.Value.HasFlag(DaysOfWeek.Thursday)) names.Add(L["DayShort.Thursday"].Value);
        if (days.Value.HasFlag(DaysOfWeek.Friday)) names.Add(L["DayShort.Friday"].Value);
        if (days.Value.HasFlag(DaysOfWeek.Saturday)) names.Add(L["DayShort.Saturday"].Value);
        if (days.Value.HasFlag(DaysOfWeek.Sunday)) names.Add(L["DayShort.Sunday"].Value);
        return string.Join("+", names);
    }

    private static bool IsEmoji(string s) =>
        !string.IsNullOrEmpty(s) && !s.All(c => c < 128);

    private enum ChoreFilter
    {
        All,
        Active,
        Inactive,
        NoSchedule
    }
}
