@page "/settings"
@page "/settings/{Tab?}"
@rendermode InteractiveServer
@inject IHomeAssistantService HaService
@inject FamilyAssist.Data.AppDbContext Db
@inject FamilyAssist.Services.ChoreIconGenerator IconGenerator
@inject FamilyAssist.Services.OllamaIconService OllamaService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Options.IOptions<FamilyAssist.Configuration.HomeAssistantOptions> HaOptions
@inject IStringLocalizer<SharedResource> L
@using Microsoft.EntityFrameworkCore
@implements IDisposable

<PageTitle>@L["PageTitle.Settings"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@L["Settings.Title"]</MudText>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4"
         ActivePanelIndex="_activePanelIndex" ActivePanelIndexChanged="OnTabChanged">
    <MudTabPanel Text="@L["Settings.Tab.Persons"].Value" Icon="@Icons.Material.Filled.People">
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudText Typo="Typo.h6" Class="mb-3">@L["Settings.Persons.Managed"]</MudText>

            @if (_managedPersons.Count > 0)
            {
                <MudTable Items="_managedPersons" Dense="true" Hover="true" Elevation="0" Class="mb-4">
                    <HeaderContent>
                        <MudTh></MudTh>
                        <MudTh>@L["Common.Name"]</MudTh>
                        <MudTh>@L["Common.Role"]</MudTh>
                        <MudTh>@L["Common.Credits"]</MudTh>
                        <MudTh>@L["Common.Status"]</MudTh>
                        <MudTh>@L["Settings.Persons.Links"]</MudTh>
                        <MudTh>@L["Common.Actions"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            @if (context.EntityPicture is not null)
                            {
                                <MudAvatar Size="Size.Small">
                                    <img src="@($"/api/ha-image?path={Uri.EscapeDataString(context.EntityPicture)}")"
                                         style="width:100%;height:100%;object-fit:cover;" alt="@context.Name" />
                                </MudAvatar>
                            }
                            else
                            {
                                <MudAvatar Size="Size.Small" Color="Color.Primary">@context.Name[0]</MudAvatar>
                            }
                        </MudTd>
                        <MudTd DataLabel="@L["Common.Name"].Value">@context.Name</MudTd>
                        <MudTd DataLabel="@L["Common.Role"].Value">
                            <MudSelect T="PersonRole" Value="context.Role" ValueChanged="@(v => OnRoleChanged(context, v))"
                                       Dense="true" Margin="Margin.Dense" Variant="Variant.Filled">
                                <MudSelectItem Value="PersonRole.Admin">@L["Role.Admin"]</MudSelectItem>
                                <MudSelectItem Value="PersonRole.Parent">@L["Role.Parent"]</MudSelectItem>
                                <MudSelectItem Value="PersonRole.Child">@L["Role.Child"]</MudSelectItem>
                            </MudSelect>
                        </MudTd>
                        <MudTd DataLabel="@L["Common.Credits"].Value">
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">@context.Credits</MudChip>
                        </MudTd>
                        <MudTd DataLabel="@L["Common.Status"].Value">
                            @if (context.IsPaused)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Pause">@L["Common.Paused"]</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Check">@L["Common.Active"]</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="@L["Settings.Persons.Links"].Value">
                            @{
                                var linkParts = new List<string>();
                                if (!string.IsNullOrWhiteSpace(context.HaTodoEntityId))
                                    linkParts.Add(L["Settings.Persons.LinkTodo"]);
                                if (context.DeviceEntities.Count > 0)
                                    linkParts.Add(string.Format(L["Settings.Persons.LinkDevices"], context.DeviceEntities.Count));
                            }
                            @if (linkParts.Count > 0)
                            {
                                <MudText Typo="Typo.body2">@string.Join(", ", linkParts)</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">&mdash;</MudText>
                            }
                        </MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Link" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => OpenEntityDialog(context))" Title="@L["Settings.Persons.EditLinks"].Value" />
                            <MudIconButton Icon="@(context.IsPaused ? Icons.Material.Filled.PlayArrow : Icons.Material.Filled.Pause)"
                                           Size="Size.Small" Color="Color.Default"
                                           OnClick="@(() => TogglePause(context))"
                                           Title="@(context.IsPaused ? L["Settings.Persons.Activate"].Value : L["Settings.Persons.Pause"].Value)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => RemovePerson(context))" Title="@L["Common.Remove"].Value" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-3">@L["Settings.Persons.Available"]</MudText>
            <MudText Typo="Typo.body2" Class="mb-3" Color="Color.Secondary">
                @L["Settings.Persons.ImportHint"]
            </MudText>

            <MudGrid>
                @foreach (var person in _availablePersons)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudPaper Outlined="true" Class="pa-3 cursor-pointer" @onclick="() => ImportPerson(person)">
                            <div class="d-flex align-center">
                                @if (person.EntityPicture is not null)
                                {
                                    <MudAvatar>
                                        <img src="@($"/api/ha-image?path={Uri.EscapeDataString(person.EntityPicture)}")"
                                             style="width:100%;height:100%;object-fit:cover;" alt="@person.FriendlyName" />
                                    </MudAvatar>
                                }
                                else
                                {
                                    <MudAvatar Color="Color.Surface">@person.FriendlyName[0]</MudAvatar>
                                }
                                <div class="ml-3" style="flex: 1;">
                                    <MudText Typo="Typo.body1">@person.FriendlyName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@person.EntityId</MudText>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" />
                            </div>
                        </MudPaper>
                    </MudItem>
                }

                @if (_availablePersons.Count == 0)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info">
                            @L["Settings.Persons.AllImported"]
                        </MudAlert>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudTabPanel>

    <MudTabPanel Text="@L["Settings.Tab.Icons"].Value" Icon="@Icons.Material.Filled.AutoAwesome">
        <MudText Typo="Typo.h6" Class="mb-3">@L["Settings.Icons.Title"]</MudText>

        <MudSelect T="IconMode" Value="_iconMode" ValueChanged="OnIconModeChanged" Label="@L["Settings.Icons.Mode"].Value" Variant="Variant.Filled"
                   Dense="true" Class="mb-3" Style="max-width:400px;">
            <MudSelectItem Value="IconMode.Keyword">@L["Settings.Icons.Mode.Keyword"]</MudSelectItem>
            <MudSelectItem Value="IconMode.OllamaMaterial">@L["Settings.Icons.Mode.OllamaMaterial"]</MudSelectItem>
            <MudSelectItem Value="IconMode.OllamaEmoji">@L["Settings.Icons.Mode.OllamaEmoji"]</MudSelectItem>
        </MudSelect>

        @if (_iconMode is IconMode.OllamaMaterial or IconMode.OllamaEmoji)
        {
            <MudTextField @bind-Value="_ollamaUrl" Label="@L["Settings.Icons.OllamaUrl"].Value" Variant="Variant.Filled"
                          Dense="true" Class="mb-3" Style="max-width:400px;"
                          Placeholder="http://localhost:11434"
                          TextChanged="OnOllamaUrlChanged" />

            @if (_availableModels.Count > 0)
            {
                <MudSelect T="string" @bind-Value="_ollamaModel" Label="@L["Settings.Icons.Model"].Value" Variant="Variant.Filled"
                           Dense="true" Class="mb-3" Style="max-width:400px;">
                    @foreach (var model in _availableModels)
                    {
                        <MudSelectItem Value="model">@model</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudTextField @bind-Value="_ollamaModel" Label="@L["Settings.Icons.ModelManual"].Value" Variant="Variant.Filled"
                              Dense="true" Class="mb-3" Style="max-width:400px;"
                              Placeholder="llama3.2:1b"
                              HelperText="@L["Settings.Icons.NoModels"].Value" />
            }

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mb-3"
                       OnClick="TestOllamaAsync" StartIcon="@Icons.Material.Filled.NetworkCheck">
                @L["Settings.Icons.TestConnection"]
            </MudButton>

            @if (_ollamaStatus is not null)
            {
                <MudAlert Severity="@(_ollamaOk ? Severity.Success : Severity.Error)" Class="mb-3">
                    @_ollamaStatus
                </MudAlert>
            }
        }

        <div class="d-flex justify-end mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveIconSettingsAsync"
                       StartIcon="@Icons.Material.Filled.Save">
                @L["Common.Save"]
            </MudButton>
        </div>
    </MudTabPanel>

    <MudTabPanel Text="@L["Settings.Tab.Storage"].Value" Icon="@Icons.Material.Filled.Storage">
        <MudText Typo="Typo.h6" Class="mb-3">@L["Settings.Storage.Title"]</MudText>
        <MudText Typo="Typo.body2" Class="mb-4" Color="Color.Secondary">
            @L["Settings.Storage.Description"]
        </MudText>

        <MudNumericField @bind-Value="_retentionDays" Label="@L["Settings.Storage.RetentionLabel"].Value" Variant="Variant.Filled"
                         Min="7" Max="365" Step="1" Style="max-width:300px;" Class="mb-3"
                         HelperText="@L["Settings.Storage.RetentionHelper"].Value"
                         Adornment="Adornment.End" AdornmentText="@L["Common.Days"].Value" />

        <div class="d-flex justify-end mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRetentionSettingsAsync"
                       StartIcon="@Icons.Material.Filled.Save">
                @L["Common.Save"]
            </MudButton>
        </div>
    </MudTabPanel>

    <MudTabPanel Text="@L["Settings.Tab.Trigger"].Value" Icon="@Icons.Material.Filled.Sensors">
        <MudText Typo="Typo.h6" Class="mb-3">@L["Settings.Trigger.Title"]</MudText>
        <MudText Typo="Typo.body2" Class="mb-4" Color="Color.Secondary">
            @L["Settings.Trigger.Description"]
        </MudText>

        @if (_triggers.Count > 0)
        {
            <MudTable Items="_triggers" Dense="true" Hover="true" Elevation="0" Class="mb-4">
                <HeaderContent>
                    <MudTh>@L["Common.Name"]</MudTh>
                    <MudTh>Entity</MudTh>
                    <MudTh>@L["Settings.Trigger.State"]</MudTh>
                    <MudTh>@L["Common.Task"]</MudTh>
                    <MudTh>@L["Settings.Trigger.Debounce"]</MudTh>
                    <MudTh>@L["Common.Status"]</MudTh>
                    <MudTh>@L["Common.Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Common.Name"].Value">@context.Name</MudTd>
                    <MudTd DataLabel="Entity">
                        <MudText Typo="Typo.caption" Style="font-family:monospace;">@context.EntityId</MudText>
                    </MudTd>
                    <MudTd DataLabel="@L["Settings.Trigger.State"].Value">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">@context.TriggerState</MudChip>
                    </MudTd>
                    <MudTd DataLabel="@L["Common.Task"].Value">@context.Chore.Name</MudTd>
                    <MudTd DataLabel="@L["Settings.Trigger.Debounce"].Value">@context.DebounceMins min</MudTd>
                    <MudTd DataLabel="@L["Common.Status"].Value">
                        <MudSwitch T="bool" Value="context.IsActive" ValueChanged="@(v => ToggleTriggerAsync(context, v))"
                                   Color="Color.Success" UncheckedColor="Color.Default" />
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => OpenTriggerDialogAsync(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteTriggerAsync(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                @L["Settings.Trigger.None"]
            </MudAlert>
        }

        <div class="d-flex justify-end mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => OpenTriggerDialogAsync(null))"
                       StartIcon="@Icons.Material.Filled.Add">
                @L["Settings.Trigger.Create"]
            </MudButton>
        </div>
    </MudTabPanel>

    <MudTabPanel Text="@L["Settings.Tab.System"].Value" Icon="@Icons.Material.Filled.Settings">
        <MudText Typo="Typo.h6" Class="mb-3">@L["Settings.System.HaConnection"]</MudText>

        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <div class="d-flex align-center gap-3 mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Api" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle1"><strong>REST API</strong></MudText>
                @if (_restStatus is null)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                }
                else if (_restStatus == true)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Check">
                        @(string.Format(L["Settings.System.Reachable"], _restLatencyMs))
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Close">
                        @L["Settings.System.Unreachable"]
                    </MudChip>
                }
            </div>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                <strong>URL:</strong> @HaOptions.Value.BaseUrl
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                <strong>Token:</strong> @MaskToken(HaOptions.Value.Token)
            </MudText>
        </MudPaper>

        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <div class="d-flex align-center gap-3 mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Cable" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle1"><strong>WebSocket</strong></MudText>
                @if (HaService.IsWebSocketConnected)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.Check">
                        @L["Settings.System.WsConnected"]
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Filled.Close">
                        @L["Settings.System.WsDisconnected"]
                    </MudChip>
                }
            </div>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                <strong>WS-URL:</strong> @GetWebSocketUrl()
            </MudText>
        </MudPaper>

        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="TestConnectionAsync"
                   StartIcon="@Icons.Material.Filled.Refresh" Disabled="_testingConnection">
            @if (_testingConnection)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                @L["Settings.System.Testing"]
            }
            else
            {
                @L["Settings.Icons.TestConnection"]
            }
        </MudButton>

        @* ── Language & Unit Settings ── *@
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-3">@L["Settings.System.Language"]</MudText>

        <div class="d-flex gap-3 align-end mb-3" style="max-width:500px;">
            <MudSelect T="string" @bind-Value="_selectedLanguage" Label="@L["Settings.System.Language"].Value" Variant="Variant.Filled"
                       Dense="true" Style="max-width:200px;" HelperText="@L["Settings.System.LanguageHelper"].Value">
                <MudSelectItem Value="@("en")">English</MudSelectItem>
                <MudSelectItem Value="@("de")">Deutsch</MudSelectItem>
                <MudSelectItem Value="@("fr")">Français</MudSelectItem>
            </MudSelect>

            <MudTextField @bind-Value="_pointsUnitName" Label="@L["Settings.System.PointsUnitName"].Value" Variant="Variant.Filled"
                          Dense="true" Style="max-width:200px;"
                          HelperText="@L["Settings.System.PointsUnitNameHelper"].Value"
                          Placeholder="Credits" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSystemSettingsAsync"
                       StartIcon="@Icons.Material.Filled.Save">
                @L["Common.Save"]
            </MudButton>
        </div>

        @* ── Live Event Log ── *@
        <MudDivider Class="my-4" />
        <div class="d-flex align-center gap-3 mb-3">
            <MudText Typo="Typo.h6">@L["Settings.System.EventLog"]</MudText>
            <MudSwitch T="bool" Value="_eventLogEnabled" ValueChanged="ToggleEventLog"
                       Color="Color.Success" Label="@(_eventLogEnabled ? L["Settings.System.EventLogLive"].Value : L["Settings.System.EventLogOff"].Value)" />
            @if (_eventLogEnabled)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info">@_eventLogEntries.Count Events</MudChip>
            }
        </div>

        @if (_eventLogEnabled)
        {
            <MudTextField T="string" @bind-Value="_eventLogFilter" Label="@L["Settings.System.EventLogFilter"].Value" Variant="Variant.Outlined"
                          Placeholder="@L["Settings.System.EventLogFilterPlaceholder"].Value" Immediate="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.FilterAlt"
                          Class="mb-3" Style="max-width: 400px;" />

            <div class="d-flex gap-2 mb-3">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="RefreshEventLog"
                           StartIcon="@Icons.Material.Filled.Refresh">
                    @L["Common.Refresh"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" OnClick="ClearEventLog"
                           StartIcon="@Icons.Material.Filled.Delete">
                    @L["Common.Clear"]
                </MudButton>
            </div>

            <MudPaper Outlined="true" Style="max-height: 400px; overflow-y: auto; font-family: monospace; font-size: 12px;">
                <MudSimpleTable Dense="true" Hover="true" FixedHeader="true" Style="background: transparent;">
                    <thead>
                        <tr>
                            <th style="width:70px;">@L["Common.Time"]</th>
                            <th style="width:120px;">@L["Common.Type"]</th>
                            <th>@L["Settings.System.EntityInfo"]</th>
                            <th style="width:80px;">@L["Settings.System.Old"]</th>
                            <th style="width:20px;"></th>
                            <th style="width:80px;">@L["Settings.System.New"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var evt in FilteredEvents)
                        {
                            <tr>
                                <td>@evt.Timestamp.ToString("HH:mm:ss")</td>
                                <td>
                                    <span style="color: var(--mud-palette-tertiary);">@evt.EventType</span>
                                </td>
                                <td>
                                    <strong>@evt.EntityId</strong>
                                    @if (evt.RawData is not null && evt.OldState is null)
                                    {
                                        <br/><span style="opacity: 0.6; font-size: 10px;">@evt.RawData</span>
                                    }
                                </td>
                                <td>@(evt.OldState ?? "")</td>
                                <td>@(evt.OldState is not null ? "→" : "")</td>
                                <td style="color: var(--mud-palette-info);">@(evt.NewState ?? "")</td>
                            </tr>
                        }
                        @if (!FilteredEvents.Any())
                        {
                            <tr>
                                <td colspan="6" style="text-align:center; opacity:0.5; padding:16px;">
                                    @if (_eventLogEntries.Count == 0)
                                    {
                                        @L["Settings.System.WaitingForEvents"]
                                    }
                                    else
                                    {
                                        @(string.Format(L["Settings.System.NoEventsForFilter"], _eventLogFilter))
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        }
    </MudTabPanel>
</MudTabs>

@code {
    private static readonly string[] TabNames = ["personen", "icons", "speicher", "trigger", "system"];

    [Parameter] public string? Tab { get; set; }

    private bool _loading = true;
    private int _activePanelIndex;
    private List<Person> _managedPersons = [];
    private List<HaPerson> _availablePersons = [];

    // Icon settings
    private IconMode _iconMode = IconMode.Keyword;
    private string _ollamaUrl = FamilyAssist.Services.ChoreIconGenerator.DefaultOllamaUrl;
    private string _ollamaModel = FamilyAssist.Services.ChoreIconGenerator.DefaultOllamaModel;
    private string? _ollamaStatus;
    private bool _ollamaOk;
    private List<string> _availableModels = [];

    // Storage settings
    private int _retentionDays = AttachmentCleanupService.DefaultRetentionDays;

    // Trigger settings
    private List<EventTrigger> _triggers = [];
    private List<Chore> _chores = [];

    // System settings (language + unit name)
    private string _selectedLanguage = FamilyAssist.Localization.AppSettingsCultureProvider.DefaultLanguage;
    private string _pointsUnitName = "Credits";

    protected override async Task OnInitializedAsync()
    {
        _activePanelIndex = TabNameToIndex(Tab);
        await LoadDataAsync();
        await LoadIconSettingsAsync();
        await LoadRetentionSettingsAsync();
        await LoadTriggersAsync();
        await LoadSystemSettingsAsync();
        _loading = false;
        await LoadAvailableModelsAsync();

        // Auto-test HA connection
        _ = TestConnectionAsync();
    }

    private void OnTabChanged(int index)
    {
        _activePanelIndex = index;
        var tabName = index >= 0 && index < TabNames.Length ? TabNames[index] : TabNames[0];
        Navigation.NavigateTo($"/settings/{tabName}", replace: true);
    }

    private static int TabNameToIndex(string? tab)
    {
        if (string.IsNullOrWhiteSpace(tab)) return 0;
        var idx = Array.FindIndex(TabNames, t => t.Equals(tab, StringComparison.OrdinalIgnoreCase));
        return idx >= 0 ? idx : 0;
    }

    private async Task OnOllamaUrlChanged(string newUrl)
    {
        _ollamaUrl = newUrl;
        await LoadAvailableModelsAsync();
    }

    private async Task LoadAvailableModelsAsync()
    {
        if (_iconMode is not (IconMode.OllamaMaterial or IconMode.OllamaEmoji))
            return;

        try
        {
            _availableModels = await OllamaService.GetModelsAsync(_ollamaUrl);
        }
        catch
        {
            _availableModels = [];
        }
        StateHasChanged();
    }

    private async Task OnIconModeChanged(IconMode mode)
    {
        _iconMode = mode;
        if (mode is IconMode.OllamaMaterial or IconMode.OllamaEmoji)
        {
            await LoadAvailableModelsAsync();
        }
    }

    private async Task LoadIconSettingsAsync()
    {
        _iconMode = await IconGenerator.GetIconModeAsync();
        _ollamaUrl = await IconGenerator.GetOllamaUrlAsync();
        _ollamaModel = await IconGenerator.GetOllamaModelAsync();
    }

    private async Task SaveIconSettingsAsync()
    {
        await IconGenerator.SetSettingAsync(FamilyAssist.Services.ChoreIconGenerator.SettingIconMode, _iconMode.ToString());
        await IconGenerator.SetSettingAsync(FamilyAssist.Services.ChoreIconGenerator.SettingOllamaUrl, _ollamaUrl);
        await IconGenerator.SetSettingAsync(FamilyAssist.Services.ChoreIconGenerator.SettingOllamaModel, _ollamaModel);
        Snackbar.Add(L["Settings.Snackbar.IconsSaved"], Severity.Success);
    }

    private async Task TestOllamaAsync()
    {
        _ollamaStatus = null;
        StateHasChanged();

        var ok = await OllamaService.IsAvailableAsync(_ollamaUrl);
        if (ok)
        {
            var models = await OllamaService.GetModelsAsync(_ollamaUrl);
            _ollamaOk = true;
            _ollamaStatus = string.Format(L["Settings.Snackbar.OllamaConnected"], models.Count, string.Join(", ", models.Take(5)));
        }
        else
        {
            _ollamaOk = false;
            _ollamaStatus = string.Format(L["Settings.Snackbar.OllamaFailed"], _ollamaUrl);
        }
        StateHasChanged();
    }

    private async Task LoadDataAsync()
    {
        _managedPersons = await Db.Persons.OrderBy(p => p.Name).ToListAsync();
        var haPersons = await HaService.GetPersonsAsync();
        var managedIds = _managedPersons.Select(p => p.HaEntityId).ToHashSet();
        _availablePersons = haPersons.Where(p => !managedIds.Contains(p.EntityId)).ToList();
    }

    private async Task ImportPerson(HaPerson haPerson)
    {
        var person = new Person
        {
            HaEntityId = haPerson.EntityId,
            Name = haPerson.FriendlyName,
            EntityPicture = haPerson.EntityPicture,
            Role = PersonRole.Child, // Default, can be changed
            Credits = 0
        };

        Db.Persons.Add(person);
        await Db.SaveChangesAsync();
        await LoadDataAsync();
        StateHasChanged();
    }

    private async Task OnRoleChanged(Person person, PersonRole newRole)
    {
        person.Role = newRole;
        await Db.SaveChangesAsync();
    }

    private async Task OpenEntityDialog(Person person)
    {
        var parameters = new DialogParameters<PersonEntityDialog>
        {
            { x => x.Person, person }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<PersonEntityDialog>(
            string.Format(L["Dialog.PersonEntity.Title"], person.Name), parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadDataAsync();
            StateHasChanged();
        }
    }

    private async Task TogglePause(Person person)
    {
        person.IsPaused = !person.IsPaused;
        await Db.SaveChangesAsync();
        StateHasChanged();
    }

    private async Task RemovePerson(Person person)
    {
        Db.Persons.Remove(person);
        await Db.SaveChangesAsync();
        await LoadDataAsync();
        StateHasChanged();
    }

    // ─── Storage / Retention ───────────────────────────────────

    private async Task LoadRetentionSettingsAsync()
    {
        _retentionDays = await AttachmentCleanupService.GetRetentionDaysAsync(Db);
    }

    private async Task SaveRetentionSettingsAsync()
    {
        await AttachmentCleanupService.SetRetentionDaysAsync(Db, _retentionDays);
        Snackbar.Add(L["Settings.Snackbar.RetentionSaved"], Severity.Success);
    }

    // ─── Event Triggers ────────────────────────────────────────

    private async Task LoadTriggersAsync()
    {
        _triggers = await Db.EventTriggers
            .Include(t => t.Chore)
            .OrderBy(t => t.Name)
            .ToListAsync();
        _chores = await Db.Chores.OrderBy(c => c.Name).ToListAsync();
    }

    private async Task OpenTriggerDialogAsync(EventTrigger? trigger)
    {
        var isNew = trigger is null;
        var parameters = new DialogParameters<Dialogs.TriggerDialog>
        {
            { x => x.Trigger, trigger },
            { x => x.IsNew, isNew },
            { x => x.Chores, _chores }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<Dialogs.TriggerDialog>(
            isNew ? L["Dialog.Trigger.TitleNew"] : L["Dialog.Trigger.TitleEdit"], parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled)
            return;

        var edited = (EventTrigger)result.Data!;

        if (isNew)
        {
            Db.EventTriggers.Add(edited);
            await Db.SaveChangesAsync();
            Snackbar.Add(string.Format(L["Settings.Snackbar.TriggerCreated"], edited.Name), Severity.Success);
        }
        else
        {
            // Update existing entity
            trigger!.Name = edited.Name;
            trigger.EntityId = edited.EntityId;
            trigger.TriggerState = edited.TriggerState;
            trigger.ChoreId = edited.ChoreId;
            trigger.DebounceMins = edited.DebounceMins;
            await Db.SaveChangesAsync();
            Snackbar.Add(string.Format(L["Settings.Snackbar.TriggerSaved"], edited.Name), Severity.Success);
        }

        await LoadTriggersAsync();
    }

    private async Task ToggleTriggerAsync(EventTrigger trigger, bool isActive)
    {
        trigger.IsActive = isActive;
        await Db.SaveChangesAsync();
        StateHasChanged();
    }

    private async Task DeleteTriggerAsync(EventTrigger trigger)
    {
        Db.EventTriggers.Remove(trigger);
        await Db.SaveChangesAsync();
        await LoadTriggersAsync();
        Snackbar.Add(string.Format(L["Settings.Snackbar.TriggerDeleted"], trigger.Name), Severity.Success);
    }

    // ─── System Tab ────────────────────────────────────────────────

    private bool? _restStatus;
    private int _restLatencyMs;
    private bool _testingConnection;

    private async Task TestConnectionAsync()
    {
        _testingConnection = true;
        _restStatus = null;
        StateHasChanged();

        try
        {
            var sw = System.Diagnostics.Stopwatch.StartNew();
            var ok = await HaService.TestConnectionAsync();
            sw.Stop();
            _restStatus = ok;
            _restLatencyMs = (int)sw.ElapsedMilliseconds;

            if (ok)
                Snackbar.Add(string.Format(L["Settings.Snackbar.RestOk"], _restLatencyMs), Severity.Success);
            else
                Snackbar.Add(L["Settings.Snackbar.RestFailed"], Severity.Error);
        }
        catch (Exception ex)
        {
            _restStatus = false;
            Snackbar.Add(string.Format(L["Common.Snackbar.Error"], ex.Message), Severity.Error);
        }
        finally
        {
            _testingConnection = false;
            StateHasChanged();
        }
    }

    private string GetWebSocketUrl()
    {
        var baseUrl = HaOptions.Value.BaseUrl;
        return baseUrl.Replace("http://", "ws://").Replace("https://", "wss://") + "/api/websocket";
    }

    private string MaskToken(string token)
    {
        if (string.IsNullOrEmpty(token)) return L["Settings.System.TokenEmpty"];
        if (token.Length <= 10) return "***";
        return token[..6] + "..." + token[^4..];
    }

    // ─── Event Log ────────────────────────────────────────────────

    private bool _eventLogEnabled;
    private List<HaEventLogEntry> _eventLogEntries = [];
    private string _eventLogFilter = "";
    private System.Threading.Timer? _eventLogTimer;

    // ─── System Settings (Language + PointsUnit) ─────────────────

    private async Task LoadSystemSettingsAsync()
    {
        var langSetting = await Db.AppSettings.FindAsync([FamilyAssist.Localization.AppSettingsCultureProvider.SettingKey]);
        _selectedLanguage = langSetting?.Value ?? FamilyAssist.Localization.AppSettingsCultureProvider.DefaultLanguage;

        var unitSetting = await Db.AppSettings.FindAsync(["PointsUnitName"]);
        _pointsUnitName = unitSetting?.Value ?? "Credits";
    }

    private async Task SaveSystemSettingsAsync()
    {
        // Save language
        var langSetting = await Db.AppSettings.FindAsync([FamilyAssist.Localization.AppSettingsCultureProvider.SettingKey]);
        if (langSetting is null)
        {
            Db.AppSettings.Add(new AppSetting { Key = FamilyAssist.Localization.AppSettingsCultureProvider.SettingKey, Value = _selectedLanguage });
        }
        else
        {
            langSetting.Value = _selectedLanguage;
        }

        // Save unit name
        var unitSetting = await Db.AppSettings.FindAsync(["PointsUnitName"]);
        if (unitSetting is null)
        {
            Db.AppSettings.Add(new AppSetting { Key = "PointsUnitName", Value = _pointsUnitName });
        }
        else
        {
            unitSetting.Value = _pointsUnitName;
        }

        await Db.SaveChangesAsync();
        Snackbar.Add(L["Settings.Snackbar.LanguageSaved"], Severity.Success);
    }

    private IEnumerable<HaEventLogEntry> FilteredEvents =>
        string.IsNullOrWhiteSpace(_eventLogFilter)
            ? _eventLogEntries
            : _eventLogEntries.Where(e =>
                e.EntityId.Contains(_eventLogFilter, StringComparison.OrdinalIgnoreCase) ||
                e.EventType.Contains(_eventLogFilter, StringComparison.OrdinalIgnoreCase));

    private async Task ToggleEventLog(bool enabled)
    {
        _eventLogEnabled = enabled;

        if (enabled)
        {
            try
            {
                await HaService.StartEventMonitorAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format(L["Settings.Snackbar.EventMonitorFailed"], ex.Message), Severity.Error);
                _eventLogEnabled = false;
                return;
            }

            // Auto-refresh every 2 seconds
            _eventLogTimer = new System.Threading.Timer(_ =>
            {
                InvokeAsync(() =>
                {
                    _eventLogEntries = HaService.GetRecentEvents().ToList();
                    StateHasChanged();
                });
            }, null, TimeSpan.Zero, TimeSpan.FromSeconds(2));
        }
        else
        {
            _eventLogTimer?.Dispose();
            _eventLogTimer = null;

            try
            {
                await HaService.StopEventMonitorAsync();
            }
            catch { /* ignore on stop */ }
        }
    }

    private void RefreshEventLog()
    {
        _eventLogEntries = HaService.GetRecentEvents().ToList();
    }

    private void ClearEventLog()
    {
        HaService.ClearEventLog();
        _eventLogEntries = [];
    }

    public void Dispose()
    {
        _eventLogTimer?.Dispose();
        // Stop monitoring when leaving the page (fire-and-forget)
        if (_eventLogEnabled)
        {
            _ = HaService.StopEventMonitorAsync();
        }
    }
}
