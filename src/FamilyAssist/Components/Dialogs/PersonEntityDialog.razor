@inject FamilyAssist.Data.AppDbContext Db
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Link" />
            <MudText Typo="Typo.h6">Verknüpfungen: @Person.Name</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @L["Dialog.PersonEntity.Description"]
        </MudText>

        @* --- Todo-Liste --- *@
        <MudText Typo="Typo.subtitle2" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" Class="mr-1" />
            @L["Dialog.PersonEntity.TodoList"]
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
            @L["Dialog.PersonEntity.TodoHint"]
        </MudText>
        <HaEntityPicker Domain="todo" Label="@L["Dialog.PersonEntity.TodoLabel"].Value" Class="mb-4"
                        SelectedValue="@_todoEntityId"
                        SelectedValueChanged="@(v => _todoEntityId = v)" />

        <MudDivider Class="my-4" />

        @* --- Geräte (Internet-Steuerung) --- *@
        <MudText Typo="Typo.subtitle2" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Router" Size="Size.Small" Class="mr-1" />
            @L["Dialog.PersonEntity.Devices"]
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
            @L["Dialog.PersonEntity.DevicesHint"]
        </MudText>
        <HaEntityPicker Domain="switch" Label="@L["Dialog.PersonEntity.SwitchLabel"].Value" MultiSelect="true" Class="mb-2"
                        SelectedValues="@_deviceEntities"
                        SelectedValuesChanged="@(v => _deviceEntities = v.ToList())" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">@L["Common.Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save" OnClick="Save">
            @L["Common.Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public Person Person { get; set; } = null!;

    private string? _todoEntityId;
    private List<string> _deviceEntities = [];

    protected override void OnParametersSet()
    {
        _todoEntityId = Person.HaTodoEntityId;
        _deviceEntities = Person.DeviceEntities.ToList();
    }

    private async Task Save()
    {
        Person.HaTodoEntityId = string.IsNullOrWhiteSpace(_todoEntityId) ? null : _todoEntityId.Trim();
        Person.DeviceEntities = _deviceEntities;
        await Db.SaveChangesAsync();
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
