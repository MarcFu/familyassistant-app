@inject FamilyAssist.Data.AppDbContext Db
@inject FamilyAssist.Services.UserContextService UserContext
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L
@using Microsoft.EntityFrameworkCore
@using FamilyAssist.Models
@implements IAsyncDisposable

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" Class="mx-auto d-block my-4" />
        }
        else
        {
            @* ── Comment Thread ── *@
            @if (_comments.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    @L["Dialog.Comments.Empty"]
                </MudText>
            }
            else
            {
                <div class="mb-4" style="max-height: 400px; overflow-y: auto;">
                    @foreach (var comment in _comments)
                    {
                        <MudPaper Outlined="true" Class="pa-2 mb-2">
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Primary" />
                                <MudText Typo="Typo.caption">
                                    <strong>@comment.Person.Name</strong> — @comment.CreatedAt.ToLocalTime().ToString("dd.MM. HH:mm")
                                </MudText>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(comment.Text))
                            {
                                <MudText Typo="Typo.body2" Class="mb-1">@comment.Text</MudText>
                            }
                            @if (comment.Attachments.Count > 0)
                            {
                                <div class="d-flex flex-wrap gap-2 mt-1">
                                    @foreach (var attachment in comment.Attachments)
                                    {
                                        <div style="width: 80px; height: 80px; border: 1px solid var(--mud-palette-lines-default); border-radius: 8px; overflow: hidden; cursor: pointer;"
                                             @onclick="@(() => PreviewImage(attachment))">
                                            <img src="/api/attachment/@attachment.Id" alt="@attachment.FileName"
                                                 style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
                                        </div>
                                    }
                                </div>
                            }
                        </MudPaper>
                    }
                </div>
            }

            @* ── Image Preview (full size) ── *@
            @if (_previewAttachment is not null)
            {
                <MudPaper Outlined="true" Class="pa-2 mb-3" Style="text-align: center;">
                    <img src="/api/attachment/@_previewAttachment.Id" alt="@_previewAttachment.FileName"
                         style="max-width: 100%; max-height: 300px; border-radius: 8px;" />
                    <MudButton Size="Size.Small" OnClick="@(() => _previewAttachment = null)"
                               Class="mt-1" StartIcon="@Icons.Material.Filled.Close">
                        @L["Common.Close"]
                    </MudButton>
                </MudPaper>
            }

            @* ── New Comment Input ── *@
            <MudDivider Class="my-3" />
            <MudTextField T="string" @bind-Value="_newCommentText" Label="@L["Dialog.Comments.Label"].Value" Variant="Variant.Outlined"
                          Placeholder="@L["Dialog.Comments.Placeholder"].Value" Lines="2" Class="mb-2" />

            <div class="d-flex align-center gap-2 mb-2 flex-wrap">
                @* Camera button — opens rear camera directly on mobile *@
                <label id="@_cameraContainerId" class="mud-button-root mud-button mud-button-outlined mud-button-outlined-size-small mud-ripple" style="cursor: pointer;">
                    <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Size="Size.Small" Class="mr-1" />
                    @L["Dialog.Comments.Camera"]
                    <input type="file" accept="image/*" capture="environment"
                           onchange="window.onFilesSelected('@_pickerId', '@_cameraContainerId', true)"
                           style="display: none;" />
                </label>

                @* Gallery button — pick multiple existing images *@
                <label id="@_galleryContainerId" class="mud-button-root mud-button mud-button-outlined mud-button-outlined-size-small mud-ripple" style="cursor: pointer;">
                    <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Size="Size.Small" Class="mr-1" />
                    @L["Dialog.Comments.Gallery"]
                    <input type="file" accept="image/*" multiple
                           onchange="window.onFilesSelected('@_pickerId', '@_galleryContainerId', true)"
                           style="display: none;" />
                </label>

                @if (_fileCount > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" OnClose="ClearFilesAsync">
                        @(string.Format(L["Dialog.Comments.FileCount"].Value, _fileCount))
                    </MudChip>
                }
            </div>

            @* JS-managed preview container — Blazor does NOT render previews here *@
            <div id="@_previewDivId"></div>

            @if (_uploading)
            {
                <MudProgressLinear Indeterminate="true" Class="mb-2" />
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Common.Close"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SubmitCommentAsync"
                   Disabled="@(_uploading || (string.IsNullOrWhiteSpace(_newCommentText) && _fileCount == 0))">
            @L["Common.Submit"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public int ChoreTaskId { get; set; }

    private bool _loading = true;
    private bool _uploading;
    private List<TaskComment> _comments = [];
    private string? _newCommentText;
    private int _fileCount;
    private TaskAttachment? _previewAttachment;

    // Stable IDs for JS (per dialog instance)
    private readonly string _pickerId = $"picker-{Guid.NewGuid():N}";
    private readonly string _cameraContainerId = $"cam-{Guid.NewGuid():N}";
    private readonly string _galleryContainerId = $"gal-{Guid.NewGuid():N}";
    private readonly string _previewDivId = $"prev-{Guid.NewGuid():N}";

    private DotNetObjectReference<TaskCommentsDialog>? _dotnetRef;

    protected override async Task OnInitializedAsync()
    {
        await LoadCommentsAsync();
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotnetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initFilePicker", _pickerId, _previewDivId, _dotnetRef);
        }
    }

    /// <summary>Called from JS when file count changes (add/remove).</summary>
    [JSInvokable]
    public void OnFileCountChanged(int count)
    {
        _fileCount = count;
        InvokeAsync(StateHasChanged);
    }

    private async Task LoadCommentsAsync()
    {
        _comments = await Db.TaskComments
            .Include(c => c.Person)
            .Include(c => c.Attachments)
            .Where(c => c.ChoreTaskId == ChoreTaskId)
            .OrderBy(c => c.CreatedAt)
            .ToListAsync();
    }

    private async Task ClearFilesAsync()
    {
        await JS.InvokeVoidAsync("clearPickerFiles", _pickerId);
        _fileCount = 0;
        StateHasChanged();
    }

    private async Task SubmitCommentAsync()
    {
        if (!UserContext.IsAuthenticated)
        {
            Snackbar.Add(L["Dialog.Comments.NoUser"].Value, Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_newCommentText) && _fileCount == 0) return;

        _uploading = true;
        StateHasChanged();

        try
        {
            // Create the comment
            var comment = new TaskComment
            {
                ChoreTaskId = ChoreTaskId,
                PersonId = UserContext.CurrentPersonId!.Value,
                Text = string.IsNullOrWhiteSpace(_newCommentText) ? null : _newCommentText.Trim(),
                CreatedAt = DateTime.UtcNow
            };

            Db.TaskComments.Add(comment);
            await Db.SaveChangesAsync();

            // Upload files via HTTP POST (JS → /api/upload-attachment)
            if (_fileCount > 0)
            {
                try
                {
                    await JS.InvokeAsync<object[]>("uploadPickerFiles", _pickerId, ChoreTaskId, comment.Id);
                }
                catch (Exception ex)
                {
                    Snackbar.Add(string.Format(L["Dialog.Comments.UploadError"].Value, ex.Message), Severity.Error);
                }
            }

            // Reset
            _newCommentText = null;
            _fileCount = 0;
            await JS.InvokeVoidAsync("clearPickerFiles", _pickerId);

            await LoadCommentsAsync();
            Snackbar.Add(L["Dialog.Comments.Snackbar.Posted"].Value, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fehler: {ex.Message}", Severity.Error);
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private void PreviewImage(TaskAttachment attachment)
    {
        _previewAttachment = _previewAttachment?.Id == attachment.Id ? null : attachment;
    }

    private void Cancel() => MudDialog.Close(DialogResult.Ok(true));

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("disposeFilePicker", _pickerId);
        }
        catch { /* Circuit may already be gone */ }
        _dotnetRef?.Dispose();
    }
}
