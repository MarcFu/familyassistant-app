@inject FamilyAssist.Data.AppDbContext Db
@inject FamilyAssist.Services.OllamaIconService OllamaService
@inject FamilyAssist.Services.ChoreIconGenerator IconGenerator
@inject IStringLocalizer<SharedResource> L
@using Microsoft.EntityFrameworkCore
@using MudBlazor.Utilities

<MudDialog Style="max-width: 720px;">
    <DialogContent>
        @* Search field — always visible, filters all tabs *@
        <MudTextField T="string" Value="_searchQuery" Label="@L["Dialog.IconPicker.SearchLabel"].Value" Variant="Variant.Filled"
                      Margin="Margin.Dense" Clearable="true" Immediate="true" DebounceInterval="300"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="mb-3" ValueChanged="OnSearchQueryChanged" />

        @* Tabs *@
        <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" Rounded="true" Class="mb-3">
            <MudTabPanel Text="@L["Dialog.IconPicker.Tab.Favorites"].Value" Icon="@Icons.Material.Filled.Star">
                @RenderFavoritesTab()
            </MudTabPanel>
            <MudTabPanel Text="@L["Dialog.IconPicker.Tab.Material"].Value" Icon="@Icons.Material.Filled.Category">
                @RenderMaterialTab()
            </MudTabPanel>
            <MudTabPanel Text="@L["Dialog.IconPicker.Tab.Emoji"].Value" Icon="@Icons.Material.Filled.EmojiEmotions">
                @RenderEmojiTab()
            </MudTabPanel>
            <MudTabPanel Text="@L["Dialog.IconPicker.Tab.AI"].Value" Icon="@Icons.Material.Filled.AutoAwesome">
                @RenderAiTab()
            </MudTabPanel>
        </MudTabs>

        @* Color Picker (for Material icons and custom SVGs) *@
        @if (_selectedIcon is not null && !_isEmoji)
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Dialog.IconPicker.ColorLabel"]</MudText>
            <div class="d-flex align-center gap-2 flex-wrap mb-2">
                @foreach (var color in _quickColors)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Circle"
                                   Style="@($"color: {color.Hex};")"
                                   Size="Size.Medium"
                                   OnClick="@(() => SelectColor(color.Hex))"
                                   Class="@(_selectedColor == color.Hex ? "mud-border-primary border-2 rounded-circle" : "")" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.FormatColorReset"
                               Size="Size.Medium" Color="Color.Default"
                               OnClick="@(() => SelectColor(null))"
                               Class="@(_selectedColor is null ? "mud-border-primary border-2 rounded-circle" : "")" />
            </div>
            @if (_showCustomColor)
            {
                <MudColorPicker Value="_customColorValue" DisableAlpha="true" DisableToolbar="true"
                                Style="max-width: 200px;" ColorPickerMode="ColorPickerMode.HEX"
                                ValueChanged="OnCustomColorChanged" />
            }
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _showCustomColor = !_showCustomColor)">
                @(_showCustomColor ? L["Dialog.IconPicker.CollapseColor"] : L["Dialog.IconPicker.OtherColor"])
            </MudButton>
        }

        @* Preview *@
        @if (_selectedIcon is not null)
        {
            <MudDivider Class="my-3" />
            <div class="d-flex align-center gap-3">
                <div style="@GetPreviewStyle()" class="d-flex align-center justify-center rounded pa-2">
                    @if (_isEmoji)
                    {
                        <MudText Typo="Typo.h4">@_selectedIcon</MudText>
                    }
                    else if (_isCustomSvg && _generatedSvg is not null)
                    {
                        <div style="width:40px; height:40px; color: @(_selectedColor ?? "currentColor");">
                            @((MarkupString)_generatedSvg)
                        </div>
                    }
                    else
                    {
                        var svg = FamilyAssist.Services.IconRegistry.GetSvg(_selectedIcon);
                        if (svg is not null)
                        {
                            <MudIcon Icon="@svg" Size="Size.Large" Style="@GetIconColorStyle()" />
                        }
                    }
                </div>
                <div>
                    <MudText Typo="Typo.body1"><strong>@_selectedIcon</strong></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @(_isCustomSvg ? L["Dialog.IconPicker.TypeAI"] : _isEmoji ? L["Dialog.IconPicker.TypeEmoji"] : L["Dialog.IconPicker.TypeMaterial"])
                        @if (_selectedColor is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Style="@($"background-color: {_selectedColor}; color: white;")" Class="ml-1">
                                @_selectedColor
                            </MudChip>
                        }
                    </MudText>
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">@L["Common.Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="_selectedIcon is null" StartIcon="@Icons.Material.Filled.Check">
            @L["Common.Apply"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string? CurrentIcon { get; set; }
    [Parameter] public string? CurrentColor { get; set; }

    private string? _searchQuery;
    private int _activeTab;
    private string? _selectedIcon;
    private string? _selectedColor;
    private bool _isEmoji;
    private bool _isCustomSvg;
    private bool _showCustomColor;
    private MudColor _customColorValue = new("#FF5722");

    // Search results
    private List<string> _materialResults = [];
    private List<EmojiEntry> _emojiResults = [];

    // MRU
    private List<string> _mruIcons = [];

    // AI generation
    private string _aiPrompt = "";
    private string? _generatedSvg;
    private bool _generating;
    private string? _aiError;
    private bool _showEffectivePrompt;
    private string? _effectivePrompt;
    private ModelTier? _lastTier;

    // Quick color presets (Mülltonnen + common)
    private static readonly (string Name, string Hex)[] _quickColors =
    [
        ("Gelb (Gelbe Tonne)", "#FFEB3B"),
        ("Blau (Papier)", "#2196F3"),
        ("Braun (Bio)", "#795548"),
        ("Schwarz (Restmüll)", "#424242"),
        ("Grün (Glas/Grün)", "#4CAF50"),
        ("Orange", "#FF9800"),
        ("Rot", "#F44336"),
        ("Lila", "#9C27B0"),
        ("Türkis", "#00BCD4"),
        ("Pink", "#E91E63"),
    ];

    // Household favorites (curated top picks)
    private static readonly string[] _householdFavorites =
    [
        "CleaningServices", "Kitchen", "LocalLaundryService", "Bed", "Bathtub",
        "Shower", "Delete", "Recycling", "Compost", "Pets",
        "Yard", "Grass", "ShoppingCart", "Restaurant", "Coffee",
        "LocalDining", "School", "MenuBook", "FitnessCenter", "DirectionsCar",
        "Build", "Handyman", "CalendarToday", "Alarm", "Checkroom",
        "Iron", "Window", "DoorFront", "Stairs", "Lightbulb"
    ];

    protected override async Task OnInitializedAsync()
    {
        _selectedIcon = CurrentIcon;
        _selectedColor = CurrentColor;
        _isEmoji = CurrentIcon is not null && !CurrentIcon.All(c => c < 128);

        // Load MRU from AppSettings
        var mruSetting = await Db.AppSettings.FirstOrDefaultAsync(s => s.Key == "icon_picker_mru");
        if (mruSetting?.Value is not null)
        {
            try
            {
                _mruIcons = System.Text.Json.JsonSerializer.Deserialize<List<string>>(mruSetting.Value) ?? [];
            }
            catch { _mruIcons = []; }
        }
    }

    private void OnSearchQueryChanged(string? value)
    {
        _searchQuery = value;
        OnSearchChanged();
    }

    private void OnCustomColorChanged(MudColor color)
    {
        _customColorValue = color;
        SelectColor(color.ToString(MudColorOutputFormats.Hex));
    }

    private void OnSearchChanged()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _materialResults = [];
            _emojiResults = [];
            return;
        }

        _materialResults = IconSearchIndex.Search(_searchQuery, 80);
        _emojiResults = EmojiRegistry.Search(_searchQuery, 40);
    }

    private void SelectMaterialIcon(string name)
    {
        _selectedIcon = name;
        _isEmoji = false;
        _isCustomSvg = false;
    }

    private void SelectEmoji(string emoji)
    {
        _selectedIcon = emoji;
        _isEmoji = true;
        _isCustomSvg = false;
        _selectedColor = null; // Emojis have their own color
    }

    private void SelectColor(string? hex)
    {
        _selectedColor = hex;
    }

    private string GetIconColorStyle()
        => _selectedColor is not null ? $"color: {_selectedColor};" : "";

    private string GetPreviewStyle()
        => "min-width: 56px; min-height: 56px; background: var(--mud-palette-surface);";

    private async Task Submit()
    {
        if (_selectedIcon is null) return;

        // Update MRU
        _mruIcons.Remove(_selectedIcon);
        _mruIcons.Insert(0, _selectedIcon);
        if (_mruIcons.Count > 10) _mruIcons = _mruIcons.Take(10).ToList();

        var mruJson = System.Text.Json.JsonSerializer.Serialize(_mruIcons);
        var mruSetting = await Db.AppSettings.FirstOrDefaultAsync(s => s.Key == "icon_picker_mru");
        if (mruSetting is not null)
        {
            mruSetting.Value = mruJson;
        }
        else
        {
            Db.AppSettings.Add(new FamilyAssist.Models.AppSetting { Key = "icon_picker_mru", Value = mruJson });
        }
        await Db.SaveChangesAsync();

        MudDialog.Close(DialogResult.Ok(new IconPickerResult(_selectedIcon, _isEmoji ? null : _selectedColor)));
    }

    private void Cancel() => MudDialog.Cancel();

    // ──── Render Helpers ────

    private RenderFragment RenderFavoritesTab() => __builder =>
    {
        // Search active → show search results instead
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            RenderSearchResults(__builder);
            return;
        }

        // MRU section
        if (_mruIcons.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1">@L["Dialog.IconPicker.RecentlyUsed"]</MudText>
            <div class="d-flex flex-wrap gap-1 mb-3">
                @foreach (var icon in _mruIcons)
                {
                    if (IsEmojiString(icon))
                    {
                        <MudButton Size="Size.Small" Variant="@(icon == _selectedIcon ? Variant.Filled : Variant.Outlined)"
                                   Color="@(icon == _selectedIcon ? Color.Primary : Color.Default)"
                                   OnClick="@(() => SelectEmoji(icon))" Style="min-width: 40px; font-size: 1.2rem;">
                            @icon
                        </MudButton>
                    }
                    else
                    {
                        var svg = IconRegistry.GetSvg(icon);
                        if (svg is not null)
                        {
                            <MudIconButton Icon="@svg" Size="Size.Medium"
                                           Color="@(icon == _selectedIcon ? Color.Primary : Color.Default)"
                                           OnClick="@(() => SelectMaterialIcon(icon))" />
                        }
                    }
                }
            </div>
        }

        // Household favorites
        <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1">@L["Dialog.IconPicker.HouseholdFavorites"]</MudText>
        <div class="d-flex flex-wrap gap-1">
            @foreach (var name in _householdFavorites)
            {
                var svg = IconRegistry.GetSvg(name);
                if (svg is not null)
                {
                    <MudTooltip Text="@name">
                        <MudIconButton Icon="@svg" Size="Size.Medium"
                                       Color="@(name == _selectedIcon ? Color.Primary : Color.Default)"
                                       OnClick="@(() => SelectMaterialIcon(name))" />
                    </MudTooltip>
                }
            }
        </div>
    };

    private RenderFragment RenderMaterialTab() => __builder =>
    {
        // Search active → show search results
        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            RenderSearchResults(__builder);
            return;
        }

        // Category chips
        <div class="d-flex flex-wrap gap-1 mb-3">
            @foreach (var cat in IconCategoryMap.Categories)
            {
                <MudChip T="string" Size="Size.Small"
                         Color="@(_materialCategory == cat.Name ? Color.Primary : Color.Default)"
                         OnClick="@(() => SetMaterialCategory(cat.Name))">
                    @cat.Name
                </MudChip>
            }
            <MudChip T="string" Size="Size.Small"
                     Color="@(_materialCategory == "_all" ? Color.Primary : Color.Default)"
                     OnClick="@(() => SetMaterialCategory("_all"))">
                @(string.Format(L["Dialog.IconPicker.AllCount"].Value, IconRegistry.All.Count))
            </MudChip>
        </div>

        // Icon grid
        var icons = GetMaterialIconsForDisplay();
        <div class="d-flex flex-wrap gap-1" style="max-height: 320px; overflow-y: auto;">
            @foreach (var name in icons)
            {
                var svg = IconRegistry.GetSvg(name);
                if (svg is not null)
                {
                    <MudTooltip Text="@name">
                        <MudIconButton Icon="@svg" Size="Size.Medium"
                                       Color="@(name == _selectedIcon ? Color.Primary : Color.Default)"
                                       OnClick="@(() => SelectMaterialIcon(name))" />
                    </MudTooltip>
                }
            }
        </div>

        @if (_materialCategory == "_all")
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                @L["Dialog.IconPicker.SearchHint"]
            </MudText>
        }
    };

    private RenderFragment RenderEmojiTab() => __builder =>
    {
        // Search active → show emoji search results
        if (!string.IsNullOrWhiteSpace(_searchQuery) && _emojiResults.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1">
                @(string.Format(L["Dialog.IconPicker.SearchResults"].Value, _emojiResults.Count))
            </MudText>
            <div class="d-flex flex-wrap gap-1" style="max-height: 320px; overflow-y: auto;">
                @foreach (var entry in _emojiResults)
                {
                    <MudTooltip Text="@entry.Name">
                        <MudButton Size="Size.Small"
                                   Variant="@(entry.Emoji == _selectedIcon ? Variant.Filled : Variant.Text)"
                                   Color="@(entry.Emoji == _selectedIcon ? Color.Primary : Color.Default)"
                                   OnClick="@(() => SelectEmoji(entry.Emoji))"
                                   Style="min-width: 40px; font-size: 1.4rem;">
                            @entry.Emoji
                        </MudButton>
                    </MudTooltip>
                }
            </div>
            return;
        }

        // Category display
        @foreach (var cat in EmojiRegistry.Categories)
        {
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1 mt-2">@cat.Name</MudText>
            <div class="d-flex flex-wrap gap-1">
                @foreach (var entry in cat.Emojis)
                {
                    <MudTooltip Text="@entry.Name">
                        <MudButton Size="Size.Small"
                                   Variant="@(entry.Emoji == _selectedIcon ? Variant.Filled : Variant.Text)"
                                   Color="@(entry.Emoji == _selectedIcon ? Color.Primary : Color.Default)"
                                   OnClick="@(() => SelectEmoji(entry.Emoji))"
                                   Style="min-width: 40px; font-size: 1.4rem;">
                            @entry.Emoji
                        </MudButton>
                    </MudTooltip>
                }
            </div>
        }
    };

    private void RenderSearchResults(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder)
    {
        if (_materialResults.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1">
                @(string.Format(L["Dialog.IconPicker.MaterialResults"].Value, _materialResults.Count))
            </MudText>
            <div class="d-flex flex-wrap gap-1 mb-3" style="max-height: 200px; overflow-y: auto;">
                @foreach (var name in _materialResults)
                {
                    var svg = IconRegistry.GetSvg(name);
                    if (svg is not null)
                    {
                        <MudTooltip Text="@name">
                            <MudIconButton Icon="@svg" Size="Size.Medium"
                                           Color="@(name == _selectedIcon ? Color.Primary : Color.Default)"
                                           OnClick="@(() => SelectMaterialIcon(name))" />
                        </MudTooltip>
                    }
                }
            </div>
        }

        if (_emojiResults.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-1">
                @(string.Format(L["Dialog.IconPicker.EmojiResults"].Value, _emojiResults.Count))
            </MudText>
            <div class="d-flex flex-wrap gap-1" style="max-height: 200px; overflow-y: auto;">
                @foreach (var entry in _emojiResults)
                {
                    <MudTooltip Text="@entry.Name">
                        <MudButton Size="Size.Small"
                                   Variant="@(entry.Emoji == _selectedIcon ? Variant.Filled : Variant.Text)"
                                   Color="@(entry.Emoji == _selectedIcon ? Color.Primary : Color.Default)"
                                   OnClick="@(() => SelectEmoji(entry.Emoji))"
                                   Style="min-width: 40px; font-size: 1.4rem;">
                            @entry.Emoji
                        </MudButton>
                    </MudTooltip>
                }
            </div>
        }

        if (_materialResults.Count == 0 && _emojiResults.Count == 0)
        {
            <MudAlert Severity="Severity.Info">@(string.Format(L["Dialog.IconPicker.NoResults"].Value, _searchQuery))</MudAlert>
        }
    }

    // ──── State ────
    private string? _materialCategory = null;

    private void SetMaterialCategory(string cat)
    {
        _materialCategory = cat == _materialCategory ? null : cat;
    }

    private IReadOnlyList<string> GetMaterialIconsForDisplay()
    {
        if (_materialCategory == "_all")
            return IconRegistry.All.Keys.OrderBy(k => k).Take(200).ToList();

        if (_materialCategory is not null)
            return IconCategoryMap.GetIcons(_materialCategory);

        // Default: show first category (Haushalt)
        return IconCategoryMap.Categories[0].Icons;
    }

    private static bool IsEmojiString(string s)
        => !string.IsNullOrEmpty(s) && !s.All(c => c < 128);

    // ──── AI Tab ────

    private RenderFragment RenderAiTab() => __builder =>
    {
        <MudText Typo="Typo.subtitle2" Class="mb-2">
            @L["Dialog.IconPicker.AI.Description"]
        </MudText>

        <MudTextField T="string" @bind-Value="_aiPrompt" Label="@L["Dialog.IconPicker.AI.Label"].Value" Variant="Variant.Filled"
                      Placeholder="@L["Dialog.IconPicker.AI.Placeholder"].Value"
                      Class="mb-3" Lines="2" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-3"
                   OnClick="GenerateAiIconAsync" Disabled="_generating || string.IsNullOrWhiteSpace(_aiPrompt)"
                   StartIcon="@Icons.Material.Filled.AutoAwesome">
            @if (_generating)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                <text>@L["Dialog.IconPicker.AI.Generating"]</text>
            }
            else
            {
                <text>@L["Dialog.IconPicker.AI.Generate"]</text>
            }
        </MudButton>

        @if (_lastTier is not null)
        {
            <div class="d-flex align-center gap-2 mb-2">
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                    @(_lastTier switch { ModelTier.Small => "Prompt: Compact (≤3B)", ModelTier.Medium => "Prompt: Medium (4–9B)", _ => "Prompt: Full (10B+)" })
                </MudChip>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                           OnClick="@(() => _showEffectivePrompt = !_showEffectivePrompt)"
                           StartIcon="@(_showEffectivePrompt ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)">
                    @(_showEffectivePrompt ? L["Dialog.IconPicker.AI.HidePrompt"] : L["Dialog.IconPicker.AI.ShowPrompt"])
                </MudButton>
            </div>

            @if (_showEffectivePrompt && _effectivePrompt is not null)
            {
                <MudPaper Outlined="true" Class="pa-3 mb-3" Style="max-height: 200px; overflow-y: auto;">
                    <pre style="white-space: pre-wrap; font-size: 0.75rem; margin: 0; font-family: monospace;">@_effectivePrompt</pre>
                </MudPaper>
            }
        }

        @if (_aiError is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_aiError</MudAlert>
        }

        @if (_generatedSvg is not null)
        {
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">@L["Dialog.IconPicker.AI.Result"]</MudText>
            <div class="d-flex align-center gap-4 mb-3">
                @* Small preview *@
                <div style="width:48px; height:48px; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px; padding: 4px; display:flex; align-items:center; justify-content:center;">
                    <div style="width:36px; height:36px; color: currentColor;">
                        @((MarkupString)_generatedSvg)
                    </div>
                </div>
                @* Larger preview *@
                <div style="width:96px; height:96px; border: 1px solid var(--mud-palette-lines-default); border-radius: 8px; padding: 8px; display:flex; align-items:center; justify-content:center; background: var(--mud-palette-surface);">
                    <div style="width:72px; height:72px; color: currentColor;">
                        @((MarkupString)_generatedSvg)
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           OnClick="AcceptAiIcon" StartIcon="@Icons.Material.Filled.Check">
                    @L["Common.Apply"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                           OnClick="GenerateAiIconAsync" Disabled="_generating"
                           StartIcon="@Icons.Material.Filled.Refresh">
                    @L["Dialog.IconPicker.AI.Retry"]
                </MudButton>
            </div>
        }
    };

    private async Task GenerateAiIconAsync()
    {
        _generating = true;
        _aiError = null;
        StateHasChanged();

        try
        {
            var ollamaUrl = await IconGenerator.GetOllamaUrlAsync();
            var model = await IconGenerator.GetOllamaModelAsync();

            // Store tier + effective prompt for admin display
            _lastTier = OllamaIconService.DetectModelTier(model);
            _effectivePrompt = OllamaIconService.BuildSvgPrompt(_aiPrompt, _lastTier.Value);

            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(180));
            var svg = await OllamaService.GenerateSvgIconAsync(_aiPrompt, ollamaUrl, model, cts.Token);

            if (svg is not null)
            {
                _generatedSvg = svg;
                _aiError = null;
            }
            else
            {
                _aiError = L["Dialog.IconPicker.AI.NoSvg"].Value;
            }
        }
        catch (OperationCanceledException)
        {
            var tierHint = _lastTier switch
            {
                ModelTier.Small => L["Dialog.IconPicker.AI.HintSmall"].Value,
                ModelTier.Medium => L["Dialog.IconPicker.AI.HintMedium"].Value,
                _ => L["Dialog.IconPicker.AI.HintLarge"].Value
            };
            _aiError = string.Format(L["Dialog.IconPicker.AI.Timeout"].Value, tierHint);
        }
        catch (HttpRequestException ex)
        {
            _aiError = string.Format(L["Common.ConnectionError"].Value, ex.Message);
        }
        catch (Exception ex)
        {
            _aiError = $"Fehler: {ex.Message}";
        }
        finally
        {
            _generating = false;
            StateHasChanged();
        }
    }

    private void AcceptAiIcon()
    {
        if (_generatedSvg is null) return;

        // Store as base64-encoded SVG with prefix
        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(_generatedSvg));
        _selectedIcon = $"svg:{base64}";
        _isEmoji = false;
        _isCustomSvg = true;
        _selectedColor = null;
    }
}
