@using FamilyAssistant.Models
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? L["Dialog.Device.TitleNew"] : L["Dialog.Device.TitleEdit"])</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_label" Label="@L["Dialog.Device.Label"].Value" Required="true"
                      RequiredError="@L["Validation.NameRequired"].Value"
                      Variant="Variant.Filled" Class="mb-3"
                      Placeholder="z.B. Alex PC, Alex Handy" />

        <MudSelect T="DeviceRole" @bind-Value="_role" Label="@L["Dialog.Device.Role"].Value"
                   Variant="Variant.Filled" Class="mb-3">
            <MudSelectItem T="DeviceRole" Value="DeviceRole.Shared">@L["Device.Role.Shared"]</MudSelectItem>
            <MudSelectItem T="DeviceRole" Value="DeviceRole.SchoolOnly">@L["Device.Role.SchoolOnly"]</MudSelectItem>
            <MudSelectItem T="DeviceRole" Value="DeviceRole.GamingOnly">@L["Device.Role.GamingOnly"]</MudSelectItem>
        </MudSelect>

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Dialog.Device.InternetControl"]</MudText>

        <HaEntityPicker Domain="switch" Label="@L["Dialog.Device.InternetSwitch"].Value" Class="mb-2"
                        SelectedValue="@_internetSwitchEntity"
                        SelectedValueChanged="@(v => _internetSwitchEntity = v)" />

        <MudSwitch T="bool" @bind-Value="_invertInternetSwitch" Color="Color.Primary" Class="mb-3"
                   Label="@L["Dialog.Device.InvertInternet"].Value" />

        @if (_role != DeviceRole.SchoolOnly)
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["Dialog.Device.GamingControl"]</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@L["Dialog.Device.GamingHint"]</MudText>

            <HaEntityPicker Domain="binary_sensor" Label="@L["Dialog.Device.DetectionEntity"].Value" Class="mb-2"
                            SelectedValue="@_detectionEntity"
                            SelectedValueChanged="@(v => _detectionEntity = v)" />

            <HaEntityPicker Domain="switch" Label="@L["Dialog.Device.GamingBlockEntity"].Value" Class="mb-2"
                            SelectedValue="@_gamingBlockEntity"
                            SelectedValueChanged="@(v => _gamingBlockEntity = v)" />

            <MudSwitch T="bool" @bind-Value="_invertGamingBlock" Color="Color.Primary" Class="mb-3"
                       Label="@L["Dialog.Device.InvertGaming"].Value" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">@L["Common.Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@(IsNew ? Icons.Material.Filled.Add : Icons.Material.Filled.Save)"
                   OnClick="Submit"
                   Disabled="@(!IsValid)">
            @(IsNew ? L["Common.Create"] : L["Common.Save"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public PersonDevice? Device { get; set; }
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public int PersonId { get; set; }

    private string _label = "";
    private DeviceRole _role = DeviceRole.Shared;
    private string? _internetSwitchEntity;
    private bool _invertInternetSwitch;
    private string? _detectionEntity;
    private string? _gamingBlockEntity;
    private bool _invertGamingBlock;

    private bool IsValid =>
        !string.IsNullOrWhiteSpace(_label) &&
        !string.IsNullOrWhiteSpace(_internetSwitchEntity);

    protected override void OnParametersSet()
    {
        if (Device is not null)
        {
            _label = Device.Label;
            _role = Device.Role;
            _internetSwitchEntity = Device.InternetSwitchEntity;
            _invertInternetSwitch = Device.InvertInternetSwitch;
            _detectionEntity = Device.DetectionEntity;
            _gamingBlockEntity = Device.GamingBlockEntity;
            _invertGamingBlock = Device.InvertGamingBlock;
        }
    }

    private void Submit()
    {
        var result = Device ?? new PersonDevice
        {
            Label = null!,
            InternetSwitchEntity = null!,
            PersonId = PersonId
        };

        result.Label = _label.Trim();
        result.Role = _role;
        result.InternetSwitchEntity = _internetSwitchEntity!.Trim();
        result.InvertInternetSwitch = _invertInternetSwitch;
        result.DetectionEntity = string.IsNullOrWhiteSpace(_detectionEntity) ? null : _detectionEntity.Trim();
        result.GamingBlockEntity = string.IsNullOrWhiteSpace(_gamingBlockEntity) ? null : _gamingBlockEntity.Trim();
        result.InvertGamingBlock = _invertGamingBlock;

        // SchoolOnly devices don't have gaming entities
        if (_role == DeviceRole.SchoolOnly)
        {
            result.DetectionEntity = null;
            result.GamingBlockEntity = null;
            result.InvertGamingBlock = false;
        }

        MudDialog.Close(DialogResult.Ok(result));
    }

    private void Cancel() => MudDialog.Cancel();
}
