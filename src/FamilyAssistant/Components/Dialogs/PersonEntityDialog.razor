@inject FamilyAssistant.Data.AppDbContext Db
@inject IHomeAssistantService HaService
@inject IStringLocalizer<SharedResource> L
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Link" />
            <MudText Typo="Typo.h6">@string.Format(L["Dialog.PersonEntity.Title"].Value, Person.Name)</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @L["Dialog.PersonEntity.Description"]
        </MudText>

        @* --- Todo-Liste --- *@
        <MudText Typo="Typo.subtitle2" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" Class="mr-1" />
            @L["Dialog.PersonEntity.TodoList"]
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
            @L["Dialog.PersonEntity.TodoHint"]
        </MudText>
        <HaEntityPicker Domain="todo" Label="@L["Dialog.PersonEntity.TodoLabel"].Value" Class="mb-4"
                        SelectedValue="@_todoEntityId"
                        SelectedValueChanged="@(v => _todoEntityId = v)" />

        <MudDivider Class="my-4" />

        @* --- Notifications --- *@
        <MudText Typo="Typo.subtitle2" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Notifications" Size="Size.Small" Class="mr-1" />
            @L["Dialog.PersonEntity.Notify"]
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
            @L["Dialog.PersonEntity.NotifyHint"]
        </MudText>
        <HaEntityPicker Domain="notify" Label="@L["Dialog.PersonEntity.NotifyLabel"].Value" Class="mb-2"
                        SelectedValue="@_notifyEntity"
                        SelectedValueChanged="@(v => _notifyEntity = v)" />
        <div class="d-flex justify-end">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Send" OnClick="SendTestNotificationAsync"
                       Disabled="@(_sendingTestNotification || string.IsNullOrWhiteSpace(_notifyEntity))">
                @L["Dialog.PersonEntity.NotifyTestButton"]
            </MudButton>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">@L["Common.Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save" OnClick="Save">
            @L["Common.Save"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public Person Person { get; set; } = null!;

    private string? _todoEntityId;
    private string? _notifyEntity;
    private bool _sendingTestNotification;

    protected override void OnParametersSet()
    {
        _todoEntityId = Person.HaTodoEntityId;
        _notifyEntity = Person.NotifyEntity;
    }

    private async Task Save()
    {
        Person.HaTodoEntityId = string.IsNullOrWhiteSpace(_todoEntityId) ? null : _todoEntityId.Trim();
        Person.NotifyEntity = string.IsNullOrWhiteSpace(_notifyEntity) ? null : _notifyEntity.Trim();
        await Db.SaveChangesAsync();
        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task SendTestNotificationAsync()
    {
        var notifyTarget = _notifyEntity?.Trim();
        if (string.IsNullOrWhiteSpace(notifyTarget))
            return;

        try
        {
            _sendingTestNotification = true;

            var title = string.Format(L["Dialog.PersonEntity.NotifyTestTitle"].Value, Person.Name);
            var message = string.Format(L["Dialog.PersonEntity.NotifyTestMessage"].Value, Person.Name);

            if (IsNotifyEntityId(notifyTarget))
            {
                await HaService.CallServiceAsync("notify", "send_message", new
                {
                    entity_id = notifyTarget,
                    title,
                    message
                });
            }
            else
            {
                await HaService.CallServiceAsync("notify", NormalizeLegacyNotifyService(notifyTarget), new
                {
                    title,
                    message
                });
            }

            Snackbar.Add(string.Format(L["Dialog.PersonEntity.NotifyTestSent"].Value, Person.Name), Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(L["Common.Snackbar.Error"].Value, ex.Message), Severity.Error);
        }
        finally
        {
            _sendingTestNotification = false;
        }
    }

    private static bool IsNotifyEntityId(string value)
        => value.StartsWith("notify.", StringComparison.OrdinalIgnoreCase);

    private static string NormalizeLegacyNotifyService(string notifyEntity)
    {
        const string prefix = "notify.";
        return notifyEntity.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)
            ? notifyEntity[prefix.Length..]
            : notifyEntity;
    }

    private void Cancel() => MudDialog.Cancel();
}
