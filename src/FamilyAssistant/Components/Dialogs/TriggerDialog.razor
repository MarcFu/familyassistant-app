@using FamilyAssistant.Models
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsNew ? "Neuer Trigger" : "Trigger bearbeiten")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="@L["Common.Name"].Value" Required="true" RequiredError="@L["Validation.NameRequired"].Value"
                      Variant="Variant.Filled" Class="mb-3" Placeholder="@L["Dialog.Trigger.NamePlaceholder"].Value" />

        <MudTextField @bind-Value="_entityId" Label="@L["Dialog.Trigger.EntityId"].Value" Required="true" RequiredError="@L["Validation.EntityIdRequired"].Value"
                      Variant="Variant.Filled" Class="mb-3" Placeholder="input_select.dish_washer_status"
                      Style="font-family: monospace;" />

        <MudTextField @bind-Value="_triggerState" Label="@L["Dialog.Trigger.State"].Value" Required="true" RequiredError="@L["Validation.StateRequired"].Value"
                      Variant="Variant.Filled" Class="mb-3" Placeholder="@L["Dialog.Trigger.StatePlaceholder"].Value"
                      HelperText="@L["Dialog.Trigger.StateHelper"].Value" />

        <MudSelect T="int?" @bind-Value="_choreId" Label="@L["Common.Task"].Value" Variant="Variant.Filled" Class="mb-3"
                   Required="true" RequiredError="@L["Validation.ChoreRequired"].Value">
            @foreach (var chore in ActiveChores)
            {
                <MudSelectItem T="int?" Value="@chore.Id">@chore.Name</MudSelectItem>
            }
            @foreach (var chore in InactiveChores)
            {
                <MudSelectItem T="int?" Value="@chore.Id">
                    @(string.Format(L["Common.InactivePrefix"].Value, chore.Name))
                </MudSelectItem>
            }
        </MudSelect>

        <MudNumericField @bind-Value="_debounceMins" Label="@L["Dialog.Trigger.Debounce"].Value" Variant="Variant.Filled"
                         Min="0" Max="1440" Step="5" Class="mb-3"
                         HelperText="@L["Dialog.Trigger.DebounceHelper"].Value" />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">@L["Common.Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@(IsNew ? Icons.Material.Filled.Add : Icons.Material.Filled.Save)"
                   OnClick="Submit"
                   Disabled="@(!IsValid)">
            @(IsNew ? L["Common.Create"] : L["Common.Save"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public EventTrigger? Trigger { get; set; }
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public List<Chore> Chores { get; set; } = [];

    private string _name = "";
    private string _entityId = "";
    private string _triggerState = "";
    private int? _choreId;
    private int _debounceMins = 60;

    private bool IsValid =>
        !string.IsNullOrWhiteSpace(_name) &&
        !string.IsNullOrWhiteSpace(_entityId) &&
        !string.IsNullOrWhiteSpace(_triggerState) &&
        _choreId is not null;

    private IEnumerable<Chore> ActiveChores => Chores.Where(c => c.IsActive).OrderBy(c => c.Name);
    private IEnumerable<Chore> InactiveChores => Chores.Where(c => !c.IsActive).OrderBy(c => c.Name);

    protected override void OnParametersSet()
    {
        if (Trigger is not null)
        {
            _name = Trigger.Name;
            _entityId = Trigger.EntityId;
            _triggerState = Trigger.TriggerState;
            _choreId = Trigger.ChoreId;
            _debounceMins = Trigger.DebounceMins;
        }
    }

    private void Submit()
    {
        var result = Trigger ?? new EventTrigger();
        result.Name = _name.Trim();
        result.EntityId = _entityId.Trim();
        result.TriggerState = _triggerState.Trim();
        result.ChoreId = _choreId!.Value;
        result.DebounceMins = Math.Clamp(_debounceMins, 0, 1440);

        if (IsNew)
        {
            result.IsActive = true;
            result.CreatedAt = DateTime.UtcNow;
        }

        MudDialog.Close(DialogResult.Ok(result));
    }

    private void Cancel() => MudDialog.Cancel();
}
