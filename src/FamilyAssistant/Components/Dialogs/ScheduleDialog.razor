@inject FamilyAssistant.Data.AppDbContext Db
@inject IStringLocalizer<SharedResource> L
@using Microsoft.EntityFrameworkCore

<MudDialog>
    <DialogContent>
        @if (_chore is not null)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                @(string.Format(L["Dialog.Schedule.Description"].Value, _chore.Name))
            </MudText>

            @foreach (var schedule in _schedules)
            {
                <MudCard Elevation="0" Outlined="true" Class="mb-3 pa-3">
                    <div class="d-flex align-center mb-2">
                        <MudSelect T="ScheduleRhythm" @bind-Value="schedule.Rhythm" Label="@L["Dialog.Schedule.Rhythm"].Value"
                                   Variant="Variant.Filled" Dense="true" Margin="Margin.Dense" Class="mr-2">
                            <MudSelectItem Value="ScheduleRhythm.Daily">@L["Schedule.Daily"]</MudSelectItem>
                            <MudSelectItem Value="ScheduleRhythm.SpecificDays">@L["Schedule.SpecificDays"]</MudSelectItem>
                            <MudSelectItem Value="ScheduleRhythm.XTimesPerWeek">@L["Schedule.XTimesPerWeekLabel"]</MudSelectItem>
                            <MudSelectItem Value="ScheduleRhythm.Weekly">@L["Schedule.WeeklyLabel"]</MudSelectItem>
                            <MudSelectItem Value="ScheduleRhythm.Monthly">@L["Schedule.MonthlyLabel"]</MudSelectItem>
                            <MudSelectItem Value="ScheduleRhythm.EveryXMonths">@L["Schedule.EveryXMonthsLabel"]</MudSelectItem>
                            <MudSelectItem Value="ScheduleRhythm.EveryXWeeks">@L["Schedule.EveryXWeeksLabel"]</MudSelectItem>
                            <MudSelectItem Value="ScheduleRhythm.Permanent">@L["Schedule.PermanentLabel"]</MudSelectItem>
                        </MudSelect>

                        <MudSelect T="int?" @bind-Value="schedule.DefaultPersonId" Label="@L["Dialog.Schedule.DefaultPerson"].Value"
                                   Variant="Variant.Filled" Dense="true" Margin="Margin.Dense" Class="mr-2"
                                   Clearable="true" Placeholder="@L["Dialog.Schedule.OpenPlaceholder"].Value">
                            @foreach (var person in _persons)
                            {
                                <MudSelectItem T="int?" Value="@person.Id">@person.Name</MudSelectItem>
                            }
                        </MudSelect>

                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => RemoveSchedule(schedule))" />
                    </div>

                    @if (schedule.Rhythm == ScheduleRhythm.SpecificDays)
                    {
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var (day, label) in _dayOptions)
                            {
                                var isSelected = schedule.SpecificDays?.HasFlag(day) ?? false;
                                <MudChip T="string" Color="@(isSelected ? Color.Primary : Color.Default)"
                                         Size="Size.Small"
                                         OnClick="@(() => ToggleDay(schedule, day))">
                                    @label
                                </MudChip>
                            }
                        </div>
                    }

                    @if (schedule.Rhythm == ScheduleRhythm.XTimesPerWeek)
                    {
                        <MudNumericField T="int?" @bind-Value="schedule.TimesPerWeek" Label="@L["Dialog.Schedule.TimesPerWeek"].Value"
                                         Min="1" Max="7" Variant="Variant.Filled" Dense="true" Margin="Margin.Dense" Class="mb-2" />
                    }

                    @if (schedule.Rhythm == ScheduleRhythm.EveryXMonths)
                    {
                        <MudNumericField T="int?" @bind-Value="schedule.IntervalMonths" Label="@L["Dialog.Schedule.IntervalMonths"].Value"
                                         Min="2" Max="24" Variant="Variant.Filled" Dense="true" Margin="Margin.Dense" Class="mb-2"
                                         HelperText="@L["Dialog.Schedule.IntervalMonthsHelper"].Value" />
                    }

                    @if (schedule.Rhythm == ScheduleRhythm.EveryXWeeks)
                    {
                        <MudNumericField T="int?" @bind-Value="schedule.IntervalWeeks" Label="@L["Dialog.Schedule.IntervalWeeks"].Value"
                                         Min="2" Max="12" Variant="Variant.Filled" Dense="true" Margin="Margin.Dense" Class="mb-2"
                                         HelperText="@L["Dialog.Schedule.IntervalWeeksHelper"].Value" />
                    }

                    @if (schedule.Rhythm == ScheduleRhythm.Daily || schedule.Rhythm == ScheduleRhythm.SpecificDays)
                    {
                        <MudNumericField @bind-Value="schedule.TimesPerDay" Label="@L["Dialog.Schedule.TimesPerDay"].Value"
                                         Min="1" Max="5" Variant="Variant.Filled" Dense="true" Margin="Margin.Dense" />
                    }
                </MudCard>
            }

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddSchedule" FullWidth="true">
                @L["Dialog.Schedule.Add"]
            </MudButton>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">@L["Common.Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="Submit">@L["Common.Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Chore? Chore { get; set; }

    private Chore? _chore;
    private List<ChoreSchedule> _schedules = [];
    private List<Person> _persons = [];

    private (DaysOfWeek Day, string Label)[] _dayOptions = null!;

    protected override async Task OnInitializedAsync()
    {
        _dayOptions =
        [
            (DaysOfWeek.Monday, L["DayShort.Monday"].Value),
            (DaysOfWeek.Tuesday, L["DayShort.Tuesday"].Value),
            (DaysOfWeek.Wednesday, L["DayShort.Wednesday"].Value),
            (DaysOfWeek.Thursday, L["DayShort.Thursday"].Value),
            (DaysOfWeek.Friday, L["DayShort.Friday"].Value),
            (DaysOfWeek.Saturday, L["DayShort.Saturday"].Value),
            (DaysOfWeek.Sunday, L["DayShort.Sunday"].Value)
        ];

        _persons = await Db.Persons.OrderBy(p => p.Name).ToListAsync();

        if (Chore is not null)
        {
            _chore = await Db.Chores
                .Include(c => c.Schedules)
                .FirstOrDefaultAsync(c => c.Id == Chore.Id);

            _schedules = _chore?.Schedules.ToList() ?? [];
        }
    }

    private void AddSchedule()
    {
        _schedules.Add(new ChoreSchedule
        {
            ChoreId = _chore!.Id,
            Rhythm = ScheduleRhythm.Daily,
            TimesPerDay = 1,
            IsActive = true
        });
    }

    private void RemoveSchedule(ChoreSchedule schedule)
    {
        if (schedule.Id > 0)
        {
            Db.ChoreSchedules.Remove(schedule);
        }
        _schedules.Remove(schedule);
    }

    private void ToggleDay(ChoreSchedule schedule, DaysOfWeek day)
    {
        var current = schedule.SpecificDays ?? DaysOfWeek.None;
        if (current.HasFlag(day))
            schedule.SpecificDays = current & ~day;
        else
            schedule.SpecificDays = current | day;
    }

    private async Task Submit()
    {
        if (_chore is null) return;

        // Reset TimesPerDay to 1 for rhythms where it's not configurable
        foreach (var schedule in _schedules)
        {
            if (schedule.Rhythm is not (ScheduleRhythm.Daily or ScheduleRhythm.SpecificDays))
            {
                schedule.TimesPerDay = 1;
            }
        }

        // Add new schedules
        foreach (var schedule in _schedules.Where(s => s.Id == 0))
        {
            schedule.ChoreId = _chore.Id;
            Db.ChoreSchedules.Add(schedule);
        }

        await Db.SaveChangesAsync();
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
