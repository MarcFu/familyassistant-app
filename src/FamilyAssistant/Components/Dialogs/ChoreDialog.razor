@inject FamilyAssistant.Data.AppDbContext Db
@inject FamilyAssistant.Services.ChoreIconGenerator IconGenerator
@inject IServiceScopeFactory ScopeFactory
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="@L["Common.Name"].Value" Required="true" RequiredError="@L["Validation.NameRequired"].Value"
                      Variant="Variant.Filled" Class="mb-3" />
        <MudTextField @bind-Value="_description" Label="@L["Common.Description"].Value" Lines="2"
                      Variant="Variant.Filled" Class="mb-3" />
        <MudNumericField @bind-Value="_creditsReward" Label="@L["Dialog.Chore.CreditsLabel"].Value" Min="0" Max="100"
                         Variant="Variant.Filled" Class="mb-3" />

        @* Icon section *@
        <div class="d-flex align-center gap-2 mb-3">
            <MudText Typo="Typo.body2" Class="mr-2">@L["Dialog.Chore.IconLabel"]</MudText>
            @if (_icon is not null)
            {
                @if (IsEmoji(_icon))
                {
                    <MudText Typo="Typo.h5">@_icon</MudText>
                }
                else if (_icon.StartsWith("svg:"))
                {
                    var svgData = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(_icon[4..]));
                    <div style="width:32px; height:32px; color: @(_iconColor ?? "currentColor"); display:inline-flex;">
                        @((MarkupString)svgData)
                    </div>
                }
                else
                {
                    var resolved = FamilyAssistant.Services.IconRegistry.GetSvg(_icon);
                    if (resolved is not null)
                    {
                        <MudIcon Icon="@resolved" Size="Size.Large" Style="@GetIconColorStyle()" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Warning">@_icon @L["Dialog.Chore.UnknownIcon"]</MudText>
                    }
                }
                @if (_iconColor is not null)
                {
                    <MudChip T="string" Size="Size.Small" Style="@($"background-color: {_iconColor}; color: white;")"
                             Class="ml-n1">
                        @_iconColor
                    </MudChip>
                }
                <MudIconButton Icon="@Icons.Material.Filled.Clear" Size="Size.Small"
                               OnClick="ClearIcon" />
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dialog.Chore.NoIcon"]</MudText>
            }

            <MudSpacer />

            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AutoAwesome"
                       OnClick="GenerateIconAsync" Disabled="_generatingIcon || string.IsNullOrWhiteSpace(_name)">
                @if (_generatingIcon)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                }
                @L["Dialog.Chore.Generate"]
            </MudButton>

            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.EmojiSymbols"
                       OnClick="OpenIconPickerAsync">
                @L["Dialog.Chore.SelectIcon"]
            </MudButton>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">@L["Common.Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@(IsNew ? Icons.Material.Filled.Add : Icons.Material.Filled.Save)"
                   OnClick="Submit"
                   Disabled="@(string.IsNullOrWhiteSpace(_name))">
            @(IsNew ? L["Common.Create"] : L["Common.Save"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Chore? Chore { get; set; }

    [Parameter]
    public bool IsNew { get; set; }

    private string _name = "";
    private string? _description;
    private int _creditsReward = 5;
    private string? _icon;
    private string? _iconColor;
    private bool _generatingIcon;

    protected override void OnParametersSet()
    {
        if (Chore is not null)
        {
            _name = Chore.Name;
            _description = Chore.Description;
            _creditsReward = Chore.CreditsReward;
            _icon = Chore.Icon;
            _iconColor = Chore.IconColor;
        }
    }

    private async Task GenerateIconAsync()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;

        _generatingIcon = true;
        StateHasChanged();

        try
        {
            _icon = await IconGenerator.GenerateIconAsync(_name, _description);
            _iconColor = null; // Auto-generated icons have no color by default
        }
        finally
        {
            _generatingIcon = false;
            StateHasChanged();
        }
    }

    private async Task OpenIconPickerAsync()
    {
        var parameters = new DialogParameters<IconPickerDialog>
        {
            { x => x.CurrentIcon, _icon },
            { x => x.CurrentColor, _iconColor }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<IconPickerDialog>("Icon auswählen", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is IconPickerResult picked)
        {
            _icon = picked.Icon;
            _iconColor = picked.Color;
            StateHasChanged();
        }
    }

    private void ClearIcon()
    {
        _icon = null;
        _iconColor = null;
    }

    private string GetIconColorStyle()
        => _iconColor is not null ? $"color: {_iconColor};" : "";

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;

        // Use instant keyword-based icon if none set (never blocks on Ollama)
        if (_icon is null)
        {
            _icon = FamilyAssistant.Services.KeywordIconMapper.GetIcon(_name, _description);
        }

        int choreId;
        if (IsNew)
        {
            var chore = new Chore
            {
                Name = _name.Trim(),
                Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                CreditsReward = _creditsReward,
                Icon = _icon,
                IconColor = _iconColor,
                IsActive = true
            };
            Db.Chores.Add(chore);
            await Db.SaveChangesAsync();
            choreId = chore.Id;
        }
        else if (Chore is not null)
        {
            Chore.Name = _name.Trim();
            Chore.Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim();
            Chore.CreditsReward = _creditsReward;
            Chore.Icon = _icon;
            Chore.IconColor = _iconColor;
            await Db.SaveChangesAsync();
            choreId = Chore.Id;
        }
        else
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(true));

        // Fire-and-forget: upgrade icon via Ollama in background (if configured)
        if (_icon is null || _icon == FamilyAssistant.Services.KeywordIconMapper.GetIcon(_name, _description))
        {
            var name = _name.Trim();
            var desc = string.IsNullOrWhiteSpace(_description) ? null : _description?.Trim();
            _ = Task.Run(async () => await UpgradeIconInBackgroundAsync(choreId, name, desc));
        }
    }

    /// <summary>
    /// Attempts to generate a better icon via Ollama in the background.
    /// Uses a new DI scope (dialog's DbContext is no longer valid after close).
    /// </summary>
    private async Task UpgradeIconInBackgroundAsync(int choreId, string name, string? description)
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<FamilyAssistant.Data.AppDbContext>();
            var generator = scope.ServiceProvider.GetRequiredService<FamilyAssistant.Services.ChoreIconGenerator>();

            var mode = await generator.GetIconModeAsync();
            if (mode == FamilyAssistant.Models.IconMode.Keyword) return; // Already have keyword icon

            var newIcon = await generator.GenerateIconAsync(name, description);
            if (newIcon is null) return;

            var chore = await db.Chores.FindAsync(choreId);
            if (chore is null) return;

            chore.Icon = newIcon;
            await db.SaveChangesAsync();
        }
        catch
        {
            // Best-effort: if Ollama fails, the keyword icon remains
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private static bool IsEmoji(string s) =>
        !string.IsNullOrEmpty(s) && !s.All(c => c < 128);
}
