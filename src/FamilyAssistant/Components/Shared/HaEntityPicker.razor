@inject IHomeAssistantService HaService
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> L

<div class="ha-entity-picker @Class">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <MudText Typo="Typo.subtitle2" Class="mb-1">@Label</MudText>
    }

    <MudPaper Outlined="true" Class="pa-3">
        @if (!_loaded)
        {
            <div class="d-flex align-center gap-2">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Common.Loading"]</MudText>
            </div>
        }
        else if (MultiSelect)
        {
            <div class="d-flex flex-column gap-2">
                @if (_selectedSet.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Picker.NoSelection"]</MudText>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var id in _selectedSet)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled"
                                     OnClose="@(() => RemoveSelection(id))">
                                @GetShortName(id)
                            </MudChip>
                        }
                    </div>
                }

                <div class="d-flex justify-end">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Search" OnClick="OpenPickerAsync">
                        @(_selectedSet.Count == 0 ? L["Picker.Select"] : L["Picker.Change"])
                    </MudButton>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-2">
                @if (SelectedEntity is not null)
                {
                    <div class="d-flex align-start gap-3">
                        <MudIcon Icon="@GetDomainIcon(SelectedEntity)" Size="Size.Medium" Color="@GetStateColor(SelectedEntity)" />
                        <div style="flex: 1; min-width: 0;">
                            <div class="d-flex flex-wrap align-start gap-2" style="width: 100%;">
                                <MudText Typo="Typo.body2" Style="flex: 1 1 12rem; min-width: 0; overflow-wrap: anywhere;">@GetFriendlyName(SelectedEntity)</MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@GetStateColor(SelectedEntity)">
                                    @SelectedEntity.State
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display: block; overflow-wrap: anywhere; font-family: monospace;">
                                @SelectedEntity.EntityId
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(GetEntityDetail(SelectedEntity)))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Tertiary" Style="display: block; overflow-wrap: anywhere;">
                                    @GetEntityDetail(SelectedEntity)
                                </MudText>
                            }
                        </div>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(SelectedValue))
                {
                    <MudText Typo="Typo.body2" Style="overflow-wrap: anywhere; font-family: monospace;">@SelectedValue</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Picker.NoSelection"]</MudText>
                }

                <div class="d-flex justify-end">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Search" OnClick="OpenPickerAsync">
                        @(string.IsNullOrWhiteSpace(SelectedValue) ? L["Picker.Select"] : L["Picker.Change"])
                    </MudButton>
                </div>
            </div>
        }
    </MudPaper>
</div>

@code {
    /// <summary>
    /// Home Assistant domain(s) to filter entities.
    /// Supports comma-separated domains (e.g., "switch,input_boolean").
    /// </summary>
    [Parameter, EditorRequired]
    public string Domain { get; set; } = "";

    [Parameter]
    public bool MultiSelect { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Class { get; set; }

    // --- Single-select binding ---
    [Parameter]
    public string? SelectedValue { get; set; }

    [Parameter]
    public EventCallback<string?> SelectedValueChanged { get; set; }

    // --- Multi-select binding ---
    [Parameter]
    public ICollection<string> SelectedValues { get; set; } = [];

    [Parameter]
    public EventCallback<ICollection<string>> SelectedValuesChanged { get; set; }

    private List<HaEntityState> _allEntities = [];
    private IReadOnlyDictionary<string, HaEntityRegistryInfo> _registry = new Dictionary<string, HaEntityRegistryInfo>();
    private HashSet<string> _selectedSet = [];
    private bool _loaded;

    private HaEntityState? SelectedEntity => string.IsNullOrWhiteSpace(SelectedValue)
        ? null
        : _allEntities.FirstOrDefault(e => e.EntityId == SelectedValue);

    protected override async Task OnInitializedAsync()
    {
        await LoadEntitiesAsync();
    }

    protected override void OnParametersSet()
    {
        if (MultiSelect)
        {
            _selectedSet = SelectedValues.ToHashSet();
        }
    }

    private async Task LoadEntitiesAsync()
    {
        if (_loaded) return;

        try
        {
            var domains = Domain.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            var allEntities = new List<HaEntityState>();

            foreach (var domain in domains)
            {
                var entities = await HaService.GetEntitiesByDomainAsync(domain);
                allEntities.AddRange(entities);
            }

            _allEntities = allEntities
                .OrderBy(e => GetFriendlyName(e))
                .ThenBy(e => e.EntityId)
                .ToList();

            try
            {
                _registry = await HaService.GetEntityRegistryAsync();
            }
            catch
            {
                _registry = new Dictionary<string, HaEntityRegistryInfo>();
            }
        }
        catch
        {
            _allEntities = [];
        }

        _loaded = true;
    }

    private async Task OpenPickerAsync()
    {
        if (!_loaded)
            await LoadEntitiesAsync();

        var parameters = new DialogParameters
        {
            { nameof(PickerDialog<string>.Options), BuildOptions() },
            { nameof(PickerDialog<string>.SelectedValue), SelectedValue },
            { nameof(PickerDialog<string>.SelectedValues), MultiSelect ? _selectedSet.ToList() : [] },
            { nameof(PickerDialog<string>.MultiSelect), MultiSelect },
            { nameof(PickerDialog<string>.Clearable), true },
            { nameof(PickerDialog<string>.WrapText), true },
            { nameof(PickerDialog<string>.InitialVisibleCount), 150 },
            { nameof(PickerDialog<string>.SearchPlaceholder), L["EntityPicker.SearchPlaceholder"].Value },
            { nameof(PickerDialog<string>.EmptyText), _allEntities.Count == 0 ? L["EntityPicker.NoEntities"].Value : L["EntityPicker.NoMatch"].Value }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<PickerDialog<string>>(Label ?? L["Picker.Select"].Value, parameters, options);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not PickerDialogResult<string> pickerResult)
            return;

        if (MultiSelect)
        {
            _selectedSet = pickerResult.Values.ToHashSet();
            SelectedValues = _selectedSet.ToList();
            await SelectedValuesChanged.InvokeAsync(SelectedValues);
        }
        else
        {
            SelectedValue = pickerResult.Values.Count > 0 ? pickerResult.Values[0] : null;
            await SelectedValueChanged.InvokeAsync(SelectedValue);
        }
    }

    private IReadOnlyList<PickerOption<string>> BuildOptions()
        => _allEntities.Select(entity => new PickerOption<string>
        {
            Value = entity.EntityId,
            Title = GetFriendlyName(entity),
            Subtitle = entity.EntityId,
            Detail = GetEntityDetail(entity),
            Icon = GetDomainIcon(entity),
            ChipText = entity.State,
            ChipColor = GetStateColor(entity),
            SearchText = $"{GetFriendlyName(entity)} {entity.EntityId} {GetEntityDetail(entity)} {entity.State}"
        }).ToList();

    private async Task RemoveSelection(string entityId)
    {
        _selectedSet.Remove(entityId);
        SelectedValues = _selectedSet.ToList();
        await SelectedValuesChanged.InvokeAsync(SelectedValues);
    }

    private string GetShortName(string entityId)
    {
        var entity = _allEntities.FirstOrDefault(e => e.EntityId == entityId);
        if (entity is not null)
        {
            var name = GetFriendlyName(entity);
            return name.Length > 25 ? name[..22] + "..." : name;
        }

        var dotIdx = entityId.IndexOf('.');
        return dotIdx >= 0 ? entityId[(dotIdx + 1)..] : entityId;
    }

    private string? GetEntityDetail(HaEntityState entity)
    {
        _registry.TryGetValue(entity.EntityId, out var regInfo);

        return (regInfo?.AreaName, regInfo?.DeviceName) switch
        {
            ({ Length: > 0 } area, { Length: > 0 } device) => $"{area} / {device}",
            ({ Length: > 0 } area, _) => area,
            (_, { Length: > 0 } device) => device,
            _ => null
        };
    }

    private static string GetFriendlyName(HaEntityState entity)
    {
        if (entity.Attributes.TryGetValue("friendly_name", out var name) && name is not null)
        {
            return name.ToString() ?? entity.EntityId;
        }

        return entity.EntityId;
    }

    private static string GetDomainIcon(HaEntityState? entity)
    {
        if (entity is null) return Icons.Material.Filled.HelpOutline;

        var domain = entity.EntityId.Split('.')[0];
        return domain switch
        {
            "switch" => Icons.Material.Filled.ToggleOn,
            "light" => Icons.Material.Filled.Lightbulb,
            "sensor" => Icons.Material.Filled.Sensors,
            "binary_sensor" => Icons.Material.Filled.RadioButtonChecked,
            "input_boolean" => Icons.Material.Filled.CheckBox,
            "input_number" => Icons.Material.Filled.Tune,
            "input_select" => Icons.Material.Filled.List,
            "automation" => Icons.Material.Filled.SmartToy,
            "script" => Icons.Material.Filled.Code,
            "scene" => Icons.Material.Filled.Palette,
            "climate" => Icons.Material.Filled.Thermostat,
            "cover" => Icons.Material.Filled.Blinds,
            "media_player" => Icons.Material.Filled.MusicNote,
            "camera" => Icons.Material.Filled.Videocam,
            "todo" => Icons.Material.Filled.Checklist,
            "person" => Icons.Material.Filled.Person,
            "notify" => Icons.Material.Filled.Notifications,
            "device_tracker" => Icons.Material.Filled.LocationOn,
            "fan" => Icons.Material.Filled.Air,
            "lock" => Icons.Material.Filled.Lock,
            "vacuum" => Icons.Material.Filled.CleaningServices,
            "weather" => Icons.Material.Filled.Cloud,
            "update" => Icons.Material.Filled.SystemUpdate,
            _ => Icons.Material.Filled.Memory
        };
    }

    private static Color GetStateColor(HaEntityState? entity)
    {
        if (entity is null) return Color.Default;

        return entity.State switch
        {
            "on" => Color.Success,
            "off" => Color.Default,
            "unavailable" => Color.Error,
            "unknown" => Color.Warning,
            "home" => Color.Success,
            "not_home" => Color.Default,
            _ => Color.Info
        };
    }
}
