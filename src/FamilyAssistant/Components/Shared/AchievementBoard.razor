@using FamilyAssistant.Services
@inject IJSRuntime JS
@inject IBrowserViewportService ViewportService
@implements IBrowserViewportObserver
@implements IAsyncDisposable

@if (_isReady)
{
    <MudPaper Outlined="true" Class="achievement-board-panel pa-4">
        <div class="achievement-board" style="@_boardStyle" @ref="_boardRef">
            @foreach (var row in Definitions.Chunk(_columns).Select((Achievements, Index) => new { Achievements, Index }))
            {
                <div class="achievement-board-row @(row.Index % 2 == 1 ? "achievement-board-row-offset" : null)">
                    @foreach (var achievement in row.Achievements)
                    {
                        var isLocked = !UnlockedKeys.Contains(achievement.Key);
                        var title = GetTitle(achievement, isLocked);
                        <div class="achievement-board-slot" title="@title" @onclick="() => OnBadgeClick.InvokeAsync(achievement)">
                            <AchievementHex Definition="achievement" IsLocked="isLocked" />
                        </div>
                    }
                </div>
            }
        </div>
    </MudPaper>
}
else
{
    <MudPaper Outlined="true" Class="achievement-board-panel pa-4">
        <div class="achievement-board" @ref="_boardRef">
            <div class="achievement-board-loading">
                @for (var i = 0; i < 5; i++)
                {
                    <div class="achievement-board-loading-hex"></div>
                }
            </div>
        </div>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AchievementDefinition> Definitions { get; set; } = [];
    [Parameter, EditorRequired] public HashSet<string> UnlockedKeys { get; set; } = [];
    [Parameter] public Dictionary<string, string>? Facts { get; set; }
    [Parameter] public EventCallback<AchievementDefinition> OnBadgeClick { get; set; }

    /// <summary>
    /// Optional height override for dev slider (e.g., "59px").
    /// </summary>
    [Parameter] public string? BoardHexHeightOverride { get; set; }

    private ElementReference _boardRef;
    private bool _isReady;
    private int _columns = 10;
    private string? _boardStyle;

    // Badge layout constants (must match CSS)
    private const int HexWidth = 56;
    private const int HexGap = 5;
    private const int RowOffset = 31; // half hex + half gap for honeycomb offset

    // ── IBrowserViewportObserver ──
    public Guid Id { get; } = Guid.NewGuid();
    public MudBlazor.Services.ResizeOptions ResizeOptions => new()
    {
        ReportRate = 200,
        NotifyOnBreakpointOnly = false
    };

    protected override void OnParametersSet()
    {
        _boardStyle = BuildBoardStyle();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // First measurement — element is in DOM, Blazor circuit is ready
            await MeasureAndUpdate();
            await ViewportService.SubscribeAsync(this, fireImmediately: false);
        }
    }

    public async Task NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs args)
    {
        // Small delay to let browser layout settle after resize/drawer toggle
        await Task.Delay(60);
        await MeasureAndUpdate();
    }

    private async Task MeasureAndUpdate()
    {
        var width = await JS.InvokeAsync<int>("measureWidth", _boardRef);

        if (width <= 0) return; // Element not visible yet — skip

        var cols = Math.Max(3, (width - RowOffset) / (HexWidth + HexGap));
        var changed = cols != _columns || !_isReady;

        _columns = cols;
        _isReady = true;

        if (changed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await ViewportService.UnsubscribeAsync(this);
    }

    private string? BuildBoardStyle()
    {
        if (BoardHexHeightOverride is null) return null;
        if (!double.TryParse(BoardHexHeightOverride.Replace("px", ""), out var h)) return null;

        var step = Math.Round(h * 0.75 + 5, 1);
        return $"--achievement-board-hex-h: {h}px; --achievement-board-row-step: {step}px;";
    }

    private string GetTitle(AchievementDefinition achievement, bool isLocked)
    {
        if (isLocked && achievement.IsHidden)
            return "Hidden Achievement";

        var state = isLocked ? "Locked" : "Unlocked";
        var fact = Facts?.GetValueOrDefault(achievement.Key) ?? achievement.Condition;
        return $"{state}: {achievement.Name} - {fact}";
    }
}
