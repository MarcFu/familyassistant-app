    private static string Svg(params string[] elements)
    {
        return "<svg viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\">"
            + string.Concat(elements)
            + "</svg>";
    }

