@page "/dev"
@rendermode InteractiveServer
@inject FamilyAssistant.Services.AddonOptionsService AddonOptions
@inject FamilyAssistant.Services.UserContextService UserContext
@inject FamilyAssistant.Services.HaThemeService ThemeService
@inject FamilyAssistant.Services.IHomeAssistantService HaService
@inject FamilyAssistant.Data.AppDbContext Db
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation
@using FamilyAssistant.Services
@using Microsoft.EntityFrameworkCore

<PageTitle>@L["PageTitle.Dev"]</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">@L["Dev.Title"]</MudText>

@* ── Top cards in responsive grid ── *@
<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap:16px; margin-bottom:16px;">

    @* ── Theme Override ── *@
    <MudCard Elevation="1" Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-3">Theme Override</MudText>

        <MudText Typo="Typo.body2" Class="mb-2">Mode</MudText>
        <div class="d-flex gap-2 mb-3">
            <MudButton Variant="@(_themeMode == "auto" ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Primary" Size="Size.Small" OnClick="@(() => SetThemeMode("auto"))">
                Auto
            </MudButton>
            <MudButton Variant="@(_themeMode == "light" ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Primary" Size="Size.Small" OnClick="@(() => SetThemeMode("light"))">
                Light
            </MudButton>
            <MudButton Variant="@(_themeMode == "dark" ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Primary" Size="Size.Small" OnClick="@(() => SetThemeMode("dark"))">
                Dark
            </MudButton>
        </div>

        @if (_themeMode == "light" || (ThemeService.EffectiveDarkModePreference == false))
        {
            <MudText Typo="Typo.body2" Class="mb-2">Badge Style (Light Mode)</MudText>
            <div class="d-flex gap-2 mb-3">
                <MudButton Variant="@(!ThemeService.DevLightBadges ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Secondary" Size="Size.Small" OnClick="() => SetBadgeStyle(false)">
                    Badges Dark
                </MudButton>
                <MudButton Variant="@(ThemeService.DevLightBadges ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Secondary" Size="Size.Small" OnClick="() => SetBadgeStyle(true)">
                    Badges Light
                </MudButton>
            </div>
        }

        <MudText Typo="Typo.body2" Class="mb-2">Colors</MudText>
        <div class="d-flex gap-3 align-end flex-wrap mb-3">
            <MudColorPicker Value="_devPrimaryColor" Label="Primary" Variant="Variant.Outlined"
                            Style="max-width:140px;" ColorPickerMode="ColorPickerMode.HEX"
                            ValueChanged="OnPrimaryColorChanged" />
            <MudColorPicker Value="_devAccentColor" Label="Accent" Variant="Variant.Outlined"
                            Style="max-width:140px;" ColorPickerMode="ColorPickerMode.HEX"
                            ValueChanged="OnAccentColorChanged" />
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ResetColors"
                       StartIcon="@Icons.Material.Filled.RestartAlt">
                Reset
            </MudButton>
        </div>

        <MudText Typo="Typo.caption" Color="Color.Secondary">
            HA: dark=@(ThemeService.DarkModePreference?.ToString() ?? "auto"),
            primary=@(ThemeService.PrimaryColor ?? "—"),
            accent=@(ThemeService.AccentColor ?? "—"),
            lang=@(ThemeService.Language ?? "—")
        </MudText>
    </MudCard>

    @* ── User Context ── *@
    <MudCard Elevation="1" Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-3">@L["Dev.UserContext"]</MudText>

        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            @L["Dev.UserContextHint"]
        </MudText>

        <MudSelect T="int?" Value="_selectedPersonId" ValueChanged="OnPersonChanged"
                   Label="@L["Dev.ActivePerson"].Value" Variant="Variant.Filled" Margin="Margin.Dense"
                   Clearable="true" Class="mb-3">
            @foreach (var person in _persons)
            {
                <MudSelectItem T="int?" Value="@person.Id">
                    @person.Name (@person.Role)
                </MudSelectItem>
            }
        </MudSelect>

        @if (UserContext.IsAuthenticated)
        {
            <MudAlert Severity="Severity.Success" Class="mb-3">
                @((MarkupString)string.Format(L["Dev.LoggedIn"], $"<strong>{UserContext.CurrentPerson!.Name}</strong>", UserContext.CurrentPerson.Role, UserContext.CurrentPerson.Credits))
            </MudAlert>

            <div class="d-flex gap-2 flex-wrap">
                <MudChip T="string" Color="@(UserContext.CanAct ? Color.Success : Color.Error)" Size="Size.Small">
                    @(UserContext.CanAct ? L["Dev.CanAct"] : L["Dev.CannotAct"])
                </MudChip>
                <MudChip T="string" Color="@(UserContext.IsParentOrAdmin ? Color.Info : Color.Default)" Size="Size.Small">
                    @(UserContext.IsParentOrAdmin ? L["Dev.ParentOrAdmin"] : L["Dev.NoParentAccess"])
                </MudChip>
                <MudChip T="string" Color="@(UserContext.IsAdmin ? Color.Warning : Color.Default)" Size="Size.Small">
                    @(UserContext.IsAdmin ? L["Role.Admin"] : L["Dev.NoAdmin"])
                </MudChip>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Info">
                @L["Dev.GuestMode"]
            </MudAlert>
        }
    </MudCard>

    @* ── HA Configuration (Diagnostics) ── *@
    <MudCard Elevation="1" Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-3">HA Configuration</MudText>
        <MudSimpleTable Dense="true" Elevation="0" Style="table-layout:fixed;">
            <thead>
                <tr>
                    <th style="width:40%;">Parameter</th>
                    <th>Wert</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>DevMode</strong></td>
                    <td>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(AddonOptions.DevMode ? Color.Success : Color.Error)">
                            @(AddonOptions.DevMode ? "true" : "false")
                        </MudChip>
                    </td>
                </tr>
                <tr>
                    <td><strong>options.json (raw)</strong></td>
                    <td style="word-break:break-all; font-family:monospace; font-size:0.8rem;">
                        @(AddonOptions.RawJson ?? "— nicht vorhanden —")
                    </td>
                </tr>
                <tr>
                    <td><strong>Sprache (HA)</strong></td>
                    <td>@(ThemeService.Language ?? "— nicht gelesen —")</td>
                </tr>
                <tr>
                    <td><strong>Dark Mode (HA)</strong></td>
                    <td>@(ThemeService.DarkModePreference?.ToString() ?? "auto / nicht gelesen")</td>
                </tr>
                <tr>
                    <td><strong>Primary Color (HA)</strong></td>
                    <td>
                        @if (ThemeService.PrimaryColor is not null)
                        {
                            <span style="display:inline-flex; align-items:center; gap:6px;">
                                <span style="width:14px; height:14px; border-radius:3px; background:@ThemeService.PrimaryColor; display:inline-block;"></span>
                                @ThemeService.PrimaryColor
                            </span>
                        }
                        else
                        {
                            <span>— nicht gesetzt —</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td><strong>Accent Color (HA)</strong></td>
                    <td>
                        @if (ThemeService.AccentColor is not null)
                        {
                            <span style="display:inline-flex; align-items:center; gap:6px;">
                                <span style="width:14px; height:14px; border-radius:3px; background:@ThemeService.AccentColor; display:inline-block;"></span>
                                @ThemeService.AccentColor
                            </span>
                        }
                        else
                        {
                            <span>— nicht gesetzt —</span>
                        }
                    </td>
                </tr>
                <tr>
                    <td><strong>Last Refresh</strong></td>
                    <td>@(ThemeService.LastRefreshed?.ToString("yyyy-MM-dd HH:mm:ss") ?? "— nie —")</td>
                </tr>
                <tr>
                    <td><strong>Refresh Status</strong></td>
                    <td style="font-size:0.85rem;">@(ThemeService.LastRefreshStatus ?? "—")</td>
                </tr>
                <tr>
                    <td><strong>WebSocket</strong></td>
                    <td>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(HaService.IsWebSocketConnected ? Color.Success : Color.Error)">
                            @(HaService.IsWebSocketConnected ? "Connected" : "Disconnected")
                        </MudChip>
                    </td>
                </tr>
                <tr>
                    <td><strong>SUPERVISOR_TOKEN</strong></td>
                    <td>@(string.IsNullOrEmpty(Environment.GetEnvironmentVariable("SUPERVISOR_TOKEN")) ? "— nicht gesetzt —" : "✓ vorhanden")</td>
                </tr>
            </tbody>
        </MudSimpleTable>
        @if (!HaService.IsWebSocketConnected)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                WebSocket nicht verbunden — Sprache/Theme/Farben können nicht aus HA gelesen werden.
            </MudAlert>
        }
        <div class="d-flex mt-3">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="RefreshHaConfig">
                Refresh
            </MudButton>
        </div>
    </MudCard>

    @* ── Info ── *@
    <MudCard Elevation="1" Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-3">@L["Dev.Info"]</MudText>
        <MudSimpleTable Dense="true" Elevation="0">
            <tbody>
                <tr><td><strong>@L["Dev.InfoMode"]</strong></td><td>@_mode</td></tr>
                <tr><td><strong>@L["Dev.InfoDbPath"]</strong></td><td style="word-break:break-all;">@_dbPath</td></tr>
                <tr><td><strong>@L["Dev.InfoPersons"]</strong></td><td>@_persons.Count</td></tr>
                <tr><td><strong>.NET</strong></td><td>@System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription</td></tr>
            </tbody>
        </MudSimpleTable>
    </MudCard>

    @* ── HA User Mapping ── *@
    <MudExpansionPanels Class="mb-4">
        <MudExpansionPanel Text="HA User Mapping" MaxHeight="500">
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Ordne deine FamilyAssistant-Personen den HA-Benutzerkonten zu.
            </MudText>

            @if (_haPersonsForMapping.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-2">
                    Keine HA-Personen mit User-Account gefunden.
                </MudAlert>
            }

            <MudSimpleTable Dense="true" Elevation="0">
                <thead>
                    <tr>
                        <th>Person</th>
                        <th>HA User</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var person in _persons)
                    {
                        <tr>
                            <td><strong>@person.Name</strong> <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@person.Role</MudChip></td>
                            <td>
                                <MudSelect T="string" Value="@person.HaUserId" ValueChanged="@(v => OnUserMappingChanged(person, v))"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                           Placeholder="—" Clearable="true" Style="min-width:180px;">
                                    @foreach (var haPerson in _haPersonsForMapping)
                                    {
                                        <MudSelectItem T="string" Value="@haPerson.UserId">
                                            @haPerson.FriendlyName (@haPerson.UserId![..8]...)
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(person.HaUserId))
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="RefreshHaPersons"
                       StartIcon="@Icons.Material.Filled.Refresh" Size="Size.Small">
                HA-Personen neu laden
            </MudButton>
        </MudExpansionPanel>
    </MudExpansionPanels>
</div>

<MudPaper Outlined="true" Class="achievement-board-panel pa-4 mb-4">
    <div class="d-flex align-center justify-space-between gap-3 flex-wrap mb-3">
        <div>
            <MudText Typo="Typo.h6">Achievement Badgeboard Demo</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Echte DB-Auswertung für @_achievementSubjectName.
            </MudText>
        </div>
        <div class="d-flex align-center gap-2 flex-wrap">
            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">
                @_achievements.Count(a => !IsBadgeboardLocked(a)) unlocked
            </MudChip>
            <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                @_achievements.Count(IsBadgeboardLocked) locked
            </MudChip>
        </div>
    </div>

    <div class="d-flex align-center gap-3 mb-3 flex-wrap">
        <MudText Typo="Typo.body2" Style="min-width:90px;">Ratio 1:@(_hexHeightRatio.ToString("F2"))</MudText>
        <MudSlider T="double" Value="_hexHeightRatio" ValueChanged="v => { _hexHeightRatio = v; }" Min="1.0" Max="1.25" Step="0.01" Style="max-width:280px;" />
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _hexHeightRatio = 1.05">1:1.05</MudButton>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _hexHeightRatio = 1.1547">1:√3:2</MudButton>
    </div>

    <div class="achievement-board-scroll">
        <div class="achievement-board" style="@GetBoardRatioStyle()">
            @foreach (var row in _achievements.Chunk(10).Select((Achievements, Index) => new { Achievements, Index }))
            {
                <div class="achievement-board-row @(row.Index % 2 == 1 ? "achievement-board-row-offset" : null)">
                    @foreach (var achievement in row.Achievements)
                    {
                        var isLocked = IsBadgeboardLocked(achievement);
                        <div class="achievement-board-slot" title="@GetBoardTitle(achievement, isLocked)">
                            <AchievementHex Definition="achievement" IsLocked="isLocked" />
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</MudPaper>

<MudPaper Outlined="true" Class="pa-4 mb-4">
    <div class="d-flex align-center justify-space-between gap-3 flex-wrap mb-3">
        <div>
            <MudText Typo="Typo.h6">Achievement Badge Preview</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Statische Dev-Vorschau aller vorgeschlagenen Achievements im hexagonalen Badge-Stil.
            </MudText>
        </div>
        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
            @_achievements.Count Badges
        </MudChip>
    </div>

    <div class="achievement-preview-grid">
        @foreach (var achievement in _achievements)
        {
            <MudPaper Outlined="true" Class="achievement-preview-card pa-3">
                <div class="achievement-preview-badge-wrap">
                    <AchievementHex Definition="achievement" IsLocked="false" ShowTierChip="true" HeightOverride="@GetPreviewRatioStyle()" />
                </div>

                <div class="d-flex align-center gap-1 flex-wrap mb-1">
                    <MudChip T="string" Color="@GetCategoryColor(achievement.Category)" Size="Size.Small" Variant="Variant.Outlined">
                        @achievement.Category
                    </MudChip>
                    <MudChip T="string" Color="@(IsBadgeboardLocked(achievement) ? Color.Default : Color.Success)" Size="Size.Small" Variant="Variant.Outlined">
                        @(IsBadgeboardLocked(achievement) ? "Locked" : "Unlocked")
                    </MudChip>
                    @if (achievement.IsHidden)
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">
                            Hidden
                        </MudChip>
                    }
                </div>

                <MudText Typo="Typo.subtitle2" Class="achievement-preview-name">@achievement.Name</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="achievement-preview-key">@achievement.Key</MudText>
                <MudText Typo="Typo.body2" Class="mt-2 achievement-preview-condition">@achievement.Condition</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 achievement-preview-condition">
                    @GetAchievementFact(achievement)
                </MudText>
            </MudPaper>
        }
    </div>
</MudPaper>

@code {
    private List<Person> _persons = [];
    private int? _selectedPersonId;
    private string _mode = "Development";
    private string _dbPath = "";
    private string _achievementSubjectName = "kein aktiver Kontext";
    private HashSet<string> _unlockedAchievementKeys = [];
    private Dictionary<string, string> _achievementFacts = new();
    private double _hexHeightRatio = 1.05;
    private List<HaPerson> _haPersonsForMapping = [];
    private string _themeMode = "auto"; // "auto", "light", "dark"
    private MudColor _devPrimaryColor = new("#03a9f4");
    private MudColor _devAccentColor = new("#ff9800");

    [Inject] private IAchievementService AchievementSvc { get; set; } = null!;

    private IReadOnlyList<AchievementDefinition> _achievements => AchievementSvc.Definitions;

    protected override async Task OnInitializedAsync()
    {
        // Guard: dev page only accessible when dev_mode is enabled in add-on config
        if (!AddonOptions.DevMode)
        {
            Navigation.NavigateTo("");
            return;
        }

        // Restore current override state
        _themeMode = ThemeService.DevDarkModeOverride switch
        {
            true => "dark",
            false => "light",
            null => "auto"
        };

        // Restore color overrides
        var effectivePrimary = ThemeService.EffectivePrimaryColor ?? "#03a9f4";
        var effectiveAccent = ThemeService.EffectiveAccentColor ?? "#ff9800";
        _devPrimaryColor = new MudColor(effectivePrimary);
        _devAccentColor = new MudColor(effectiveAccent);

        _persons = await Db.Persons.OrderBy(p => p.Name).ToListAsync();
        _selectedPersonId = UserContext.CurrentPersonId;
        _mode = Environment.GetEnvironmentVariable("SUPERVISOR_TOKEN") is not null ? "Add-on (Production)" : "Development";
        _dbPath = Db.Database.GetDbConnection().DataSource ?? "?";
        await LoadAchievementStateAsync();
        await RefreshHaPersons();
    }

    // ─── Theme Override ──────────────────────────────────────────────

    private void SetThemeMode(string mode)
    {
        _themeMode = mode;
        ThemeService.DevDarkModeOverride = mode switch
        {
            "dark" => true,
            "light" => false,
            _ => null
        };
        ThemeService.NotifyChanged();
    }

    private void SetBadgeStyle(bool lightBadges)
    {
        ThemeService.DevLightBadges = lightBadges;
        ThemeService.NotifyChanged();
    }

    private void OnPrimaryColorChanged(MudColor color)
    {
        _devPrimaryColor = color;
        ThemeService.DevPrimaryColorOverride = color.Value;
        ThemeService.NotifyChanged();
    }

    private void OnAccentColorChanged(MudColor color)
    {
        _devAccentColor = color;
        ThemeService.DevAccentColorOverride = color.Value;
        ThemeService.NotifyChanged();
    }

    private void ResetColors()
    {
        ThemeService.DevPrimaryColorOverride = null;
        ThemeService.DevAccentColorOverride = null;
        var primary = ThemeService.PrimaryColor ?? "#03a9f4";
        var accent = ThemeService.AccentColor ?? "#ff9800";
        _devPrimaryColor = new MudColor(primary);
        _devAccentColor = new MudColor(accent);
        ThemeService.NotifyChanged();
    }

    private async Task OnPersonChanged(int? personId)
    {
        _selectedPersonId = personId;
        await UserContext.SetCurrentPersonAsync(personId);

        if (personId is null)
        {
            Snackbar.Add(L["Dev.Snackbar.Cleared"], Severity.Info);
        }
        else
        {
            Snackbar.Add(string.Format(L["Dev.Snackbar.Set"], UserContext.CurrentPerson?.Name), Severity.Success);
        }

        await LoadAchievementStateAsync();
        StateHasChanged();
    }

    private async Task OnUserMappingChanged(Person person, string? haUserId)
    {
        person.HaUserId = string.IsNullOrEmpty(haUserId) ? null : haUserId;
        Db.Persons.Update(person);
        await Db.SaveChangesAsync();

        var displayName = _haPersonsForMapping.FirstOrDefault(p => p.UserId == haUserId)?.FriendlyName;
        if (haUserId is not null)
        {
            Snackbar.Add($"{person.Name} → {displayName ?? haUserId}", Severity.Success);
        }
        else
        {
            Snackbar.Add($"{person.Name}: Mapping entfernt", Severity.Info);
        }
    }

    private async Task RefreshHaPersons()
    {
        var allHaPersons = await HaService.GetPersonsAsync();
        _haPersonsForMapping = allHaPersons.Where(p => !string.IsNullOrEmpty(p.UserId)).ToList();
    }

    private async Task RefreshHaConfig()
    {
        if (!HaService.IsWebSocketConnected)
        {
            try
            {
                await HaService.ConnectWebSocketAsync();
                Snackbar.Add("WebSocket verbunden!", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"WebSocket-Verbindung fehlgeschlagen: {ex.Message}", Severity.Error);
                StateHasChanged();
                return;
            }
        }

        await ThemeService.RefreshAsync();
        StateHasChanged();
    }

    private async Task LoadAchievementStateAsync()
    {
        _unlockedAchievementKeys = [];
        _achievementFacts = new();

        if (UserContext.CurrentPersonId is not int personId)
        {
            _achievementSubjectName = "kein aktiver Kontext";
            foreach (var a in _achievements)
            {
                _achievementFacts[a.Key] = "Kein aktiver Benutzer im Kontext.";
            }
            return;
        }

        var person = _persons.FirstOrDefault(p => p.Id == personId);
        _achievementSubjectName = person?.Name ?? $"Person #{personId}";

        var evaluation = await AchievementSvc.EvaluateAsync(personId);
        _unlockedAchievementKeys = evaluation.UnlockedKeys;
        _achievementFacts = evaluation.Facts;
    }

    private bool IsBadgeboardLocked(AchievementDefinition achievement) => !_unlockedAchievementKeys.Contains(achievement.Key);

    private string GetAchievementFact(AchievementDefinition achievement)
    {
        return _achievementFacts.TryGetValue(achievement.Key, out var fact) ? fact : "Noch nicht ausgewertet.";
    }

    private string GetBoardRatioStyle()
    {
        var h = Math.Round(56 * _hexHeightRatio, 1);
        var step = Math.Round(h * 0.75 + 5, 1);
        return $"--achievement-board-hex-h: {h}px; --achievement-board-row-step: {step}px;";
    }

    private string GetPreviewRatioStyle()
    {
        var h = Math.Round(104 * _hexHeightRatio, 1);
        return $"{h}px";
    }

    private string GetBoardTitle(AchievementDefinition achievement, bool isLocked)
    {
        if (isLocked && achievement.IsHidden)
            return "Hidden Achievement";
        var state = isLocked ? "Locked" : "Unlocked";
        return $"{state}: {achievement.Name} - {GetAchievementFact(achievement)}";
    }

    private static Color GetCategoryColor(string category) => category switch
    {
        "Home Assistant" or "Event-Reaktion" => Color.Info,
        "Streak" or "Motivation" => Color.Warning,
        "Menge" or "Tagesleistung" or "Zuverlässigkeit" or "Konsistenz" => Color.Success,
        "Chore-Mastery" => Color.Secondary,
        "Familie" or "Teamplay" => Color.Error,
        "Tageszeit" or "Timing" => Color.Warning,
        "Kategorie" or "Vielfalt" => Color.Success,
        "Hidden" => Color.Default,
        _ => Color.Primary
    };
}
