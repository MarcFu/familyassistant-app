    protected override async Task OnInitializedAsync()
    {
        _persons = await Db.Persons.OrderBy(p => p.Name).ToListAsync();
        _selectedPersonId = UserContext.CurrentPersonId;
        _mode = Environment.GetEnvironmentVariable("SUPERVISOR_TOKEN") is not null ? "Add-on (Production)" : "Development";
        _dbPath = Db.Database.GetDbConnection().DataSource ?? "?";
        await LoadAchievementStateAsync();
    }

    private async Task OnPersonChanged(int? personId)
    {
        _selectedPersonId = personId;
        await UserContext.SetCurrentPersonAsync(personId);

        if (personId is null)
        {
            Snackbar.Add(L["Dev.Snackbar.Cleared"], Severity.Info);
        }
        else
        {
            Snackbar.Add(string.Format(L["Dev.Snackbar.Set"], UserContext.CurrentPerson?.Name), Severity.Success);
        }

        await LoadAchievementStateAsync();
        StateHasChanged();
    }

    private async Task LoadAchievementStateAsync()
    {
        _unlockedAchievementKeys = [];
        _achievementFacts = new();

        if (UserContext.CurrentPersonId is not int personId)
        {
            _achievementSubjectName = "kein aktiver Kontext";
            foreach (var achievement in _achievements)
            {
                _achievementFacts[achievement.Key] = "Kein aktiver Benutzer im Kontext.";
            }
            return;
        }

        var person = await Db.Persons.AsNoTracking().FirstOrDefaultAsync(p => p.Id == personId);
        _achievementSubjectName = person?.Name ?? $"Person #{personId}";

        var tasks = await Db.ChoreTasks
            .AsNoTracking()
            .Include(t => t.Chore)
            .Include(t => t.Comments)
                .ThenInclude(c => c.Attachments)
            .ToListAsync();

        var today = DateOnly.FromDateTime(DateTime.Today);
        var completedByPerson = tasks
            .Where(t => t.CompletedAt is not null && (t.CompletedByPersonId == personId || t.ClaimedByPersonId == personId))
            .ToList();
        var confirmedByPerson = completedByPerson
            .Where(t => t.Status == ChoreTaskStatus.Confirmed)
            .ToList();
        var eventTasks = completedByPerson.Where(IsTriggeredTask).ToList();
        var allConfirmed = tasks.Where(t => t.Status == ChoreTaskStatus.Confirmed).ToList();

        var completedCount = completedByPerson.Count;
        var confirmedCount = confirmedByPerson.Count;
        var eventCount = eventTasks.Count;
        var streak = GetLongestStreak(completedByPerson);
        var bestChoreCount = completedByPerson.GroupBy(t => t.ChoreId).Select(g => g.Count()).DefaultIfEmpty(0).Max();
        var uniqueChores = completedByPerson.Select(t => t.ChoreId).Distinct().Count();
        var activeChores = await Db.Chores.AsNoTracking().CountAsync(c => c.IsActive);
        var photoCount = completedByPerson.Count(t => t.Comments.Any(c => c.Attachments.Count > 0));
        var commentCount = completedByPerson.Count(t => t.Comments.Any(c => c.PersonId == personId && !string.IsNullOrWhiteSpace(c.Text)));
        var dialogueCount = completedByPerson.Count(t => t.Comments.Count >= 2);
        var confirmationCount = tasks.Count(t => t.ConfirmedByPersonId == personId);
        var helperCount = completedByPerson.Count(t => t.CompletedByPersonId == personId && t.DefaultPersonId is not null && t.DefaultPersonId != personId);
        var fastFinishCount = completedByPerson.Count(t => !IsTriggeredTask(t) && t.ScheduleId is null && t.CompletedAt is not null && t.CompletedAt.Value - t.CreatedAt <= TimeSpan.FromMinutes(30));
        var roadrunnerSeconds = eventTasks
            .Where(t => t.CompletedAt is not null)
            .Select(t => (t.CompletedAt!.Value - t.CreatedAt).TotalSeconds)
            .Where(s => s >= 0)
            .DefaultIfEmpty(double.PositiveInfinity)
            .Min();

        Unlock("first_task", completedCount >= 1, $"{completedCount} erledigte Aufgaben im aktuellen Kontext.");
        Unlock("first_chore", completedByPerson.Any(t => t.ScheduleId is not null), $"{completedByPerson.Count(t => t.ScheduleId is not null)} erledigte wiederkehrende Aufgaben.");
        Unlock("first_photo", photoCount >= 1, $"{photoCount} erledigte Aufgaben mit Foto-Anhang.");
        Unlock("first_event_task", eventCount >= 1, $"{eventCount} erledigte Trigger-Aufgaben.");
        Unlock("daily_clean_sweep", HasDailyCleanSweep(tasks, personId, today), "Heute sind keine sichtbaren eigenen Aufgaben mehr offen.");
        Unlock("perfect_week", HasPerfectWeek(tasks, personId), "Diese Woche: eigene Aufgaben erledigt und keine eigenen Missed/Cancelled-Einträge.");
        Unlock("no_reminder_needed", completedByPerson.Any(t => t.CompletedAt is not null && t.CompletedAt.Value.ToLocalTime().Hour < 12), "Mindestens eine Aufgabe vor Mittag erledigt.");
        Unlock("comeback", HasComeback(completedByPerson), "Zwischen zwei erledigten Aufgaben lag mindestens eine Woche Pause.");
        Unlock("streak_3", streak >= 3, $"Beste Serie: {streak} Tage.");
