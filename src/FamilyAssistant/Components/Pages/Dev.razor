    {
        var (primary, accent) = GetCategoryPalette(achievement.Category);
        var ring = achievement.Tier switch
        {
            "Bronze" => "#cd7f32",
            "Silber" => "#c0c0c0",
            "Gold" => "#ffd700",
            "Legendär" => "#b388ff",
            "Hidden" => "#546e7a",
            _ => accent
        };

        return $"--achievement-primary: {primary}; --achievement-accent: {accent}; --achievement-ring: {ring};";
    }

    private static Color GetCategoryColor(string category) => category switch
    {
        "Home Assistant" or "Event-Reaktion" => Color.Info,
        "Streak" or "Motivation" => Color.Warning,
        "Menge" or "Tagesleistung" or "Zuverlässigkeit" or "Konsistenz" => Color.Success,
        "Chore-Mastery" => Color.Secondary,
        "Familie" or "Teamplay" => Color.Error,
        "Tageszeit" or "Timing" => Color.Warning,
        "Kategorie" or "Vielfalt" => Color.Success,
        "Hidden" => Color.Default,
        _ => Color.Primary
    };

    private sealed record DevAchievement(
        string Key,
        string Name,
        string Category,
        string Condition,
        string Tier,
        string Icon,
        string PrimaryColor,
        string AccentColor,
        bool IsHidden = false);
}
