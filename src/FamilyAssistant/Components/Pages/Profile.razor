@page "/profile"
@rendermode InteractiveServer
@inject FamilyAssistant.Services.UserContextService UserContext
@inject FamilyAssistant.Services.IAchievementService AchievementSvc
@inject IStringLocalizer<SharedResource> L
@using FamilyAssistant.Services

<PageTitle>Profil</PageTitle>

@if (!UserContext.IsAuthenticated)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Kein aktiver Benutzer. Bitte in den Einstellungen eine Person auswählen.
    </MudAlert>
}
else
{
    var person = UserContext.CurrentPerson!;

    <div class="d-flex align-center gap-4 mb-4 flex-wrap">
        @if (!string.IsNullOrEmpty(person.EntityPicture))
        {
            <MudAvatar Size="Size.Large" Style="width:64px;height:64px;">
                <MudImage Src="@($"api/ha-image?path={Uri.EscapeDataString(person.EntityPicture)}")" />
            </MudAvatar>
        }
        else
        {
            <MudAvatar Size="Size.Large" Style="width:64px;height:64px;" Color="Color.Primary">
                @person.Name[0]
            </MudAvatar>
        }
        <div>
            <MudText Typo="Typo.h5">@person.Name</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @person.Role · @person.Credits Credits
            </MudText>
        </div>
    </div>

    @if (_evaluation is not null)
    {
        <div class="d-flex gap-3 flex-wrap mb-4">
            <MudPaper Outlined="true" Class="pa-3 text-center" Style="min-width:100px;">
                <MudText Typo="Typo.h4">@_evaluation.Stats.TotalCompleted</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Tasks erledigt</MudText>
            </MudPaper>
            <MudPaper Outlined="true" Class="pa-3 text-center" Style="min-width:100px;">
                <MudText Typo="Typo.h4">@_evaluation.Stats.CurrentStreak</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Aktuelle Serie</MudText>
            </MudPaper>
            <MudPaper Outlined="true" Class="pa-3 text-center" Style="min-width:100px;">
                <MudText Typo="Typo.h4">@_evaluation.Stats.LongestStreak</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Rekord-Serie</MudText>
            </MudPaper>
            <MudPaper Outlined="true" Class="pa-3 text-center" Style="min-width:100px;">
                <MudText Typo="Typo.h4">@_evaluation.Stats.UnlockedBadges/@_evaluation.Stats.TotalBadges</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Achievements</MudText>
            </MudPaper>
        </div>

        <AchievementBoard Definitions="AchievementSvc.Definitions"
                          UnlockedKeys="_evaluation.UnlockedKeys"
                          Facts="_evaluation.Facts"
                          OnBadgeClick="OnBadgeClicked" />

        @if (_selectedAchievement is not null)
        {
            <MudPaper Outlined="true" Class="pa-4 mt-4" Style="max-width:400px;">
                <div class="d-flex align-center gap-3 mb-2">
                    <AchievementHex Definition="_selectedAchievement"
                                    IsLocked="@(!_evaluation.UnlockedKeys.Contains(_selectedAchievement.Key))"
                                    ShowTierChip="true" />
                    <div>
                        <MudText Typo="Typo.h6">@_selectedAchievement.Name</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@_selectedAchievement.Category · @_selectedAchievement.Tier</MudText>
                    </div>
                </div>
                <MudText Typo="Typo.body2" Class="mb-1">@_selectedAchievement.Condition</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @(_evaluation.Facts.GetValueOrDefault(_selectedAchievement.Key) ?? "")
                </MudText>
                @if (!_evaluation.UnlockedKeys.Contains(_selectedAchievement.Key))
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Class="mt-2">Noch nicht freigeschaltet</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="mt-2">Freigeschaltet</MudChip>
                }
            </MudPaper>
        }
    }
    else
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
    }
}

@code {
    private AchievementEvaluation? _evaluation;
    private AchievementDefinition? _selectedAchievement;

    protected override async Task OnInitializedAsync()
    {
        if (UserContext.CurrentPersonId is int personId)
        {
            _evaluation = await AchievementSvc.EvaluateAsync(personId);
        }
    }

    private void OnBadgeClicked(AchievementDefinition achievement)
    {
        _selectedAchievement = _selectedAchievement?.Key == achievement.Key ? null : achievement;
    }
}
