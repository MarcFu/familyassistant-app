@page "/chores"
@rendermode InteractiveServer
@inject FamilyAssistant.Data.AppDbContext Db
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> L
@using Microsoft.EntityFrameworkCore

<PageTitle>@L["PageTitle.Chores"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@L["Chores.Title"]</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@string.Format(L["Common.Snackbar.Error"], _loadError)</MudAlert>
}
else if (_chores.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        @L["Chores.Empty"]
    </MudAlert>
}
else
{
    @* ── Filter Toolbar ── *@
    <div class="d-flex align-center flex-wrap gap-3 mb-4">
        <DebouncedTextField Value="@_search" ValueChanged="@(v => { _search = v; StateHasChanged(); })"
                            Placeholder="@L["Common.Search"].Value" Adornment="Adornment.Start"
                            AdornmentIcon="@Icons.Material.Filled.Search"
                            Variant="Variant.Filled" Margin="Margin.Dense"
                            Style="max-width:250px;" />
        <MudSelect T="ChoreFilter" @bind-Value="_filter" Variant="Variant.Filled"
                   Margin="Margin.Dense" Style="max-width:200px;">
            <MudSelectItem Value="ChoreFilter.All">@L["Common.All"]</MudSelectItem>
            <MudSelectItem Value="ChoreFilter.Active">@L["Common.Active"]</MudSelectItem>
            <MudSelectItem Value="ChoreFilter.Inactive">@L["Chores.Filter.Inactive"]</MudSelectItem>
            <MudSelectItem Value="ChoreFilter.NoSchedule">@L["Chores.Filter.NoSchedule"]</MudSelectItem>
        </MudSelect>
    </div>

    @* ── Responsive List ── *@
    @if (!_filteredChores.Any())
    {
        <MudAlert Severity="Severity.Info">@L["Chores.NoFilterResults"]</MudAlert>
    }
    else
    {
    <ResponsiveList Items="_filteredChores" Context="chore"
                    GridColumns="40px minmax(150px, 3fr) minmax(100px, 2fr) 80px auto"
                    Grouped="true">
        <HeaderTemplate>
            <div></div>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Name</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Chores.Column.Schedule"]</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">Credits</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.End">@L["Common.Actions"]</MudText>
        </HeaderTemplate>
        <GridTemplate>
            <div class="d-flex align-center">
                @RenderChoreIcon(chore)
            </div>
            <div class="d-flex align-center">
                <MudText Typo="Typo.body2" Class="@(chore.IsActive ? "" : "mud-text-disabled")">
                    @chore.Name
                </MudText>
                @if (!chore.IsActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-2">@L["Common.Inactive"]</MudChip>
                }
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @FormatSchedulesSummary(chore)
            </MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Success">@chore.CreditsReward</MudChip>
            <div class="d-flex align-center gap-1">
                <MudTooltip Text="@L["Common.Edit"].Value">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                   OnClick="@(() => OpenEditDialog(chore))" aria-label="@($"{L["Common.Edit"]} {chore.Name}")" />
                </MudTooltip>
                <MudTooltip Text="@L["Chores.Column.Schedule"].Value">
                    <MudIconButton Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small"
                                   OnClick="@(() => OpenScheduleDialog(chore))" aria-label="@($"{L["Chores.Column.Schedule"]} {chore.Name}")" />
                </MudTooltip>
                <MudSwitch T="bool" Value="chore.IsActive" ValueChanged="@(v => ToggleActive(chore, v))"
                           Color="Color.Primary" Size="Size.Small"
                           Class="d-inline-flex" Style="margin:0;"
                           aria-label="@($"{L["Common.Active"]} {chore.Name}")" />
                <MudTooltip Text="@L["Common.Delete"].Value">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => DeleteChoreAsync(chore))" aria-label="@($"{L["Common.Delete"]} {chore.Name}")" />
                </MudTooltip>
            </div>
        </GridTemplate>
        <CardTemplate>
            <div class="d-flex align-center justify-space-between mb-1">
                <div class="d-flex align-center" style="min-width:0;">
                    @RenderChoreIcon(chore)
                    <MudText Typo="Typo.body1" Class="@($"ml-2{(chore.IsActive ? "" : " mud-text-disabled")}")"
                             Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                        @chore.Name
                    </MudText>
                </div>
                @if (!chore.IsActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">@L["Common.Inactive"]</MudChip>
                }
            </div>
            <div class="d-flex align-center flex-wrap gap-2 mb-1">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @FormatSchedulesSummary(chore)
                </MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Success">@chore.CreditsReward Credits</MudChip>
            </div>
            <div class="d-flex align-center justify-end flex-wrap gap-1" style="row-gap: 6px;">
                <MudTooltip Text="@L["Common.Edit"].Value">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                   OnClick="@(() => OpenEditDialog(chore))" aria-label="@($"{L["Common.Edit"]} {chore.Name}")" />
                </MudTooltip>
                <MudTooltip Text="@L["Chores.Column.Schedule"].Value">
                    <MudIconButton Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small"
                                   OnClick="@(() => OpenScheduleDialog(chore))" aria-label="@($"{L["Chores.Column.Schedule"]} {chore.Name}")" />
                </MudTooltip>
                <MudSwitch T="bool" Value="chore.IsActive" ValueChanged="@(v => ToggleActive(chore, v))"
                           Color="Color.Primary" Size="Size.Small"
                           Class="d-inline-flex" Style="margin:0;"
                           aria-label="@($"{L["Common.Active"]} {chore.Name}")" />
                <MudTooltip Text="@L["Common.Delete"].Value">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => DeleteChoreAsync(chore))" aria-label="@($"{L["Common.Delete"]} {chore.Name}")" />
                </MudTooltip>
            </div>
        </CardTemplate>
    </ResponsiveList>
    }
}

@* ── FAB: Extended FAB (Icon + Label), HA standard ── *@
<MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
        Label="@L["Chores.CreateTooltip"].Value" Size="Size.Large" OnClick="OpenCreateDialog"
        Style="position: fixed; bottom: 24px; right: 24px; z-index: 100;" />

@code {
    private bool _loading = true;
    private string? _loadError;
    private List<Chore> _chores = [];
    private string _search = "";
    private ChoreFilter _filter = ChoreFilter.Active;

    private IEnumerable<Chore> _filteredChores => _chores.Where(MatchesFilter);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadChoresAsync();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadChoresAsync()
    {
        _chores = await Db.Chores
            .Where(c => !c.IsDeleted)
            .Include(c => c.Schedules)
                .ThenInclude(s => s.DefaultPerson)
            .OrderBy(c => c.Name)
            .ToListAsync();
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<ChoreDialog>
        {
            { x => x.Chore, null },
            { x => x.IsNew, true }
        };

        var dialog = await DialogService.ShowAsync<ChoreDialog>(L["Dialog.ChoreCreate.Title"].Value, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadChoresAsync();
            StateHasChanged();
        }
    }

    private async Task OpenEditDialog(Chore chore)
    {
        var parameters = new DialogParameters<ChoreDialog>
        {
            { x => x.Chore, chore },
            { x => x.IsNew, false }
        };

        var dialog = await DialogService.ShowAsync<ChoreDialog>(L["Dialog.ChoreEdit.Title"].Value, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadChoresAsync();
            StateHasChanged();
        }
    }

    private async Task OpenScheduleDialog(Chore chore)
    {
        var parameters = new DialogParameters<ScheduleDialog>
        {
            { x => x.Chore, chore }
        };

        var dialog = await DialogService.ShowAsync<ScheduleDialog>(string.Format(L["Dialog.Schedule.Title"].Value, chore.Name), parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadChoresAsync();
            StateHasChanged();
        }
    }

    private async Task ToggleActive(Chore chore, bool active)
    {
        chore.IsActive = active;
        await Db.SaveChangesAsync();
        var msg = active ? L["Chores.Snackbar.Activated"] : L["Chores.Snackbar.Deactivated"];
        Snackbar.Add(string.Format(msg, chore.Name), Severity.Success);
        StateHasChanged();
    }

    private async Task DeleteChoreAsync(Chore chore)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Message, string.Format(L["Common.Confirm.DeleteChore"], chore.Name) },
            { x => x.ConfirmText, L["Common.Confirm.Yes"].Value },
            { x => x.CancelText, L["Common.Cancel"].Value },
            { x => x.Destructive, true }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(L["Common.Confirm.Title"].Value, parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        chore.IsDeleted = true;
        chore.DeletedAt = DateTime.UtcNow;
        chore.IsActive = false;
        await Db.SaveChangesAsync();

        _chores.Remove(chore);
        Snackbar.Add(string.Format(L["Chores.Snackbar.Deleted"], chore.Name), Severity.Success);
        StateHasChanged();
    }

    private string FormatSchedulesSummary(Chore chore)
    {
        var active = chore.Schedules.Where(s => s.IsActive).ToList();
        if (active.Count == 0) return L["Chores.NoSchedule"].Value;
        return string.Join(" | ", active.Select(FormatScheduleShort));
    }

    private string FormatScheduleShort(ChoreSchedule schedule)
    {
        var rhythm = schedule.Rhythm switch
        {
            ScheduleRhythm.Daily => L["Schedule.Daily"].Value,
            ScheduleRhythm.SpecificDays => FormatDays(schedule.SpecificDays),
            ScheduleRhythm.XTimesPerWeek => string.Format(L["Schedule.XTimesPerWeek"].Value, schedule.TimesPerWeek),
            ScheduleRhythm.Weekly => L["Schedule.Weekly"].Value,
            ScheduleRhythm.Monthly => L["Schedule.Monthly"].Value,
            ScheduleRhythm.EveryXMonths => string.Format(L["Schedule.EveryXMonths"].Value, schedule.IntervalMonths),
            ScheduleRhythm.EveryXWeeks => string.Format(L["Schedule.EveryXWeeks"].Value, schedule.IntervalWeeks),
            ScheduleRhythm.Permanent => L["Schedule.Permanent"].Value,
            _ => ""
        };

        var person = schedule.DefaultPerson?.Name;
        return person is not null ? $"{rhythm} ({person})" : rhythm;
    }

    private bool MatchesFilter(Chore chore)
    {
        // Text search
        if (!string.IsNullOrWhiteSpace(_search))
        {
            var searchLower = _search.ToLowerInvariant();
            var nameMatch = chore.Name.Contains(searchLower, StringComparison.OrdinalIgnoreCase);
            var descMatch = chore.Description?.Contains(searchLower, StringComparison.OrdinalIgnoreCase) ?? false;
            if (!nameMatch && !descMatch) return false;
        }

        // Status filter
        return _filter switch
        {
            ChoreFilter.Active => chore.IsActive,
            ChoreFilter.Inactive => !chore.IsActive,
            ChoreFilter.NoSchedule => !chore.Schedules.Any(s => s.IsActive),
            _ => true
        };
    }

    private string FormatDays(DaysOfWeek? days)
    {
        if (days is null || days == DaysOfWeek.None) return L["Schedule.NoDays"].Value;
        if (days == DaysOfWeek.All) return L["Schedule.Daily"].Value;
        if (days == DaysOfWeek.Weekdays) return L["Schedule.Weekdays"].Value;
        if (days == DaysOfWeek.Weekend) return L["Schedule.Weekend"].Value;

        var names = new List<string>();
        if (days.Value.HasFlag(DaysOfWeek.Monday)) names.Add(L["DayShort.Monday"].Value);
        if (days.Value.HasFlag(DaysOfWeek.Tuesday)) names.Add(L["DayShort.Tuesday"].Value);
        if (days.Value.HasFlag(DaysOfWeek.Wednesday)) names.Add(L["DayShort.Wednesday"].Value);
        if (days.Value.HasFlag(DaysOfWeek.Thursday)) names.Add(L["DayShort.Thursday"].Value);
        if (days.Value.HasFlag(DaysOfWeek.Friday)) names.Add(L["DayShort.Friday"].Value);
        if (days.Value.HasFlag(DaysOfWeek.Saturday)) names.Add(L["DayShort.Saturday"].Value);
        if (days.Value.HasFlag(DaysOfWeek.Sunday)) names.Add(L["DayShort.Sunday"].Value);
        return string.Join("+", names);
    }

    private static bool IsEmoji(string s) =>
        !string.IsNullOrEmpty(s) && !s.All(c => c < 128);

    private RenderFragment RenderChoreIcon(Chore chore) => __builder =>
    {
        if (chore.Icon is not null)
        {
            if (IsEmoji(chore.Icon))
            {
                <span style="font-size:1.2rem;">@chore.Icon</span>
            }
            else if (chore.Icon.StartsWith("svg:"))
            {
                var svgData = System.Text.Encoding.UTF8.GetString(Convert.FromBase64String(chore.Icon[4..]));
                <div style="width:20px; height:20px; color: @(chore.IconColor ?? "currentColor"); display:inline-flex;">
                    @((MarkupString)svgData)
                </div>
            }
            else
            {
                var resolved = FamilyAssistant.Services.IconRegistry.GetSvg(chore.Icon);
                if (resolved is not null)
                {
                    <MudIcon Icon="@resolved" Size="Size.Small"
                             Style="@(chore.IconColor is not null ? $"color: {chore.IconColor};" : "")" />
                }
            }
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.Task" Size="Size.Small" Color="Color.Default" />
        }
    };

    private enum ChoreFilter
    {
        All,
        Active,
        Inactive,
        NoSchedule
    }
}
