@page "/"
@rendermode InteractiveServer
@inject IHomeAssistantService HaService
@inject FamilyAssistant.Data.AppDbContext Db
@inject FamilyAssistant.Services.IChoreTaskQueryService TaskQuery
@inject FamilyAssistant.Services.UserContextService UserContext
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L
@using Microsoft.EntityFrameworkCore
@using FamilyAssistant.Models

<PageTitle>@L["PageTitle.Dashboard"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@L["Home.Title"]</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
    <MudText Class="ml-2">@L["Common.Loading"]</MudText>
}
else if (!_connected)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @L["Home.NoConnection"]
    </MudAlert>
}
else
{
    @if (_persons.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            @L["Home.NoPersons"]
            <MudLink Href="/settings" Color="Color.Primary">@L["Home.SetupLink"]</MudLink>
        </MudAlert>
    }
    else
    {
        @* ── Own Card (large) ── *@
        @if (_currentPerson is not null)
        {
            <MudPaper Outlined="true" Class="pa-5 mb-4">
                <div class="d-flex align-center mb-3">
                    @if (_currentPerson.EntityPicture is not null)
                    {
                        <MudAvatar Size="Size.Large">
                            <img src="@($"/api/ha-image?path={Uri.EscapeDataString(_currentPerson.EntityPicture)}")"
                                 style="width:100%;height:100%;object-fit:cover;" alt="@_currentPerson.Name" />
                        </MudAvatar>
                    }
                    else
                    {
                        <MudAvatar Size="Size.Large" Color="Color.Primary">@_currentPerson.Name[0]</MudAvatar>
                    }
                    <div class="ml-3" style="flex: 1;">
                        <MudText Typo="Typo.h5">@_currentPerson.Name</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @GetRoleLabel(_currentPerson.Role)
                        </MudText>
                    </div>
                    <MudText Typo="Typo.h4" Color="Color.Success">
                        <b>@_currentPerson.Credits</b>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Common.Credits"]</MudText>
                    </MudText>
                </div>

                @if (_myStats is not null)
                {
                    <div class="d-flex gap-4 mb-3 flex-wrap">
                        <MudLink Href="@($"/tasks?filter=Today&person={_currentPerson.Id}")" Color="Color.Primary" Underline="Underline.None">
                            <MudPaper Outlined="true" Class="pa-3 d-flex flex-column align-center" Style="min-width: 80px;">
                                <MudText Typo="Typo.h5" Color="Color.Primary">@_myStats.OpenTasks</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Home.Stats.Open"]</MudText>
                            </MudPaper>
                        </MudLink>
                        <MudLink Href="@($"/tasks?filter=Completed&person={_currentPerson.Id}")" Color="Color.Success" Underline="Underline.None">
                            <MudPaper Outlined="true" Class="pa-3 d-flex flex-column align-center" Style="min-width: 80px;">
                                <MudText Typo="Typo.h5" Color="Color.Success">@_myStats.CompletedThisWeek</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Home.Stats.CompletedThisWeek"]</MudText>
                            </MudPaper>
                        </MudLink>
                        @if (_myStats.MissedThisWeek > 0)
                        {
                            <MudPaper Outlined="true" Class="pa-3 d-flex flex-column align-center" Style="min-width: 80px;">
                                <MudText Typo="Typo.h5" Color="Color.Error">@_myStats.MissedThisWeek</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Home.Stats.MissedThisWeek"]</MudText>
                            </MudPaper>
                        }
                    </div>
                }

                @* ── Recent completed tasks ── *@
                @if (_myRecentTasks.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">@L["Home.RecentTasks"]</MudText>
                    @foreach (var task in _myRecentTasks)
                    {
                        <div class="d-flex align-center mb-1">
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" Class="mr-2" />
                            <MudText Typo="Typo.body2" Style="flex: 1;">@task.Chore.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @FormatCompletedDate(task.CompletedAt)
                            </MudText>
                        </div>
                    }
                    <MudLink Href="@($"/tasks?filter=Completed&person={_currentPerson.Id}")" Color="Color.Primary"
                             Typo="Typo.caption" Class="mt-1">
                        @L["Home.ShowAllCompleted"]
                    </MudLink>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                        @L["Home.NoRecentTasks"]
                    </MudText>
                    <MudLink Href="/tasks" Color="Color.Primary" Typo="Typo.body2" Class="mt-1">
                        @L["Home.GoToTasks"]
                    </MudLink>
                }
            </MudPaper>
        }

        @* ── Parent/Admin extras: pending confirmations ── *@
        @if (UserContext.IsParentOrAdmin && _pendingConfirmationCount > 0)
        {
            <MudLink Href="/tasks?filter=Pending" Underline="Underline.None">
                <MudPaper Outlined="true" Class="pa-4 mb-4 d-flex align-center" Style="border-color: var(--mud-palette-warning);">
                    <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Warning" Class="mr-3" />
                    <div style="flex: 1;">
                        <MudText Typo="Typo.body1">
                            @string.Format(L["Home.PendingConfirmations"], _pendingConfirmationCount)
                        </MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" />
                </MudPaper>
            </MudLink>
        }

        @* ── Other persons (compact cards) ── *@
        @if (_otherPersons.Count > 0)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-2 mt-2">@L["Home.Family"]</MudText>
            <MudGrid>
                @foreach (var person in _otherPersons)
                {
                    <MudItem xs="12" sm="6" md="4" lg="3">
                        <MudPaper Outlined="true" Class="pa-3">
                            <div class="d-flex align-center mb-2">
                                @if (person.EntityPicture is not null)
                                {
                                    <MudAvatar Size="Size.Medium">
                                        <img src="@($"/api/ha-image?path={Uri.EscapeDataString(person.EntityPicture)}")"
                                             style="width:100%;height:100%;object-fit:cover;" alt="@person.Name" />
                                    </MudAvatar>
                                }
                                else
                                {
                                    <MudAvatar Size="Size.Medium" Color="Color.Primary">@person.Name[0]</MudAvatar>
                                }
                                <div class="ml-2" style="flex: 1; min-width: 0;">
                                    <MudText Typo="Typo.body1" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        @person.Name
                                    </MudText>
                                </div>
                                <MudText Typo="Typo.body1" Color="Color.Success"><b>@person.Credits</b></MudText>
                            </div>

                            @if (_personStats.TryGetValue(person.Id, out var stats))
                            {
                                <div class="d-flex justify-space-between">
                                    <MudLink Href="@($"/tasks?filter=Today&person={person.Id}")" Color="Color.Default"
                                             Typo="Typo.caption">
                                        @L["Home.Stats.Open"]: @stats.OpenTasks
                                    </MudLink>
                                    <MudText Typo="Typo.caption" Color="Color.Success">
                                        @L["Home.Stats.CompletedShort"]: @stats.CompletedThisWeek
                                    </MudText>
                                </div>
                            }

                            @if (_haStatus.TryGetValue(person.HaEntityId, out var state))
                            {
                                <div class="d-flex align-center mt-1">
                                    <MudIcon Icon="@(state == "home" ? Icons.Material.Filled.Home : Icons.Material.Filled.DirectionsWalk)"
                                             Size="Size.Small" Color="@(state == "home" ? Color.Success : Color.Default)" Class="mr-1" />
                                    <MudText Typo="Typo.caption">
                                        @(state == "home" ? L["Home.State.Home"] : state == "not_home" ? L["Home.State.Away"] : state)
                                    </MudText>
                                </div>
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    }
}

@code {
    private bool _loading = true;
    private bool _connected;
    private List<Person> _persons = [];
    private Person? _currentPerson;
    private List<Person> _otherPersons = [];
    private PersonStats? _myStats;
    private List<ChoreTask> _myRecentTasks = [];
    private int _pendingConfirmationCount;
    private Dictionary<int, PersonStats> _personStats = new();
    private Dictionary<string, string> _haStatus = new();

    protected override async Task OnInitializedAsync()
    {
        _connected = await HaService.TestConnectionAsync();

        if (_connected)
        {
            _persons = await Db.Persons.OrderBy(p => p.Name).ToListAsync();

            // Redirect to setup if no persons configured yet
            if (_persons.Count == 0)
            {
                Navigation.NavigateTo("/setup");
                return;
            }

            // Determine current person and others
            _currentPerson = _persons.FirstOrDefault(p => p.Id == UserContext.CurrentPersonId);
            _otherPersons = _persons.Where(p => p.Id != UserContext.CurrentPersonId).ToList();

            // Load HA status for all persons
            var haPersons = await HaService.GetPersonsAsync();
            _haStatus = haPersons.ToDictionary(p => p.EntityId, p => p.State ?? "unknown");

            // Load stats per person (uses QueryService for consistent logic)
            var today = DateOnly.FromDateTime(DateTime.Today);
            var weekStart = today.AddDays(-(int)today.DayOfWeek + (int)DayOfWeek.Monday);

            foreach (var person in _persons)
            {
                var openTasks = (await TaskQuery.GetTodayTasksAsync(person.Id)).Count;
                var completedThisWeek = (await TaskQuery.GetRecentCompletedForPersonAsync(person.Id, 100)).Count;

                var missedThisWeek = await Db.MissedCreditsLogs
                    .CountAsync(m => m.PersonId == person.Id
                        && !m.WasPaused
                        && m.Date >= weekStart && m.Date <= today);

                _personStats[person.Id] = new PersonStats(openTasks, completedThisWeek, missedThisWeek);
            }

            // Own stats
            if (_currentPerson is not null && _personStats.TryGetValue(_currentPerson.Id, out var myStats))
            {
                _myStats = myStats;
            }

            // Load recent completed tasks for current user (this week, max 5)
            if (_currentPerson is not null)
            {
                _myRecentTasks = await TaskQuery.GetRecentCompletedForPersonAsync(_currentPerson.Id, 5);
            }

            // Pending confirmations count (for parents)
            if (UserContext.IsParentOrAdmin)
            {
                _pendingConfirmationCount = (await TaskQuery.GetPendingConfirmationAsync()).Count;
            }
        }

        _loading = false;
    }

    private string GetRoleLabel(PersonRole role) => role switch
    {
        PersonRole.Admin => L["Role.Admin"].Value,
        PersonRole.Parent => L["Role.Parent"].Value,
        PersonRole.Child => L["Role.Child"].Value,
        _ => role.ToString()
    };

    private string FormatCompletedDate(DateTime? completedAt)
    {
        if (completedAt is null) return "";
        var local = completedAt.Value.ToLocalTime();
        var today = DateTime.Today;
        if (local.Date == today) return local.ToString("HH:mm");
        if (local.Date == today.AddDays(-1)) return $"{L["Common.Date.Yesterday"]} {local:HH:mm}";
        return local.ToString("ddd HH:mm");
    }

    private record PersonStats(int OpenTasks, int CompletedThisWeek, int MissedThisWeek);
}
