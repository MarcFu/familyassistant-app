@inherits LayoutComponentBase
@inject FamilyAssistant.Services.HaThemeService ThemeService
@inject FamilyAssistant.Services.UserContextService UserContext
@inject FamilyAssistant.Data.AppDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L
@inject FamilyAssistant.Services.IAchievementService AchievementSvc
@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable

<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" Size="Size.Small" />
        <MudText Typo="Typo.subtitle1" Class="ml-2" Style="font-weight:500;">@L["App.Name"]</MudText>
        <MudSpacer />
        <button type="button" class="app-current-user" title="@GetCurrentContextTitle()" @onclick="NavigateToProfile">
            @if (UserContext.CurrentPerson is { } person)
            {
                @if (!string.IsNullOrWhiteSpace(person.EntityPicture))
                {
                    <MudAvatar Size="Size.Small" Class="app-current-user-avatar">
                        <img src="@($"api/ha-image?path={Uri.EscapeDataString(person.EntityPicture)}")"
                             style="width:100%;height:100%;object-fit:cover;" alt="@person.Name" />
                    </MudAvatar>
                }
                else
                {
                    <MudAvatar Size="Size.Small" Color="Color.Primary" Class="app-current-user-avatar">
                        @person.Name[0]
                    </MudAvatar>
                }
                <MudText Typo="Typo.body2" Class="app-current-user-name">@person.Name</MudText>
            }
            else
            {
                <MudAvatar Size="Size.Small" Color="Color.Default" Class="app-current-user-avatar">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
                </MudAvatar>
                <MudText Typo="Typo.body2" Class="app-current-user-name">@L["Common.Guest"]</MudText>
            }
        </button>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="px-4 pb-4">
        <div class="pt-4">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<AchievementUnlockOverlay PersonId="UserContext.CurrentPersonId" />

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true; // Default until HA WebSocket delivers real value
    private MudTheme _theme = null!;
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    // Default colors (used when HA doesn't provide custom values)
    private const string DefaultPrimary = "#03a9f4";
    private const string DefaultSecondary = "#ff9800";

    protected override async Task OnInitializedAsync()
    {
        // Resolve user from HA Ingress header (available during prerender/initial request)
        var haUserId = HttpContextAccessor.HttpContext?.Request.Headers["X-Remote-User-Id"].ToString();

        // Load per-user preferences from HA config storage file
        if (!string.IsNullOrEmpty(haUserId))
        {
            ThemeService.RefreshForUser(haUserId);
        }

        _isDarkMode = ResolveDarkMode();
        _theme = BuildTheme(ThemeService.EffectivePrimaryColor, ThemeService.EffectiveAccentColor);
        ThemeService.ThemeChanged += OnThemeChanged;
        UserContext.CurrentPersonChanged += OnCurrentPersonChanged;

        if (!UserContext.IsAuthenticated)
        {
            if (!string.IsNullOrEmpty(haUserId))
            {
                await UserContext.ResolveFromHaUserIdAsync(haUserId);
            }
        }

        // Fallback: auto-select first Admin/Parent if still not resolved
        if (!UserContext.IsAuthenticated)
        {
            var firstPerson = await Db.Persons
                .OrderByDescending(p => p.Role == PersonRole.Admin)
                .ThenByDescending(p => p.Role == PersonRole.Parent)
                .FirstOrDefaultAsync();

            if (firstPerson is not null)
            {
                await UserContext.SetCurrentPersonAsync(firstPerson.Id);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // If effective mode is "auto" (null), detect OS preference via JS
            if (ThemeService.EffectiveDarkModePreference is null)
            {
                var systemDark = await JS.InvokeAsync<bool>("themeInterop.getSystemDarkMode");
                if (systemDark != _isDarkMode)
                {
                    _isDarkMode = systemDark;
                    StateHasChanged();
                }

                // Watch for OS preference changes
                _dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("themeInterop.watchSystemDarkMode", _dotNetRef, "OnSystemDarkModeChanged");
            }

            // Sync CSS class on <html> element
            await SyncThemeClassAsync();
        }
    }

    /// <summary>
    /// Called from JS when the OS dark mode preference changes (only active in "Auto" mode).
    /// </summary>
    [JSInvokable]
    public async void OnSystemDarkModeChanged(bool isDark)
    {
        // Only apply if still in auto mode
        if (ThemeService.EffectiveDarkModePreference is null)
        {
            _isDarkMode = isDark;
            await SyncThemeClassAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnThemeChanged()
    {
        _isDarkMode = ResolveDarkMode();
        _theme = BuildTheme(ThemeService.EffectivePrimaryColor, ThemeService.EffectiveAccentColor);
        InvokeAsync(async () =>
        {
            await SyncThemeClassAsync();
            StateHasChanged();
        });
    }

    private void OnCurrentPersonChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    // ─── Theme Resolution Logic ──────────────────────────────────────

    /// <summary>
    /// Resolves the final _isDarkMode value based on effective preference.
    /// If preference is null (auto), defaults to true until JS detects OS preference.
    /// </summary>
    private bool ResolveDarkMode()
    {
        return ThemeService.EffectiveDarkModePreference ?? true;
    }

    /// <summary>
    /// Syncs the CSS theme class on the HTML element via JS interop.
    /// </summary>
    private async Task SyncThemeClassAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("themeInterop.setThemeClass", _isDarkMode, ThemeService.DevLightBadges);
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { } // Prerendering — JS not available yet
    }

    // ─── Theme Builder ────────────────────────────────────────────────

    private static MudTheme BuildTheme(string? primaryColor, string? accentColor)
    {
        var primary = primaryColor ?? DefaultPrimary;
        var secondary = accentColor ?? DefaultSecondary;

        return new MudTheme
        {
            PaletteLight = new PaletteLight()
            {
                Primary = primary,
                Secondary = secondary,
                Surface = "#f5f5f5",
                Background = "#fafafa",
                AppbarBackground = primary,
                DrawerBackground = "#ffffff",
                TextPrimary = "#212121",
                TextSecondary = "#616161",
            },
            PaletteDark = new PaletteDark()
            {
                Primary = primary,
                Secondary = secondary,
                Surface = "#1c1c1c",
                Background = "#121212",
                AppbarBackground = "#1e1e1e",
                DrawerBackground = "#1c1c1c",
                TextPrimary = "#e1e1e1",
                TextSecondary = "#a0a0a0",
            },
            Typography = new Typography()
            {
                Default = new DefaultTypography()
                {
                    FontFamily = ["Roboto", "Helvetica", "Arial", "sans-serif"]
                }
            }
        };
    }

    // ─── Helpers ──────────────────────────────────────────────────────

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void NavigateToProfile() => Nav.NavigateTo("profile");

    private string GetCurrentContextTitle()
    {
        return UserContext.CurrentPerson is { } person
            ? $"Aktueller Kontext: {person.Name} ({person.Role})"
            : "Aktueller Kontext: Gast";
    }

    public async ValueTask DisposeAsync()
    {
        ThemeService.ThemeChanged -= OnThemeChanged;
        UserContext.CurrentPersonChanged -= OnCurrentPersonChanged;

        try
        {
            await JS.InvokeVoidAsync("themeInterop.stopWatchingSystemDarkMode");
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        // InvalidOperationException: JS interop unavailable during static rendering/prerender

        _dotNetRef?.Dispose();
    }
}
