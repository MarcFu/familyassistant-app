@page "/dev"
@rendermode InteractiveServer
@inject HassCompanion.Services.UserContextService UserContext
@inject HassCompanion.Data.AppDbContext Db
@inject ISnackbar Snackbar
@using Microsoft.EntityFrameworkCore

<PageTitle>Dev - HassCompanion</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Entwickler-Tools</MudText>

<MudCard Elevation="1" Class="pa-4 mb-4" Style="max-width:500px;">
    <MudText Typo="Typo.h6" Class="mb-3">Benutzerkontext</MudText>

    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
        Simuliert den angemeldeten HA-Benutzer. Im Add-on-Modus wird dies automatisch aus dem Ingress-Header gelesen.
    </MudText>

    <MudSelect T="int?" Value="_selectedPersonId" ValueChanged="OnPersonChanged"
               Label="Aktive Person" Variant="Variant.Filled" Margin="Margin.Dense"
               Clearable="true" Class="mb-3">
        @foreach (var person in _persons)
        {
            <MudSelectItem T="int?" Value="@person.Id">
                @person.Name (@person.Role)
            </MudSelectItem>
        }
    </MudSelect>

    @if (UserContext.IsAuthenticated)
    {
        <MudAlert Severity="Severity.Success" Class="mb-3">
            Angemeldet als: <strong>@UserContext.CurrentPerson!.Name</strong>
            (Rolle: @UserContext.CurrentPerson.Role, Credits: @UserContext.CurrentPerson.Credits)
        </MudAlert>

        <div class="d-flex gap-2 flex-wrap">
            <MudChip T="string" Color="@(UserContext.CanAct ? Color.Success : Color.Error)" Size="Size.Small">
                @(UserContext.CanAct ? "Kann handeln" : "Kann nicht handeln")
            </MudChip>
            <MudChip T="string" Color="@(UserContext.IsParentOrAdmin ? Color.Info : Color.Default)" Size="Size.Small">
                @(UserContext.IsParentOrAdmin ? "Eltern/Admin" : "Kein Eltern-Zugriff")
            </MudChip>
            <MudChip T="string" Color="@(UserContext.IsAdmin ? Color.Warning : Color.Default)" Size="Size.Small">
                @(UserContext.IsAdmin ? "Admin" : "Kein Admin")
            </MudChip>
        </div>
    }
    else
    {
        <MudAlert Severity="Severity.Info">
            Kein Benutzer gewählt — Gast-Modus (nur lesen).
        </MudAlert>
    }
</MudCard>

<MudCard Elevation="1" Class="pa-4" Style="max-width:500px;">
    <MudText Typo="Typo.h6" Class="mb-3">Info</MudText>
    <MudSimpleTable Dense="true" Elevation="0">
        <tbody>
            <tr><td><strong>Modus</strong></td><td>@_mode</td></tr>
            <tr><td><strong>DB-Pfad</strong></td><td>@_dbPath</td></tr>
            <tr><td><strong>Personen</strong></td><td>@_persons.Count</td></tr>
            <tr><td><strong>.NET</strong></td><td>@System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription</td></tr>
        </tbody>
    </MudSimpleTable>
</MudCard>

@code {
    private List<Person> _persons = [];
    private int? _selectedPersonId;
    private string _mode = "Development";
    private string _dbPath = "";

    protected override async Task OnInitializedAsync()
    {
        _persons = await Db.Persons.OrderBy(p => p.Name).ToListAsync();
        _selectedPersonId = UserContext.CurrentPersonId;
        _mode = Environment.GetEnvironmentVariable("SUPERVISOR_TOKEN") is not null ? "Add-on (Production)" : "Development";
        _dbPath = Db.Database.GetDbConnection().DataSource ?? "?";
    }

    private async Task OnPersonChanged(int? personId)
    {
        _selectedPersonId = personId;
        await UserContext.SetCurrentPersonAsync(personId);

        if (personId is null)
        {
            Snackbar.Add("Benutzerkontext gelöscht — Gast-Modus.", Severity.Info);
        }
        else
        {
            Snackbar.Add($"Benutzerkontext: {UserContext.CurrentPerson?.Name}", Severity.Success);
        }
        StateHasChanged();
    }
}
