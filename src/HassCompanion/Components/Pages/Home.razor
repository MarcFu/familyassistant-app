@page "/"
@rendermode InteractiveServer
@inject IHomeAssistantService HaService
@inject HassCompanion.Data.AppDbContext Db
@using Microsoft.EntityFrameworkCore

<PageTitle>Dashboard - HassCompanion</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Dashboard</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
    <MudText Class="ml-2">Lade Daten...</MudText>
}
else if (!_connected)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        Keine Verbindung zu Home Assistant. Bitte Konfiguration prüfen.
    </MudAlert>
}
else
{
    @if (_persons.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Noch keine Personen konfiguriert.
            <MudLink Href="/settings" Color="Color.Primary">Jetzt einrichten</MudLink>
        </MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var person in _persons)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudPaper Outlined="true" Class="pa-4">
                        <div class="d-flex align-center mb-3">
                            @if (person.EntityPicture is not null)
                            {
                                <MudAvatar Size="Size.Large">
                                    <img src="@($"/api/ha-image?path={Uri.EscapeDataString(person.EntityPicture)}")"
                                         style="width:100%;height:100%;object-fit:cover;" alt="@person.Name" />
                                </MudAvatar>
                            }
                            else
                            {
                                <MudAvatar Size="Size.Large" Color="Color.Primary">@person.Name[0]</MudAvatar>
                            }
                            <div class="ml-3">
                                <MudText Typo="Typo.h6">@person.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @GetRoleLabel(person.Role)
                                    @if (person.IsPaused)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-2">Pause</MudChip>
                                    }
                                </MudText>
                            </div>
                        </div>

                        <div class="d-flex align-center justify-space-between mb-2">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Credits</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Success">
                                <b>@person.Credits</b>
                            </MudText>
                        </div>

                        @if (_personStats.TryGetValue(person.Id, out var stats))
                        {
                            <MudDivider Class="my-2" />
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Offen</MudText>
                                <MudText Typo="Typo.caption">@stats.OpenTasks</MudText>
                            </div>
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Erledigt (Woche)</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Success">@stats.CompletedThisWeek</MudText>
                            </div>
                            <div class="d-flex justify-space-between">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Verpasst (Woche)</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Error">@stats.MissedThisWeek</MudText>
                            </div>
                        }

                        @if (_haStatus.TryGetValue(person.HaEntityId, out var state))
                        {
                            <MudDivider Class="my-2" />
                            <div class="d-flex align-center">
                                <MudIcon Icon="@(state == "home" ? Icons.Material.Filled.Home : Icons.Material.Filled.DirectionsWalk)"
                                         Size="Size.Small" Color="@(state == "home" ? Color.Success : Color.Default)" Class="mr-1" />
                                <MudText Typo="Typo.caption">
                                    @(state == "home" ? "Zuhause" : state == "not_home" ? "Unterwegs" : state)
                                </MudText>
                            </div>
                        }
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
}

@code {
    private bool _loading = true;
    private bool _connected;
    private List<Person> _persons = [];
    private Dictionary<int, PersonStats> _personStats = new();
    private Dictionary<string, string> _haStatus = new();

    protected override async Task OnInitializedAsync()
    {
        _connected = await HaService.TestConnectionAsync();

        if (_connected)
        {
            _persons = await Db.Persons.OrderBy(p => p.Name).ToListAsync();

            // Load HA status for all persons
            var haPersons = await HaService.GetPersonsAsync();
            _haStatus = haPersons.ToDictionary(p => p.EntityId, p => p.State ?? "unknown");

            // Load stats
            var today = DateOnly.FromDateTime(DateTime.Today);
            var weekStart = today.AddDays(-(int)today.DayOfWeek + (int)DayOfWeek.Monday);

            foreach (var person in _persons)
            {
                var openTasks = await Db.ChoreTasks
                    .CountAsync(t => (t.DefaultPersonId == person.Id || t.ClaimedByPersonId == person.Id)
                        && (t.Status == ChoreTaskStatus.Open || t.Status == ChoreTaskStatus.Claimed));

                var completedThisWeek = await Db.ChoreTasks
                    .CountAsync(t => (t.CompletedByPersonId == person.Id || t.ClaimedByPersonId == person.Id)
                        && t.Status == ChoreTaskStatus.Confirmed
                        && t.DueDate >= weekStart && t.DueDate <= today);

                var missedThisWeek = await Db.MissedCreditsLogs
                    .CountAsync(m => m.PersonId == person.Id
                        && !m.WasPaused
                        && m.Date >= weekStart && m.Date <= today);

                _personStats[person.Id] = new PersonStats(openTasks, completedThisWeek, missedThisWeek);
            }
        }

        _loading = false;
    }

    private static string GetRoleLabel(PersonRole role) => role switch
    {
        PersonRole.Admin => "Administrator",
        PersonRole.Parent => "Elternteil",
        PersonRole.Child => "Kind",
        _ => role.ToString()
    };

    private record PersonStats(int OpenTasks, int CompletedThisWeek, int MissedThisWeek);
}
