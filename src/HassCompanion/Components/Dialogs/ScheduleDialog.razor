@inject HassCompanion.Data.AppDbContext Db
@using Microsoft.EntityFrameworkCore

<MudDialog>
    <DialogContent>
        @if (_chore is not null)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Zeitpläne definieren, wann und wie oft "@_chore.Name" erledigt werden muss.
            </MudText>

            @foreach (var schedule in _schedules)
            {
                <MudCard Elevation="0" Outlined="true" Class="mb-3 pa-3">
                    <div class="d-flex align-center mb-2">
                        <MudSelect T="ScheduleRhythm" @bind-Value="schedule.Rhythm" Label="Rhythmus"
                                   Variant="Variant.Filled" Dense="true" Margin="Margin.Dense" Class="mr-2">
                            <MudSelectItem Value="ScheduleRhythm.Daily">Täglich</MudSelectItem>
                            <MudSelectItem Value="ScheduleRhythm.SpecificDays">Bestimmte Tage</MudSelectItem>
                            <MudSelectItem Value="ScheduleRhythm.XTimesPerWeek">X mal pro Woche</MudSelectItem>
                            <MudSelectItem Value="ScheduleRhythm.Weekly">Wöchentlich</MudSelectItem>
                            <MudSelectItem Value="ScheduleRhythm.Monthly">Monatlich</MudSelectItem>
                            <MudSelectItem Value="ScheduleRhythm.EveryXMonths">Alle X Monate</MudSelectItem>
                            <MudSelectItem Value="ScheduleRhythm.EveryXWeeks">Alle X Wochen</MudSelectItem>
                            <MudSelectItem Value="ScheduleRhythm.Permanent">Permanent (immer verfügbar)</MudSelectItem>
                        </MudSelect>

                        <MudSelect T="int?" @bind-Value="schedule.DefaultPersonId" Label="Standard-Person"
                                   Variant="Variant.Filled" Dense="true" Margin="Margin.Dense" Class="mr-2"
                                   Clearable="true" Placeholder="Offen">
                            @foreach (var person in _persons)
                            {
                                <MudSelectItem T="int?" Value="@person.Id">@person.Name</MudSelectItem>
                            }
                        </MudSelect>

                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => RemoveSchedule(schedule))" />
                    </div>

                    @if (schedule.Rhythm == ScheduleRhythm.SpecificDays)
                    {
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var (day, label) in _dayOptions)
                            {
                                var isSelected = schedule.SpecificDays?.HasFlag(day) ?? false;
                                <MudChip T="string" Color="@(isSelected ? Color.Primary : Color.Default)"
                                         Size="Size.Small"
                                         OnClick="@(() => ToggleDay(schedule, day))">
                                    @label
                                </MudChip>
                            }
                        </div>
                    }

                    @if (schedule.Rhythm == ScheduleRhythm.XTimesPerWeek)
                    {
                        <MudNumericField T="int?" @bind-Value="schedule.TimesPerWeek" Label="Mal pro Woche"
                                         Min="1" Max="7" Variant="Variant.Filled" Dense="true" Margin="Margin.Dense" Class="mb-2" />
                    }

                    @if (schedule.Rhythm == ScheduleRhythm.EveryXMonths)
                    {
                        <MudNumericField T="int?" @bind-Value="schedule.IntervalMonths" Label="Alle X Monate"
                                         Min="2" Max="24" Variant="Variant.Filled" Dense="true" Margin="Margin.Dense" Class="mb-2"
                                         HelperText="z.B. 3 = alle 3 Monate" />
                    }

                    @if (schedule.Rhythm == ScheduleRhythm.EveryXWeeks)
                    {
                        <MudNumericField T="int?" @bind-Value="schedule.IntervalWeeks" Label="Alle X Wochen"
                                         Min="2" Max="12" Variant="Variant.Filled" Dense="true" Margin="Margin.Dense" Class="mb-2"
                                         HelperText="z.B. 2 = alle 2 Wochen" />
                    }

                    @if (schedule.Rhythm == ScheduleRhythm.Daily || schedule.Rhythm == ScheduleRhythm.SpecificDays)
                    {
                        <MudNumericField @bind-Value="schedule.TimesPerDay" Label="Wiederholungen pro Tag (z.B. morgens + abends = 2)"
                                         Min="1" Max="5" Variant="Variant.Filled" Dense="true" Margin="Margin.Dense" />
                    }
                </MudCard>
            }

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddSchedule" FullWidth="true">
                Zeitplan hinzufügen
            </MudButton>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="Submit">Speichern</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Chore? Chore { get; set; }

    private Chore? _chore;
    private List<ChoreSchedule> _schedules = [];
    private List<Person> _persons = [];

    private static readonly (DaysOfWeek Day, string Label)[] _dayOptions =
    [
        (DaysOfWeek.Monday, "Mo"),
        (DaysOfWeek.Tuesday, "Di"),
        (DaysOfWeek.Wednesday, "Mi"),
        (DaysOfWeek.Thursday, "Do"),
        (DaysOfWeek.Friday, "Fr"),
        (DaysOfWeek.Saturday, "Sa"),
        (DaysOfWeek.Sunday, "So")
    ];

    protected override async Task OnInitializedAsync()
    {
        _persons = await Db.Persons.OrderBy(p => p.Name).ToListAsync();

        if (Chore is not null)
        {
            _chore = await Db.Chores
                .Include(c => c.Schedules)
                .FirstOrDefaultAsync(c => c.Id == Chore.Id);

            _schedules = _chore?.Schedules.ToList() ?? [];
        }
    }

    private void AddSchedule()
    {
        _schedules.Add(new ChoreSchedule
        {
            ChoreId = _chore!.Id,
            Rhythm = ScheduleRhythm.Daily,
            TimesPerDay = 1,
            IsActive = true
        });
    }

    private void RemoveSchedule(ChoreSchedule schedule)
    {
        if (schedule.Id > 0)
        {
            Db.ChoreSchedules.Remove(schedule);
        }
        _schedules.Remove(schedule);
    }

    private void ToggleDay(ChoreSchedule schedule, DaysOfWeek day)
    {
        var current = schedule.SpecificDays ?? DaysOfWeek.None;
        if (current.HasFlag(day))
            schedule.SpecificDays = current & ~day;
        else
            schedule.SpecificDays = current | day;
    }

    private async Task Submit()
    {
        if (_chore is null) return;

        // Reset TimesPerDay to 1 for rhythms where it's not configurable
        foreach (var schedule in _schedules)
        {
            if (schedule.Rhythm is not (ScheduleRhythm.Daily or ScheduleRhythm.SpecificDays))
            {
                schedule.TimesPerDay = 1;
            }
        }

        // Add new schedules
        foreach (var schedule in _schedules.Where(s => s.Id == 0))
        {
            schedule.ChoreId = _chore.Id;
            Db.ChoreSchedules.Add(schedule);
        }

        await Db.SaveChangesAsync();
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
